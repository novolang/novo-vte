// grid_tests.nv — behaviour @test fns for the Cell + Grid model.
//
// Run from the package dir:
//   novo test tests/grid_tests.nv
//
// One behaviour per test, which is what makes a failure message say
// what broke: `test_put_char_wraps_at_right_margin` names the rule.
// vte_grid_tests.nv beside it is the CONTRACT suite — one test per
// area of the public surface, which is what `tests-cover-pub` asks
// for — so the two overlap by design and not by accident, and the rule
// is: a change to the model updates whichever file asserts the
// behaviour, and adds to this one when neither does.
//
// This file lived in orbit/novoterm/src/ until 2026-09-10, where it
// tested a DEPENDENCY's modules from inside a consumer, and shipped to
// every consumer of novoterm as part of src/.  It is here now, with
// the model it covers.

use std.test
use grid

@test
fn test_grid_new_is_blank() [io]
    let g = grid.grid_new(2, 4)
    test.assert_eq(grid.grid_rows(g), 2)
    test.assert_eq(grid.grid_cols(g), 4)
    test.assert_eq(grid.grid_cursor_row(g), 0)
    test.assert_eq(grid.grid_cursor_col(g), 0)
    // A cell is TWO words: cell_glyph/_attrs/_fg
    // read word 0, cell_bg reads word 1.  Passing w0 to cell_bg reads the
    // glyph's low bits as a colour — which is how this asserted 0 and got
    // 32, the blank space.
    let cell = grid.grid_get(g, 0, 0)
    let cell1 = grid.grid_get_w1(g, 0, 0)
    test.assert_eq(grid.cell_glyph(cell), 32)
    test.assert_eq(grid.cell_fg(cell), grid.default_fg_rgb())
    test.assert_eq(grid.cell_bg(cell1), grid.default_bg_rgb())
    grid.grid_drop(g)

@test
fn test_put_char_advances_cursor() [io]
    var g0 = grid.grid_new(2, 4)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    let g2 = grid.grid_put_char(var g1, 66)   // 'B' at (0,1)
    let c0 = grid.grid_get(g2, 0, 0)
    let c1 = grid.grid_get(g2, 0, 1)
    test.assert_eq(grid.cell_glyph(c0), 65)
    test.assert_eq(grid.cell_glyph(c1), 66)
    test.assert_eq(grid.grid_cursor_col(g2), 2)
    test.assert_eq(grid.grid_cursor_row(g2), 0)
    grid.grid_drop(g2)

@test
fn test_put_char_wraps_at_right_margin() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 88)   // 'X' at (0,0)
    var g2 = grid.grid_put_char(var g1, 89)   // 'Y' at (0,1)
    var g3 = grid.grid_put_char(var g2, 90)   // 'Z' at (0,2) — fills the last col
    // DEFERRED wrap, xterm's pending-wrap semantics: filling the last
    // column does NOT move the cursor.  It stays pegged at cols-1 with
    // wrap_pending set, and the NEXT printable triggers the wrap.  Wrapping
    // eagerly instead double-advances the row when a full line is followed
    // by LF, which is what this test exists to catch.
    test.assert_eq(grid.grid_cursor_row(g3), 0)
    test.assert_eq(grid.grid_cursor_col(g3), 2)
    // The pending wrap fires here: 'W' lands at (1,0), cursor moves on.
    let g4 = grid.grid_put_char(var g3, 87)
    test.assert_eq(grid.grid_cursor_row(g4), 1)
    test.assert_eq(grid.grid_cursor_col(g4), 1)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g4, 1, 0)), 87)
    grid.grid_drop(g4)

@test
fn test_line_feed_moves_down() [io]
    var g0 = grid.grid_new(3, 3)
    var g1 = grid.grid_cursor_set(var g0, 0, 1)
    let g2 = grid.grid_line_feed(var g1)
    test.assert_eq(grid.grid_cursor_row(g2), 1)
    test.assert_eq(grid.grid_cursor_col(g2), 1)
    grid.grid_drop(g2)

@test
fn test_line_feed_at_bottom_scrolls() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    var g2 = grid.grid_line_feed(var g1)   // → (1,1)
    var g3 = grid.grid_carriage_return(var g2)   // → (1,0)
    var g4 = grid.grid_put_char(var g3, 66)   // 'B' at (1,0)
    let g5 = grid.grid_line_feed(var g4)   // scroll; cursor stays on bottom row
    test.assert_eq(grid.grid_cursor_row(g5), 1)
    // After scroll: 'A' was on row 0 (now discarded), 'B' shifted to row 0
    let c00 = grid.grid_get(g5, 0, 0)
    test.assert_eq(grid.cell_glyph(c00), 66)
    let c10 = grid.grid_get(g5, 1, 0)
    test.assert_eq(grid.cell_glyph(c10), 32)   // blanked bottom row
    grid.grid_drop(g5)

@test
fn test_carriage_return_resets_column() [io]
    var g0 = grid.grid_new(2, 4)
    var g1 = grid.grid_cursor_set(var g0, 1, 3)
    var g2 = grid.grid_carriage_return(var g1)
    test.assert_eq(grid.grid_cursor_row(g2), 1)
    test.assert_eq(grid.grid_cursor_col(g2), 0)
    grid.grid_drop(g2)

@test
fn test_backspace_decrements_column() [io]
    var g0 = grid.grid_new(2, 4)
    var g1 = grid.grid_cursor_set(var g0, 0, 2)
    var g2 = grid.grid_backspace(var g1)
    test.assert_eq(grid.grid_cursor_col(g2), 1)
    // Backspace at column 0 stays put.
    var g3 = grid.grid_cursor_set(var g2, 0, 0)
    let g4 = grid.grid_backspace(var g3)
    test.assert_eq(grid.grid_cursor_col(g4), 0)
    grid.grid_drop(g4)

@test
fn test_tab_advances_to_next_8col_stop() [io]
    var g0 = grid.grid_new(2, 20)
    var g1 = grid.grid_cursor_set(var g0, 0, 3)
    var g2 = grid.grid_tab(var g1)
    test.assert_eq(grid.grid_cursor_col(g2), 8)
    var g3 = grid.grid_tab(var g2)
    test.assert_eq(grid.grid_cursor_col(g3), 16)
    // Past the end clips to right margin (cols - 1).
    var g4 = grid.grid_cursor_set(var g3, 0, 18)
    var g5 = grid.grid_tab(var g4)
    test.assert_eq(grid.grid_cursor_col(g5), 19)
    grid.grid_drop(g5)

@test
fn test_erase_line_mode_0_clears_from_cursor() [io]
    // 2 rows so the 5th 'X' wraps without triggering a scroll.
    var g0 = grid.grid_new(2, 5)
    var g1 = grid.grid_put_char(var g0, 88)
    var g2 = grid.grid_put_char(var g1, 88)
    var g3 = grid.grid_put_char(var g2, 88)
    var g4 = grid.grid_put_char(var g3, 88)
    var g5 = grid.grid_put_char(var g4, 88)
    // Cursor wrapped to (1,0); reset to (0,2) then EL 0.
    var g6 = grid.grid_cursor_set(var g5, 0, 2)
    let g7 = grid.grid_erase_line(var g6, 0)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g7, 0, 0)), 88)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g7, 0, 1)), 88)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g7, 0, 2)), 32)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g7, 0, 3)), 32)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g7, 0, 4)), 32)
    grid.grid_drop(g7)

@test
fn test_erase_display_mode_2_clears_all() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 65)
    var g2 = grid.grid_put_char(var g1, 66)
    var g3 = grid.grid_line_feed(var g2)
    var g4 = grid.grid_put_char(var g3, 67)
    let g5 = grid.grid_erase_display(var g4, 2)
    var blanks = 0
    for r in 0..2
        for c in 0..3
            if grid.cell_glyph(grid.grid_get(g5, r, c)) == 32
                blanks = blanks + 1
    test.assert_eq(blanks, 6)
    grid.grid_drop(g5)

@test
fn test_sgr_fg_color_is_packed_into_cell() [io]
    var g0 = grid.grid_new(1, 3)
    var g1 = grid.grid_set_fg(var g0, 2)   // green
    var g2 = grid.grid_put_char(var g1, 65)   // 'A'
    let cell = grid.grid_get(g2, 0, 0)
    let cell1 = grid.grid_get_w1(g2, 0, 0)
    test.assert_eq(grid.cell_glyph(cell), 65)
    test.assert_eq(grid.cell_fg(cell), 2)
    test.assert_eq(grid.cell_bg(cell1), grid.default_bg_rgb())
    grid.grid_drop(g2)

@test
fn test_sgr_reset_restores_defaults() [io]
    var g0 = grid.grid_new(1, 3)
    var g1 = grid.grid_set_fg(var g0, 5)
    var g2 = grid.grid_set_bg(var g1, 6)
    var g3 = grid.grid_set_attrs(var g2, grid.attr_bold())
    var g4 = grid.grid_sgr_reset(var g3)
    var g5 = grid.grid_put_char(var g4, 88)
    let cell = grid.grid_get(g5, 0, 0)
    let cell1 = grid.grid_get_w1(g5, 0, 0)
    test.assert_eq(grid.cell_fg(cell), grid.default_fg_rgb())
    test.assert_eq(grid.cell_bg(cell1), grid.default_bg_rgb())
    test.assert_eq(grid.cell_attrs(cell), 0)
    grid.grid_drop(g5)

@test
fn test_alt_screen_round_trip_preserves_primary() [io]
    var g0 = grid.grid_new(2, 4)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    var g2 = grid.grid_put_char(var g1, 66)   // 'B' at (0,1)
    var g3 = grid.grid_set_fg(var g2, 4)   // blue
    var g4 = grid.grid_enter_alt_screen(var g3)
    test.assert_eq(grid.grid_cursor_row(g4), 0)
    test.assert_eq(grid.grid_cursor_col(g4), 0)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g4, 0, 0)), 32)
    var g5 = grid.grid_put_char(var g4, 90)   // 'Z' in alt at (0,0)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g5, 0, 0)), 90)
    var g6 = grid.grid_exit_alt_screen(var g5)
    test.assert_eq(grid.grid_cursor_row(g6), 0)
    test.assert_eq(grid.grid_cursor_col(g6), 2)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 0)), 65)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 1)), 66)
    grid.grid_drop(g6)

// Rows shifted off the top of the live grid via scroll_up land in
// the scrollback ring and can be read back through grid_view_get
// once view_offset > 0.
@test
fn test_scrollback_captures_scrolled_rows() [io]
    var g0 = grid.grid_new(2, 3)
    // Put 'A' on row 0, scroll up — that row goes to scrollback.
    let g1 = grid.grid_put_char(var g0, 65)
    let g2 = grid.grid_scroll_up(g1)
    // Live grid now: row 0 blank, row 1 blank.
    test.assert_eq(grid.cell_glyph(grid.grid_get(g2, 0, 0)), 32)
    // Scrollback has 1 line ('A' at col 0).
    test.assert_eq(grid.scrollback_count(g2.scrollback), 1)
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(g2.scrollback, 0, 0)), 65)
    // View offset 1 — visible row 0 = the scrollback line ('A'),
    // visible row 1 = live grid row 0 (blank).
    let g3 = grid.grid_scroll_view(g2, 1)
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g3, 0, 0)), 65)
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g3, 1, 0)), 32)
    grid.grid_drop(g3)

// View resets to live (offset 0) when any new shell output
// arrives via grid_put_char — xterm convention.
@test
fn test_scrollback_view_resets_on_put_char() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 65)
    let g2 = grid.grid_scroll_up(g1)
    var g3 = grid.grid_scroll_view(g2, 1)
    test.assert_eq(grid.grid_view_offset(g3), 1)
    var g4 = grid.grid_put_char(var g3, 90)   // 'Z' resets view
    test.assert_eq(grid.grid_view_offset(g4), 0)
    grid.grid_drop(g4)

@test
fn test_scrollback_skipped_when_in_alt_screen() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' on primary
    var g2 = grid.grid_enter_alt_screen(var g1)
    let g3 = grid.grid_put_char(var g2, 90)   // 'Z' in alt
    var g4 = grid.grid_scroll_up(g3)   // alt scrolls
    // Scrollback still empty — alt's scrolls don't push.
    test.assert_eq(grid.scrollback_count(g4.scrollback), 0)
    let g5 = grid.grid_exit_alt_screen(var g4)
    // Primary still has 'A' at (0,0).
    test.assert_eq(grid.cell_glyph(grid.grid_get(g5, 0, 0)), 65)
    grid.grid_drop(g5)

// Window resize: grid grows + shrinks preserve top-left content,
// clamp cursor into new bounds, keep SGR + scrollback state.
@test
fn test_grid_resize_grow_preserves_content() [io]
    var g0 = grid.grid_new(2, 3)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    let g2 = grid.grid_put_char(var g1, 66)   // 'B' at (0,1)
    let g3 = grid.grid_resize(g2, 4, 5)
    test.assert_eq(grid.grid_rows(g3), 4)
    test.assert_eq(grid.grid_cols(g3), 5)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g3, 0, 0)), 65)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g3, 0, 1)), 66)
    // New cells are blank.
    test.assert_eq(grid.cell_glyph(grid.grid_get(g3, 3, 4)), 32)
    grid.grid_drop(g3)

// A shrink clamps a cursor that stands on a blank row below the text into
// the new bounds: (2,4) in a 3x5 grid is (1,2) in a 2x3.
@test
fn test_grid_resize_shrink_clamps_cursor() [io, ffi]
    var g0 = grid.grid_new(3, 5)
    let g1 = grid.grid_cursor_set(var g0, 2, 4)   // cursor at far corner
    var g2 = grid.grid_resize(g1, 2, 3)
    // Cursor clamped into the new (2, 3) bounds.
    test.assert_eq(grid.grid_cursor_row(g2), 1)
    test.assert_eq(grid.grid_cursor_col(g2), 2)
    grid.grid_drop(g2)

// DECSTBM scroll regions.  Set top/bottom, scroll
// within: rows outside the region must NOT shift.
@test
fn test_scroll_region_isolates_top_and_bottom() [io]
    var g0 = grid.grid_new(5, 3)
    // Fill row 0..4 with 'A'..'E' (one char per row, leftmost).
    var g1 = grid.grid_cursor_set(var g0, 0, 0)
    var g2 = grid.grid_put_char(var g1, 65)
    var g3 = grid.grid_cursor_set(var g2, 1, 0)
    var g4 = grid.grid_put_char(var g3, 66)
    var g5 = grid.grid_cursor_set(var g4, 2, 0)
    var g6 = grid.grid_put_char(var g5, 67)
    var g7 = grid.grid_cursor_set(var g6, 3, 0)
    var g8 = grid.grid_put_char(var g7, 68)
    var g9 = grid.grid_cursor_set(var g8, 4, 0)
    let gA = grid.grid_put_char(var g9, 69)
    // Set region to rows 1..3.  Scroll up: row 1 ('B') is
    // discarded; rows 2-3 shift up; row 3 fills with blank.
    // Rows 0 ('A') and 4 ('E') are untouched.
    let gB = grid.grid_set_scroll_region(gA, 1, 3)
    let gC = grid.grid_scroll_up(gB)
    test.assert_eq(grid.cell_glyph(grid.grid_get(gC, 0, 0)), 65)   // 'A' untouched
    test.assert_eq(grid.cell_glyph(grid.grid_get(gC, 1, 0)), 67)   // 'C'  (was row 2)
    test.assert_eq(grid.cell_glyph(grid.grid_get(gC, 2, 0)), 68)   // 'D'  (was row 3)
    test.assert_eq(grid.cell_glyph(grid.grid_get(gC, 3, 0)), 32)   // blank
    test.assert_eq(grid.cell_glyph(grid.grid_get(gC, 4, 0)), 69)   // 'E' untouched
    grid.grid_drop(gC)

// ECH — erase N chars in place.  Cursor stays.
@test
fn test_erase_chars_keeps_cursor() [io]
    var g0 = grid.grid_new(1, 5)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    var g2 = grid.grid_put_char(var g1, 66)   // 'B' at (0,1)
    var g3 = grid.grid_put_char(var g2, 67)   // 'C' at (0,2)
    var g4 = grid.grid_put_char(var g3, 68)   // 'D' at (0,3)
    let g5 = grid.grid_cursor_set(var g4, 0, 1)   // at 'B'
    let g6 = grid.grid_erase_chars(g5, 2)   // wipe B,C in place
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 0)), 65)   // 'A'
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 1)), 32)   // blank
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 2)), 32)   // blank
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 3)), 68)   // 'D' untouched
    test.assert_eq(grid.grid_cursor_col(g6), 1)
    grid.grid_drop(g6)

// IL — insert lines at cursor.
@test
fn test_insert_lines_pushes_down() [io]
    var g0 = grid.grid_new(4, 3)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    var g2 = grid.grid_cursor_set(var g1, 1, 0)
    var g3 = grid.grid_put_char(var g2, 66)   // 'B' at (1,0)
    var g4 = grid.grid_cursor_set(var g3, 0, 0)
    let g5 = grid.grid_insert_lines(g4, 1)   // push everything down
    test.assert_eq(grid.cell_glyph(grid.grid_get(g5, 0, 0)), 32)   // blank
    test.assert_eq(grid.cell_glyph(grid.grid_get(g5, 1, 0)), 65)   // 'A'
    test.assert_eq(grid.cell_glyph(grid.grid_get(g5, 2, 0)), 66)   // 'B'
    grid.grid_drop(g5)

// DCH — delete chars at cursor, shift left.
@test
fn test_delete_chars_shifts_left() [io]
    var g0 = grid.grid_new(1, 5)
    var g1 = grid.grid_put_char(var g0, 65)   // 'A' at (0,0)
    var g2 = grid.grid_put_char(var g1, 66)   // 'B' at (0,1)
    var g3 = grid.grid_put_char(var g2, 67)   // 'C' at (0,2)
    var g4 = grid.grid_put_char(var g3, 68)   // 'D' at (0,3)
    var g5 = grid.grid_cursor_set(var g4, 0, 1)   // at 'B'
    let g6 = grid.grid_delete_chars(g5, 2)   // delete 'B','C'
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 0)), 65)   // 'A'
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 1)), 68)   // 'D' shifted in
    test.assert_eq(grid.cell_glyph(grid.grid_get(g6, 0, 2)), 32)   // blank
    grid.grid_drop(g6)

@test
fn test_decsc_decrc_round_trip() [io]
    // Use 3×4 grid, save at (1, 2) — well clear of the bottom-
    // right corner so put_char doesn't trigger an end-of-row
    // wrap + bottom-of-screen scroll that would relocate the
    // probe cell.
    var g0 = grid.grid_new(3, 4)
    var g1 = grid.grid_cursor_set(var g0, 1, 2)
    let g2 = grid.grid_set_fg(var g1, 6)   // cyan
    var g3 = grid.grid_decsc(g2)
    var g4 = grid.grid_cursor_set(var g3, 0, 0)
    var g5 = grid.grid_set_fg(var g4, 1)   // red
    test.assert_eq(grid.grid_cursor_row(g5), 0)
    var g6 = grid.grid_decrc(var g5)
    test.assert_eq(grid.grid_cursor_row(g6), 1)
    test.assert_eq(grid.grid_cursor_col(g6), 2)
    let g7 = grid.grid_put_char(var g6, 88)   // 'X' at (1,2) in cyan
    let cell = grid.grid_get(g7, 1, 2)
    test.assert_eq(grid.cell_glyph(cell), 88)
    test.assert_eq(grid.cell_fg(cell), 6)
    grid.grid_drop(g7)

// ── Mouse-tracking SGR decision (grid_mouse_sgr_code) ───────────
// Regression tests for the "hover extends selection" bug: idle pointer
// motion (no mouse button held) must NOT be forwarded to the app as a
// left-button drag.  Encodes the fix — a motion event's button is the
// HELD button (or 3 = none for hover), not a hardcoded left-button.
//   mode bits: 1=1000, 2=1002(drag), 4=1003(any-motion), 8=1006(SGR).
//   mods bits: 1=Shift, 2=Ctrl, 4=Alt, 8=left-held, 16=mid, 32=right.
//   returns the SGR button byte, or -1 = "don't forward".

@test
fn test_mouse_no_tracking_never_forwards() [io]
    // mode 0 → nothing forwarded, press or motion.
    test.assert_eq(grid.grid_mouse_sgr_code(0, 0, false, 0), 0 - 1)
    test.assert_eq(grid.grid_mouse_sgr_code(0, 8, true, 0), 0 - 1)

@test
fn test_mouse_shift_bypasses_tracking() [io]
    // Shift held → -1 even with tracking on, so local selection works.
    test.assert_eq(grid.grid_mouse_sgr_code(10, 1, false, 0), 0 - 1)

@test
fn test_mouse_idle_hover_not_a_drag_in_1002() [io]
    // THE FIX: 1002 (drag-only) + NO button held + motion → NOT
    // forwarded.  Previously emitted a bogus left-button drag, so
    // tracking apps (zellij) kept extending their selection on hover.
    test.assert_eq(grid.grid_mouse_sgr_code(10, 0, true, 0), 0 - 1)

@test
fn test_mouse_idle_hover_is_no_button_motion_in_1003() [io]
    // 1003 (any-motion) + no button → SGR button 3 (no-button) + motion
    // bit 32 = 35, NOT left-button motion (32).
    test.assert_eq(grid.grid_mouse_sgr_code(12, 0, true, 0), 35)

@test
fn test_mouse_real_drag_forwards_held_button() [io]
    // 1002 + left held + motion → button 0 + motion = 32.
    test.assert_eq(grid.grid_mouse_sgr_code(10, 8, true, 0), 32)
    // 1003 + right held + motion → button 2 + motion = 34.
    test.assert_eq(grid.grid_mouse_sgr_code(12, 32, true, 0), 34)

@test
fn test_mouse_clicks_forward_but_1000_has_no_drag() [io]
    // 1002 press (button 0, no motion) → code 0.
    test.assert_eq(grid.grid_mouse_sgr_code(10, 0, false, 0), 0)
    // 1000 (click-only): press forwarded…
    test.assert_eq(grid.grid_mouse_sgr_code(9, 0, false, 0), 0)
    // …but motion — even with a button held — is not (1000 = no drag).
    test.assert_eq(grid.grid_mouse_sgr_code(9, 8, true, 0), 0 - 1)

// ── Session colours ─────────────────────────────────────────────
//
// The palette and the two default colours are module state, so each
// test puts back what it changed before it returns.

@test
fn test_palette_defaults_are_the_xterm_table() [io, mutate]
    grid.palette_reset()
    // 0..15 the ANSI base.
    test.assert_eq(grid.palette_lookup(0), 0x000000)
    test.assert_eq(grid.palette_lookup(1), 0xAA0000)
    test.assert_eq(grid.palette_lookup(9), 0xFF5555)
    test.assert_eq(grid.palette_lookup(15), 0xFFFFFF)
    // 16..231 the 6 x 6 x 6 cube.
    test.assert_eq(grid.palette_lookup(16), 0x000000)
    test.assert_eq(grid.palette_lookup(21), 0x0000FF)
    test.assert_eq(grid.palette_lookup(67), 0x5F87AF)
    test.assert_eq(grid.palette_lookup(196), 0xFF0000)
    test.assert_eq(grid.palette_lookup(231), 0xFFFFFF)
    // 232..255 the grayscale ramp.
    test.assert_eq(grid.palette_lookup(232), 0x080808)
    test.assert_eq(grid.palette_lookup(255), 0xEEEEEE)
    // Outside the table: white.
    test.assert_eq(grid.palette_lookup(0 - 1), 0xFFFFFF)
    test.assert_eq(grid.palette_lookup(256), 0xFFFFFF)

@test
fn test_palette_set_and_reset() [io, mutate]
    grid.palette_reset()
    grid.palette_set(1, 0x123456)
    grid.palette_set(200, 0xFF123456)   // only the low 24 bits are kept
    test.assert_eq(grid.palette_lookup(1), 0x123456)
    test.assert_eq(grid.palette_lookup(200), 0x123456)
    // A slot nobody changed still answers the default.
    test.assert_eq(grid.palette_lookup(2), 0x00AA00)
    // An index outside the table is ignored.
    grid.palette_set(0 - 1, 0x111111)
    grid.palette_set(256, 0x222222)
    test.assert_eq(grid.palette_lookup(256), 0xFFFFFF)
    // The change reaches a cell built from an index.
    test.assert_eq(grid.cell_fg(grid.pack_word0_idx(65, 1, 0)), 0x123456)
    grid.palette_reset()
    test.assert_eq(grid.palette_lookup(1), 0xAA0000)
    test.assert_eq(grid.palette_lookup(200), 0xFF00D7)

@test
fn test_session_defaults_start_light_gray_on_black_and_follow_the_setters() [io, mutate]
    let fg0 = grid.session_default_fg()
    let bg0 = grid.session_default_bg()
    test.assert_eq(fg0, 0xAAAAAA)
    test.assert_eq(bg0, 0x000000)
    grid.session_set_default_fg(0xFF112233)   // low 24 bits
    grid.session_set_default_bg(0x445566)
    test.assert_eq(grid.session_default_fg(), 0x112233)
    test.assert_eq(grid.session_default_bg(), 0x445566)
    // SGR 0 reads them.
    var g = grid.grid_new(1, 2)
    g = grid.grid_sgr_reset(var g)
    g = grid.grid_put_char(var g, 65)
    let cell = grid.grid_get(g, 0, 0)
    test.assert_eq(grid.cell_fg(cell), 0x112233)
    test.assert_eq(grid.cell_bg(grid.grid_get_w1(g, 0, 0)), 0x445566)
    grid.grid_drop(g)
    grid.session_set_default_fg(fg0)
    grid.session_set_default_bg(bg0)

// ── Bounds, rings, editing limits, alt screen and resize ───────────
//
// The tests below pin the edges of the model: what a read outside the
// grid answers, where a count is clamped, what a function does when
// there is nothing for it to do, and how a resize carries content.

// A grid whose row `r` holds the letter 'A' + r in every column.
fn lettered_rows(rows: Int, cols: Int) -> grid.Grid [io, mutate]
    var g = grid.grid_new(rows, cols)
    for r in 0..rows
        for c in 0..cols
            g = grid.grid_set(g, r, c, grid.pack_word0_idx(65 + r, 7, 0))
    g

// Column 0 of every row as one string; a blank is a space.
fn col0_letters(g: grid.Grid) -> Str [io, ffi]
    var s = ""
    for r in 0..grid.grid_rows(g)
        s = s + str.from_char(grid.cell_glyph(grid.grid_get(g, r, 0)))
    s

// Row `r` as one string.
fn row_text(g: grid.Grid, r: Int) -> Str [io, ffi]
    var s = ""
    for c in 0..grid.grid_cols(g)
        s = s + str.from_char(grid.cell_glyph(grid.grid_get(g, r, c)))
    s

// A read outside the grid answers a blank cell in the default colours,
// on both words, and does not fault.
@test
fn test_reads_outside_the_grid_answer_a_blank() [io]
    let g = grid.grid_new(2, 3)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, -1, 0)), 32)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, 2, 0)), 32)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, 0, 3)), 32)
    test.assert_eq(grid.cell_bg(grid.grid_get_w1(g, 0, -1)), grid.default_bg_rgb())
    test.assert_eq(grid.cell_bg(grid.grid_get_w1(g, 5, 5)), grid.default_bg_rgb())
    grid.grid_drop(g)

// The cursor setter clamps into the grid on both axes.
@test
fn test_cursor_set_clamps_into_the_grid() [io]
    var g0 = grid.grid_new(3, 4)
    let g1 = grid.grid_cursor_set(var g0, -3, 99)
    test.assert_eq(grid.grid_cursor_row(g1), 0)
    test.assert_eq(grid.grid_cursor_col(g1), 3)
    let g2 = grid.grid_cursor_set(var g0, 99, -1)
    test.assert_eq(grid.grid_cursor_row(g2), 2)
    test.assert_eq(grid.grid_cursor_col(g2), 0)
    grid.grid_drop(g2)

// A scroll region is clamped into the grid; one that names no row, or
// whose top is below its bottom, is ignored and the old region stands.
@test
fn test_scroll_region_is_clamped_or_ignored() [io]
    var g = grid.grid_new(5, 2)
    g = grid.grid_set_scroll_region(g, -4, 2)
    test.assert_eq(grid.grid_region_top(g), 0)
    test.assert_eq(grid.grid_region_bottom(g), 2)
    g = grid.grid_set_scroll_region(g, 1, 99)
    test.assert_eq(grid.grid_region_top(g), 1)
    test.assert_eq(grid.grid_region_bottom(g), 4)
    g = grid.grid_set_scroll_region(g, 9, 12)
    test.assert_eq(grid.grid_region_top(g), 1)
    test.assert_eq(grid.grid_region_bottom(g), 4)
    g = grid.grid_set_scroll_region(g, 3, 1)
    test.assert_eq(grid.grid_region_top(g), 1)
    test.assert_eq(grid.grid_region_bottom(g), 4)
    grid.grid_drop(g)

// NUL, a negative value and DEL are not printable: nothing is written
// and the cursor stays.
@test
fn test_put_char_ignores_nul_negative_and_del() [io]
    var g0 = grid.grid_new(1, 4)
    var g = grid.grid_put_char(var g0, 0)
    g = grid.grid_put_char(var g, -5)
    g = grid.grid_put_char(var g, 127)
    test.assert_eq(grid.grid_cursor_col(g), 0)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, 0, 0)), 32)
    grid.grid_drop(g)

// Filling the last column of the last row and printing once more
// scrolls the grid: the top row goes to history, the wrap is recorded on
// the row that wrapped, and the new character starts the bottom row.
@test
fn test_wrap_at_the_bottom_scrolls_and_marks_the_wrapped_row() [io]
    var g = grid.grid_new(2, 2)
    for ch in [65, 66, 67, 68, 69]
        g = grid.grid_put_char(var g, ch)
    test.assert_eq(row_text(g, 0), "CD")
    test.assert_eq(row_text(g, 1), "E ")
    test.assert_eq(scrollback_text(g, 0), "AB")
    test.assert_eq(grid.grid_row_wrapped(g, 0), 1)
    test.assert_eq(grid.grid_row_wrapped(g, 1), 0)
    // A row index outside the grid has no wrap mark.
    test.assert_eq(grid.grid_row_wrapped(g, -1), 0)
    test.assert_eq(grid.grid_row_wrapped(g, 2), 0)
    grid.grid_drop(g)

// A scrollback row as one string, from the ring's own reader.
fn scrollback_text(g: grid.Grid, l: Int) -> Str [io, ffi]
    var s = ""
    for c in 0..grid.scrollback_cols(g.scrollback)
        s = s + str.from_char(grid.cell_glyph(grid.scrollback_get_cell(g.scrollback, l, c)))
    s

// The ring holds 1000 rows.  Past that, each scrolled-off row replaces
// the oldest, so the oldest row is the one scrolled 1000 scrolls ago.
@test
fn test_scrollback_ring_replaces_the_oldest_row_when_full() [io]
    var g = grid.grid_new(2, 2)
    for k in 1..1006
        g = grid.grid_set(g, 0, 0, grid.pack_word0_idx(100 + k, 7, 0))
        g = grid.grid_scroll_up(g)
    test.assert_eq(grid.scrollback_count(g.scrollback), 1000)
    // Scrolls 1..5 were overwritten; the oldest kept is the sixth.
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(g.scrollback, 0, 0)), 106)
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(g.scrollback, 999, 0)), 1105)
    grid.grid_drop(g)

// A scrollback read outside the stored rows or the stored width answers
// a blank on both words.
@test
fn test_scrollback_reads_outside_the_ring_answer_a_blank() [io]
    var g0 = grid.grid_new(2, 2)
    let g = grid.grid_scroll_up(g0)
    let sb = g.scrollback
    test.assert_eq(grid.scrollback_count(sb), 1)
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(sb, 1, 0)), 32)
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(sb, -1, 0)), 32)
    test.assert_eq(grid.cell_glyph(grid.scrollback_get_cell(sb, 0, 2)), 32)
    test.assert_eq(grid.cell_bg(grid.scrollback_get_cell_w1(sb, 1, 0)), grid.default_bg_rgb())
    test.assert_eq(grid.cell_bg(grid.scrollback_get_cell_w1(sb, 0, -1)), grid.default_bg_rgb())
    grid.grid_drop(g)

// The view reads history through the pair `grid_view_get` /
// `grid_view_get_w1`: a row above the stored history answers a blank, and
// the alt screen bypasses the history entirely.
@test
fn test_view_reads_blank_above_history_and_bypasses_it_in_alt() [io]
    var g = lettered_rows(2, 2)
    g = grid.grid_scroll_up(g)
    // Raw ring setter: the view can be put past the stored count, and the
    // reader answers blank for the rows that lie above the first.
    grid.scrollback_set_view_offset(g.scrollback, 3)
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g, 0, 0)), 32)
    test.assert_eq(grid.cell_bg(grid.grid_view_get_w1(g, 0, 0)), grid.default_bg_rgb())
    // One row back: the top row is the stored 'A', the next the live 'B'.
    grid.scrollback_set_view_offset(g.scrollback, 1)
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g, 0, 0)), 65)
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g, 1, 0)), 66)
    test.assert_eq(grid.cell_bg(grid.grid_view_get_w1(g, 0, 0)), grid.default_bg_rgb())
    // Alt screen: the view is the live alt grid whatever the offset says.
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_set(g, 0, 0, grid.pack_word0_idx(88, 7, 0))
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g, 0, 0)), 88)
    test.assert_eq(grid.cell_bg(grid.grid_view_get_w1(g, 0, 0)), grid.default_bg_rgb())
    // Scrolling the view is refused there.
    g = grid.grid_scroll_view(g, 1)
    test.assert_eq(grid.grid_view_offset(g), 1)
    grid.grid_drop(g)

// A view scrolled down past live output stops at live.
@test
fn test_scroll_view_clamps_at_live_and_at_the_oldest_row() [io]
    var g = lettered_rows(2, 2)
    g = grid.grid_scroll_up(g)
    g = grid.grid_scroll_view(g, 9)
    test.assert_eq(grid.grid_view_offset(g), 1)
    g = grid.grid_scroll_view(g, -9)
    test.assert_eq(grid.grid_view_offset(g), 0)
    // At live the view is the grid itself: its top row is the scrolled-up 'B'.
    test.assert_eq(grid.cell_glyph(grid.grid_view_get(g, 0, 0)), 66)
    test.assert_eq(grid.cell_bg(grid.grid_view_get_w1(g, 0, 0)), grid.default_bg_rgb())
    grid.grid_drop(g)

// The SGR button byte of a mouse report: 0 left, 1 middle, 2 right, 3
// none; +32 for motion, +16 for Ctrl, +8 for Alt.  The report is
// withheld when the mode does not ask for it, and Shift is left to the
// terminal's own selection.
@test
fn test_mouse_code_encodes_buttons_modifiers_and_motion() [io]
    // Drag with the middle button held, in 1002.
    test.assert_eq(grid.grid_mouse_sgr_code(2, 16, true, 0), 33)
    // Drag with the right button held, in 1002.
    test.assert_eq(grid.grid_mouse_sgr_code(2, 32, true, 0), 34)
    // Drag with the left button held.
    test.assert_eq(grid.grid_mouse_sgr_code(2, 8, true, 0), 32)
    // Idle hover is button 3 plus motion, and only 1003 reports it.
    test.assert_eq(grid.grid_mouse_sgr_code(4, 0, true, 0), 35)
    test.assert_eq(grid.grid_mouse_sgr_code(2, 0, true, 0), -1)
    // Press with Ctrl, with Alt, with both.
    test.assert_eq(grid.grid_mouse_sgr_code(1, 2, false, 0), 16)
    test.assert_eq(grid.grid_mouse_sgr_code(1, 4, false, 2), 10)
    test.assert_eq(grid.grid_mouse_sgr_code(1, 6, false, 0), 24)
    // Shift, or no tracking, is not forwarded.
    test.assert_eq(grid.grid_mouse_sgr_code(1, 1, false, 0), -1)
    test.assert_eq(grid.grid_mouse_sgr_code(0, 0, false, 0), -1)

// Mode bits are set and cleared one at a time; clearing a bit that is
// not set leaves the mask as it was.
@test
fn test_mouse_mode_bits_set_and_clear_independently() [io]
    var g = grid.grid_new(1, 1)
    g = grid.grid_mouse_mode_bit_on(g, 1)
    g = grid.grid_mouse_mode_bit_on(g, 4)
    test.assert_eq(grid.grid_mouse_mode(g), 5)
    g = grid.grid_mouse_mode_bit_off(g, 1)
    test.assert_eq(grid.grid_mouse_mode(g), 4)
    g = grid.grid_mouse_mode_bit_off(g, 1)
    test.assert_eq(grid.grid_mouse_mode(g), 4)
    grid.grid_drop(g)

// EL 1 erases from the start of the line through the cursor, EL 2 the
// whole line; ED 1 erases from the start of the display through the
// cursor.  Cells past the erased span keep their content.
@test
fn test_erase_line_and_display_toward_the_start() [io]
    var g = lettered_rows(3, 4)
    g = grid.grid_cursor_set(var g, 1, 2)
    g = grid.grid_erase_line(var g, 1)
    test.assert_eq(row_text(g, 1), "   B")
    g = grid.grid_erase_line(var g, 2)
    test.assert_eq(row_text(g, 1), "    ")
    g = lettered_rows(3, 4)
    g = grid.grid_cursor_set(var g, 1, 2)
    g = grid.grid_erase_display(var g, 1)
    test.assert_eq(row_text(g, 0), "    ")
    test.assert_eq(row_text(g, 1), "   B")
    test.assert_eq(row_text(g, 2), "CCCC")
    grid.grid_drop(g)

// A count below one does nothing; a count past the region clamps to the
// rows that remain; a cursor below the region's bottom is outside it.
@test
fn test_insert_and_delete_lines_respect_count_and_region() [io]
    var g = lettered_rows(5, 2)
    g = grid.grid_set_scroll_region(g, 1, 3)
    g = grid.grid_cursor_set(var g, 2, 0)
    g = grid.grid_insert_lines(g, 0)
    g = grid.grid_delete_lines(g, -1)
    test.assert_eq(col0_letters(g), "ABCDE")
    g = grid.grid_insert_lines(g, 9)
    test.assert_eq(col0_letters(g), "AB  E")
    g = lettered_rows(5, 2)
    g = grid.grid_set_scroll_region(g, 1, 3)
    g = grid.grid_cursor_set(var g, 2, 0)
    g = grid.grid_delete_lines(g, 9)
    test.assert_eq(col0_letters(g), "AB  E")
    g = lettered_rows(5, 2)
    g = grid.grid_set_scroll_region(g, 1, 3)
    g = grid.grid_cursor_set(var g, 4, 0)
    g = grid.grid_insert_lines(g, 1)
    g = grid.grid_delete_lines(g, 1)
    test.assert_eq(col0_letters(g), "ABCDE")
    grid.grid_drop(g)

// ECH, ICH and DCH with a count below one do nothing, and with a count
// past the right margin act on the cells that are there.
@test
fn test_character_editing_counts_are_limited_to_the_row() [io]
    var g = grid.grid_new(1, 6)
    for ch in [65, 66, 67, 68, 69, 70]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_cursor_set(var g, 0, 4)
    g = grid.grid_erase_chars(g, 0)
    g = grid.grid_insert_chars(g, 0)
    g = grid.grid_delete_chars(g, -2)
    test.assert_eq(row_text(g, 0), "ABCDEF")
    g = grid.grid_erase_chars(g, 9)
    test.assert_eq(row_text(g, 0), "ABCD  ")
    g = grid.grid_cursor_set(var g, 0, 0)
    for ch in [69, 70, 71, 72, 73, 74]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_cursor_set(var g, 0, 4)
    g = grid.grid_insert_chars(g, 9)
    test.assert_eq(row_text(g, 0), "EFGH  ")
    g = grid.grid_delete_chars(g, 9)
    test.assert_eq(row_text(g, 0), "EFGH  ")
    grid.grid_drop(g)

// SD with a count below one does nothing, and with a count past the
// region blanks the region and leaves the rows outside it.
@test
fn test_scroll_region_down_counts_are_limited_to_the_region() [io]
    var g = lettered_rows(4, 2)
    g = grid.grid_set_scroll_region(g, 1, 2)
    g = grid.grid_scroll_region_down(g, 0)
    test.assert_eq(col0_letters(g), "ABCD")
    g = grid.grid_scroll_region_down(g, 9)
    test.assert_eq(col0_letters(g), "A  D")
    g = lettered_rows(4, 2)
    g = grid.grid_scroll_region_up(g, 0)
    test.assert_eq(col0_letters(g), "ABCD")
    grid.grid_drop(g)

// Entering the alt screen while already in it clears it and homes the
// cursor with default colours; the primary screen is not touched.
@test
fn test_enter_alt_twice_clears_the_alt_screen() [io]
    var g = lettered_rows(2, 3)
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_put_char(var g, 88)
    g = grid.grid_set_fg(var g, 0x123456)
    g = grid.grid_set_attrs(var g, 1)
    g = grid.grid_enter_alt_screen(var g)
    test.assert_eq(row_text(g, 0), "   ")
    test.assert_eq(grid.grid_cursor_col(g), 0)
    test.assert_eq(g.fg, grid.default_fg_rgb())
    test.assert_eq(g.attrs, 0)
    g = grid.grid_exit_alt_screen(var g)
    test.assert_eq(col0_letters(g), "AB")
    grid.grid_drop(g)

// Leaving the alt screen without having entered it does nothing;
// entering it a second time after a leave reuses the same buffer and
// shows it cleared.
@test
fn test_alt_screen_exit_without_enter_and_reenter_after_exit() [io]
    var g = lettered_rows(2, 3)
    g = grid.grid_cursor_set(var g, 1, 1)
    g = grid.grid_exit_alt_screen(var g)
    test.assert_eq(grid.grid_cursor_row(g), 1)
    test.assert_eq(col0_letters(g), "AB")
    g = grid.grid_enter_alt_screen(var g)
    let first = array_i64_get(g.alt_meta, 1)
    g = grid.grid_put_char(var g, 88)
    g = grid.grid_exit_alt_screen(var g)
    g = grid.grid_enter_alt_screen(var g)
    test.assert_eq(array_i64_get(g.alt_meta, 1), first)
    test.assert_eq(row_text(g, 0), "   ")
    grid.grid_drop(g)

// Dropping a grid that is on the alt screen releases the saved primary
// buffer as well as the alt one.
@test
fn test_drop_while_on_the_alt_screen() [io]
    var g = lettered_rows(2, 3)
    g = grid.grid_enter_alt_screen(var g)
    test.assert_eq(grid.grid_using_alt(g), 1)
    grid.grid_drop(g)

// Widening a grid rejoins a soft-wrapped line, and narrowing wraps it
// again at the new width, marking each row that continues.  A round trip
// gives back the line.
@test
fn test_resize_reflows_a_wrapped_line() [io]
    var g = grid.grid_new(4, 4)
    for ch in [65, 66, 67, 68, 69, 70, 71]
        g = grid.grid_put_char(var g, ch)
    test.assert_eq(grid.grid_row_wrapped(g, 0), 1)
    g = grid.grid_resize(g, 4, 8)
    test.assert_eq(row_text(g, 0), "ABCDEFG ")
    test.assert_eq(row_text(g, 1), "        ")
    test.assert_eq(grid.grid_row_wrapped(g, 0), 0)
    g = grid.grid_resize(g, 4, 3)
    test.assert_eq(row_text(g, 0), "ABC")
    test.assert_eq(row_text(g, 1), "DEF")
    test.assert_eq(row_text(g, 2), "G  ")
    test.assert_eq(grid.grid_row_wrapped(g, 0), 1)
    test.assert_eq(grid.grid_row_wrapped(g, 1), 1)
    test.assert_eq(grid.grid_row_wrapped(g, 2), 0)
    g = grid.grid_resize(g, 4, 8)
    test.assert_eq(row_text(g, 0), "ABCDEFG ")
    grid.grid_drop(g)

// A resize to the size the grid already has returns it unchanged.
@test
fn test_resize_to_the_same_size_changes_nothing() [io]
    var g = lettered_rows(2, 3)
    g = grid.grid_resize(g, 2, 3)
    test.assert_eq(col0_letters(g), "AB")
    test.assert_eq(grid.grid_rows(g), 2)
    grid.grid_drop(g)

// Reflow that runs out of rows keeps the first rows and drops the rest:
// a line that wraps to more rows than the grid has is cut at the bottom.
@test
fn test_resize_reflow_stops_at_the_last_row() [io]
    var g = grid.grid_new(2, 6)
    for ch in [65, 66, 67, 68, 69, 70]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_resize(g, 2, 2)
    test.assert_eq(row_text(g, 0), "AB")
    test.assert_eq(row_text(g, 1), "CD")
    test.assert_eq(grid.grid_cursor_row(g), 1)
    grid.grid_drop(g)

// With the same width, a resize copies cells top-left aligned and
// clamps the cursor into the new bounds; shrinking drops the rows and
// columns that no longer fit.
@test
fn test_resize_same_width_copies_and_clamps_the_cursor() [io]
    var g = lettered_rows(4, 4)
    g = grid.grid_cursor_set(var g, 3, 1)
    g = grid.grid_resize(g, 2, 4)
    test.assert_eq(col0_letters(g), "AB")
    test.assert_eq(grid.grid_cursor_row(g), 1)
    test.assert_eq(grid.grid_cursor_col(g), 1)
    g = grid.grid_resize(g, 5, 4)
    test.assert_eq(col0_letters(g), "AB   ")
    test.assert_eq(grid.grid_cursor_row(g), 1)
    grid.grid_drop(g)

// On the alt screen a resize is a cell copy, not a reflow, and the
// primary buffer saved behind it is resized too, so leaving the alt
// screen after the resize shows the primary content at the new size.
@test
fn test_resize_on_the_alt_screen_resizes_the_saved_primary() [io]
    var g = lettered_rows(3, 4)
    g = grid.grid_cursor_set(var g, 2, 3)
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_set(g, 0, 0, grid.pack_word0_idx(88, 7, 0))
    g = grid.grid_resize(g, 2, 2)
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, 0, 0)), 88)
    test.assert_eq(grid.grid_rows(g), 2)
    g = grid.grid_exit_alt_screen(var g)
    test.assert_eq(col0_letters(g), "AB")
    test.assert_eq(grid.grid_cols(g), 2)
    test.assert_eq(grid.grid_cursor_row(g), 1)
    test.assert_eq(grid.grid_cursor_col(g), 1)
    grid.grid_drop(g)

// A resize on the primary screen resizes an alt buffer allocated
// earlier, so the next enter finds a buffer of the new size.
@test
fn test_resize_on_the_primary_screen_resizes_the_idle_alt_buffer() [io]
    var g = lettered_rows(2, 3)
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_exit_alt_screen(var g)
    g = grid.grid_resize(g, 3, 5)
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_set(g, 2, 4, grid.pack_word0_idx(88, 7, 0))
    test.assert_eq(grid.cell_glyph(grid.grid_get(g, 2, 4)), 88)
    test.assert_eq(grid.grid_rows(g), 3)
    grid.grid_drop(g)

// A column-only shrink on the alt screen keeps the cursor row and pulls
// the column back to the last one that exists.
@test
fn test_resize_on_the_alt_screen_clamps_the_cursor_column() [io]
    var g = grid.grid_new(3, 4)
    g = grid.grid_enter_alt_screen(var g)
    g = grid.grid_cursor_set(var g, 2, 3)
    g = grid.grid_resize(g, 3, 2)
    test.assert_eq(grid.grid_cursor_row(g), 2)
    test.assert_eq(grid.grid_cursor_col(g), 1)
    grid.grid_drop(g)

// The cursor follows the text through a re-wrap: after 'G' of a line
// that wrapped at 4 columns, a widening rejoins the line and the cursor
// stays after 'G'.
@test
fn test_resize_keeps_the_cursor_on_the_content() [io]
    var g = grid.grid_new(4, 4)
    for ch in [65, 66, 67, 68, 69, 70, 71]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_resize(g, 4, 8)
    test.assert_eq(grid.grid_cursor_row(g), 0)
    test.assert_eq(grid.grid_cursor_col(g), 7)
    grid.grid_drop(g)

@test
fn test_resize_narrow_keeps_the_cursor_on_the_content() [io]
    var g = grid.grid_new(4, 4)
    for ch in [65, 66, 67, 68, 69, 70, 71]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_resize(g, 4, 3)
    test.assert_eq(grid.grid_cursor_row(g), 2)
    test.assert_eq(grid.grid_cursor_col(g), 1)
    grid.grid_drop(g)

// A cursor on a text cell (not past the text) is tracked at copy time.
@test
fn test_resize_cursor_on_a_text_cell() [io]
    var g = grid.grid_new(4, 4)
    for ch in [65, 66, 67, 68, 69, 70, 71]
        g = grid.grid_put_char(var g, ch)
    g = grid.grid_cursor_set(var g, 0, 2)
    g = grid.grid_resize(g, 4, 8)
    test.assert_eq(grid.grid_cursor_row(g), 0)
    test.assert_eq(grid.grid_cursor_col(g), 2)
    grid.grid_drop(g)
