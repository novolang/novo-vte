// vte_grid_tests.nv — @test fns for novo-vte's Grid model.
//
// Run from the package dir:
//   novo test src/vte_grid_tests.nv
//
// novo-vte is pure Novo (std.array via @ffi and nothing else), so
// these run headless — no PTY, no window, no GPU.  That matters:
// orbit/novoterm's own grid_tests.nv cannot run under 
// because the package pulls in render.nv, which needs the X11 +
// wgpu link surface.  Tests for the shared model belong here.

use std.test
use grid
use parser

// Render row  as space-separated codepoints — comparing glyph
// numbers instead of a Str keeps NUL and other non-printables
// visible in the failure message instead of truncating it.
fn rowstr(g: grid.Grid, r: Int, cols: Int) -> Str [io, ffi]
    let mut s = ""
    for i in 0..cols
        s = s + str.from_int(grid.cell_glyph(grid.grid_get(g, r, i))) + " "
    s

// A cell is TWO i64 words (w0 = glyph/attrs/fg, w1 = bg), so any raw
// read of g.cells must scale the cell index by 2.  An unscaled read
// yields w0, w1, w0… interleaved, and cell_glyph of a bg word is 0 —
// a NUL that truncates the dump at the first cell and silently blinds
// NOVO_TERM_GRID_TRACE, the only diagnostic for what was rendered.
// This test pins the stride at the one function that dumps the grid.
@test
fn test_grid_to_string_uses_two_word_stride() [io]
    let g0 = grid.grid_new(2, 3)
    let p  = parser.parser_new()
    let a  = parser.parser_feed_byte(p, g0, 65)   // 'A'
    let b  = parser.parser_feed_byte(p, a,  66)   // 'B'
    test.assert_eq(grid.grid_to_string(b), "@ 0,2\nAB \n   \n")
    parser.parser_drop(p)
    grid.grid_drop(b)

// Real zsh line-editor traffic, captured from a live PTY running
// the author's actual config (powerlevel10k prompt + syntax
// highlighting + autosuggestions) while typing u, i, o, p and then
// two DELs.  zle rewrites the line on nearly every keystroke — BS
// to back up, SGR runs to recolor, a trailing space to erase — so
// this pins BS-after-CSI, the deferred-wrap interaction, and the
// UTF-8 path (the prompt carries ➜ and a Powerline glyph) all at
// once.  Expectations were generated by feeding the identical byte
// stream to xterm (via pyte); this test asserts novo-vte agrees
// with a reference emulator character for character.
//
// The differential against a reference emulator is the point: it is
// what distinguishes "novo-vte mis-parsed the stream" from "the
// stream really does say that", and only the former is our bug.
@test
fn test_real_zsh_line_edit_matches_xterm() [io]
    let p = parser.parser_new()
    let mut g = grid.grid_new(24, 80)
    g = parser.parser_feed_byte(p, g, 27)
    g = parser.parser_feed_byte(p, g, 91)
    g = parser.parser_feed_byte(p, g, 49)
    g = parser.parser_feed_byte(p, g, 109)
    g = parser.parser_feed_byte(p, g, 27)
    g = parser.parser_feed_byte(p, g, 91)
    g = parser.parser_feed_byte(p, g, 55)
