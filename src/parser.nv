// parser.nv — ANSI / xterm escape-sequence parser, shared by novoterm
// and novomux.
//
// State machine loosely tracking the DEC parser (Williams, "A parser
// for DEC's ANSI-compatible video terminals").  Sequence semantics
// follow ECMA-48 / ISO 6429 for the standard functions and xterm's
// `ctlseqs` for the DEC private modes.
//
// WHAT IS INTERPRETED — this list is the parser's contract; each entry
// has a `dispatch_*` / `feed_*` arm below.
//
//   text     printable ASCII and 2/3/4-byte UTF-8 (see the lead-byte
//            table further down).  One codepoint = one cell.
//   C0       BS, HT, LF, CR act; BEL and every other C0 byte are
//            dropped.
//   ESC      7 / 8 (DECSC / DECRC), D / E / M (IND / NEL / RI),
//            ( <byte> (charset designate — the byte is consumed).
//   CSI      A B C D (CUU CUD CUF CUB), H f (CUP HVP), E F (CNL CPL),
//            G ` (CHA HPA), d (VPA), a e (HPR VPR), J K (ED EL),
//            L M (IL DL), @ P (ICH DCH), X (ECH), S T (SU SD),
//            r (DECSTBM), m (SGR), c (DA), n (DSR), q (DECSCUSR).
//   CSI ? h/l   7 (DECAWM), 25 (DECTCEM), 47 / 1047 / 1049
//            (alt screen), 1000 / 1002 / 1003 / 1006 (mouse
//            tracking), 2004 (bracketed paste).
//   OSC      accumulated into the `osc` side-array and handed to the
//            caller to dispatch; this module does not act on it.
//
// WHAT IS CONSUMED BUT NOT ACTED ON — deliberately, so the payload
// cannot leak into ground state and be re-parsed as text:
//   - DCS, SOS, PM and APC strings (so no sixel, no ReGIS, no
//     DECRQSS / XTGETTCAP replies).
//   - The charset byte after ESC ( — output is always treated as
//     ASCII/UTF-8, never as a DEC line-drawing set.
//   - Every CSI final and private mode not listed above, plus
//     ESC = / ESC > (DECPAM / DECPNM) and ESC c (RIS).
//
// The three alt-screen modes are collapsed onto one path: `?47` never
// saved the cursor and `?1047` did not either before xterm 251, while
// `?1049` is defined as save + switch + clear.  All three take the
// save+switch+clear path here.
//
// State storage: Parser is a struct wrapping a single
// std.array i64 handle.  Slot layout:
//
//   slot 0   : state machine state (ParserState enum codes)
//   slot 1   : param count (0..MAX_PARAMS)
//   slot 2   : current param accumulator (collecting digits)
//   slot 3   : has_current_param flag (0/1)
//   slot 4   : intermediate byte (e.g. '?' for DEC private)
//   slot 5   : OSC-string saw-ESC flag
//   slot 6..5+MAX_PARAMS : param values
//   slot 22  : UTF-8 partial codepoint accumulator
//   slot 23  : UTF-8 continuation bytes still owed
//
// MAX_PARAMS = 16, so slots 6..21 are params and slots_total() is 24.
// Per-byte cost is O(1) array reads/writes — no struct cloning on the
// hot path, which is what makes a byte-at-a-time feed viable.

// Re-declare the std.array @ffi externs locally — sibling modules
// in pkg builds don't see the auto-prepended stdlib decls (same
// trick grid.nv uses).  Resolves to the same C symbols.

@ffi("novo_array_i64_alloc")
fn array_i64_alloc_h(capacity: Int) -> Int [io, ffi]

@ffi("novo_array_i64_get")
fn array_i64_get_h(h: Int, i: Int) -> Int [io, ffi]

@ffi("novo_array_i64_set")
fn array_i64_set_h(h: Int, i: Int, v: Int) [io, ffi]

@ffi("novo_array_i64_drop")
fn array_i64_drop_h(h: Int) [io, ffi]

use grid

// ── Constants ───────────────────────────────────────────────────

fn st_ground() -> Int
    0
fn st_esc() -> Int
    1
fn st_csi_param() -> Int
    2
fn st_osc_string() -> Int
    3
// "In the middle of a multi-byte UTF-8 codepoint, waiting for
// continuation bytes."
fn st_utf8_cont() -> Int
    4
// Consuming a Device Control String payload until ST (ESC \) or BEL.
// Apps use DCS for terminfo capability queries (`\eP+q…\e\`, xterm's
// XTGETTCAP); dropping the payload here keeps its bytes from leaking
// into ground state and being re-parsed as text and stray CSIs.
fn st_dcs_string() -> Int
    5

fn max_params() -> Int
    16

// 22 slots for the CSI machine (see the slot map in the header) plus
// two for UTF-8 partial-codepoint state: the accumulated lead-byte
// payload and how many continuation bytes are still owed.
fn slots_total() -> Int
    24

fn slot_state() -> Int
    0
fn slot_param_count() -> Int
    1
fn slot_current_param() -> Int
    2
fn slot_has_current() -> Int
    3
fn slot_intermediate() -> Int
    4
fn slot_osc_saw_esc() -> Int
    5
fn slot_utf8_acc() -> Int
    22
fn slot_utf8_remaining() -> Int
    23
fn slot_params_base() -> Int
    6

// ── Parser handle ───────────────────────────────────────────────

struct Parser
    slots: Int
    // Side-array for response bytes queued in answer to host
    // probes (DA, CPR, DSR).  Slot 0
    // holds the count; slots 1..64 hold up to 64 reply bytes.  A
    // CPR/DA response is <16 bytes; 64 covers a burst of queries.
    // Main loop drains via parser_response_count + _byte_at + _clear
    // after each pump tick, writes the bytes to the PTY master.
    response: Int
    // Side-array for OSC dispatch (window title etc.).
    //   slot 0: pending flag (0 = no, 1 = ready for caller dispatch)
    //   slot 1: parsed OSC code (the N in `OSC N ; <payload> ST`)
    //   slot 2: payload byte count
    //   slot 3..osc_cap()+2: payload bytes (after the `N;` prefix)
    osc: Int

fn response_cap() -> Int
    64

// Payload bytes one OSC may carry.  Sized for OSC 52, the clipboard
// set: its payload is base64, so N bytes here carry 3N/4 bytes of
// text, and 8192 is a ~6 KB selection — a screenful of a copy-mode
// yank rather than the 384 bytes a 512-byte accumulator allowed.
// Window titles, the other user of this buffer, never come close.
//
// The cost is one i64 per byte per Parser, so this buffer is 64 KB
// and a Parser is a little over that.  novomux allocates one per
// pane; ten panes is 640 KB, which is the trade this size is.  Bytes
// past the cap are dropped, silently — the append below has no way to
// report, and an OSC that overflows is the application's to keep
// under the terminal's advertised limit.
fn osc_cap() -> Int
    8192

fn parser_new() -> Parser [io, ffi]
    let h = array_i64_alloc_h(slots_total())
    let resp = array_i64_alloc_h(response_cap() + 1)
    array_i64_set_h(resp, 0, 0)
    let osc = array_i64_alloc_h(osc_cap() + 3)
    array_i64_set_h(osc, 0, 0)   // not pending
    array_i64_set_h(osc, 1, 0)   // code
    array_i64_set_h(osc, 2, 0)   // payload len
    Parser { slots: h, response: resp, osc: osc }

fn parser_drop(p: Parser) [io, ffi]
    array_i64_drop_h(p.slots)
    array_i64_drop_h(p.response)
    array_i64_drop_h(p.osc)

// ── OSC dispatch accessors ─────────────────────────────────────

fn parser_osc_pending(p: Parser) -> Bool [io, ffi]
    array_i64_get_h(p.osc, 0) == 1

fn parser_osc_code(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.osc, 1)

fn parser_osc_payload_len(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.osc, 2)

fn parser_osc_payload_byte(p: Parser, i: Int) -> Int [io, ffi]
    array_i64_get_h(p.osc, 3 + i)

fn parser_osc_clear(p: Parser) [io, ffi]
    array_i64_set_h(p.osc, 0, 0)
    array_i64_set_h(p.osc, 1, 0)
    array_i64_set_h(p.osc, 2, 0)

// Push one byte into the in-progress OSC payload accumulator.
// Cap-bounded; bytes past the limit are dropped (rare for window
// titles, accept for the corner-case longer payloads).
fn osc_accum_append(p: Parser, b: Int) [io, ffi]
    let n = array_i64_get_h(p.osc, 2)
    if n < osc_cap()
        array_i64_set_h(p.osc, 3 + n, b)
        array_i64_set_h(p.osc, 2, n + 1)

fn osc_accum_reset(p: Parser) [io, ffi]
    array_i64_set_h(p.osc, 2, 0)
    array_i64_set_h(p.osc, 1, 0)

// Finalise the in-progress OSC: parse the leading `N ;` prefix
// into the code field, shift the payload bytes left to drop the
// prefix, and set the pending flag for the caller to dispatch.
// Called when feed_osc_string sees BEL or ST.  Robust on
// malformed OSCs (no digits, no ';') — code stays 0, payload
// is the whole raw payload; main.nv ignores unrecognised codes.
fn osc_accum_finalise(p: Parser) [io, ffi]
    let n = array_i64_get_h(p.osc, 2)
    // Parse the leading digits as the OSC code.
    var code = 0
    var i = 0
    var has_digit = false
    var scanning = true
    while scanning and i < n
        let b = array_i64_get_h(p.osc, 3 + i)
        if b >= 48 and b <= 57
            code = code * 10 + (b - 48)
            has_digit = true
            i = i + 1
        else
            scanning = false
    if has_digit
        array_i64_set_h(p.osc, 1, code)
    // Skip the ';' separator if present.
    let skip = if i < n and array_i64_get_h(p.osc, 3 + i) == 59
        i + 1
    else
        i
    // Shift payload bytes left to drop the leading `N;` prefix.
    let new_len = n - skip
    var j = 0
    while j < new_len
        let b = array_i64_get_h(p.osc, 3 + skip + j)
        array_i64_set_h(p.osc, 3 + j, b)
        j = j + 1
    array_i64_set_h(p.osc, 2, new_len)
    array_i64_set_h(p.osc, 0, 1)   // pending

// ── Response queue accessors ───────────────────────────────────

fn parser_response_count(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.response, 0)

fn parser_response_byte_at(p: Parser, i: Int) -> Int [io, ffi]
    array_i64_get_h(p.response, 1 + i)

fn parser_response_clear(p: Parser) [io, ffi]
    array_i64_set_h(p.response, 0, 0)

fn response_append_byte(p: Parser, b: Int) [io, ffi]
    let n = parser_response_count(p)
    if n < response_cap()
        array_i64_set_h(p.response, 1 + n, b)
        array_i64_set_h(p.response, 0, n + 1)

fn response_append_str(p: Parser, s: Str) [io, ffi]
    let n = str.len(s)
    var i = 0
    while i < n
        response_append_byte(p, str.byte_at(s, i) ?? 0)
        i = i + 1

// Convenience getters used by tests + the grid renderer.

fn parser_state(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.slots, slot_state())

fn parser_param_count(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.slots, slot_param_count())

// Read param `i`, defaulting to `default` when the parser only saw
// an empty position (e.g. CSI ;5H has param 0 missing → default).
fn parser_param(p: Parser, i: Int, default: Int) -> Int [io, ffi]
    let count = parser_param_count(p)
    if i >= count
        default
    else
        let raw = array_i64_get_h(p.slots, slot_params_base() + i)
        // We sentinel "missing" as -1 inside the slot.
        if raw < 0
            default
        else
            raw

// ── Internal helpers ───────────────────────────────────────────

fn reset_csi(p: Parser) [io, ffi]
    array_i64_set_h(p.slots, slot_param_count(), 0)
    array_i64_set_h(p.slots, slot_current_param(), 0)
    array_i64_set_h(p.slots, slot_has_current(), 0)
    array_i64_set_h(p.slots, slot_intermediate(), 0)
    // Pre-seed param slots with -1 (missing) so parser_param's
    // default-fallback fires correctly for omitted positions.
    for i in 0 .. max_params()
        array_i64_set_h(p.slots, slot_params_base() + i, -1)

fn set_state(p: Parser, s: Int) [io, ffi]
    array_i64_set_h(p.slots, slot_state(), s)

fn flush_current_param(p: Parser) [io, ffi]
    if array_i64_get_h(p.slots, slot_has_current()) == 1
        let cnt = array_i64_get_h(p.slots, slot_param_count())
        if cnt < max_params()
            let cur = array_i64_get_h(p.slots, slot_current_param())
            array_i64_set_h(p.slots, slot_params_base() + cnt, cur)
            array_i64_set_h(p.slots, slot_param_count(), cnt + 1)
        array_i64_set_h(p.slots, slot_current_param(), 0)
        array_i64_set_h(p.slots, slot_has_current(), 0)

fn open_empty_param_slot(p: Parser) [io, ffi]
    // For "CSI 1;;3 m" the middle slot is empty; we represent it as
    // -1 so parser_param falls back to its caller-supplied default.
    let cnt = array_i64_get_h(p.slots, slot_param_count())
    if cnt < max_params()
        array_i64_set_h(p.slots, slot_params_base() + cnt, -1)
        array_i64_set_h(p.slots, slot_param_count(), cnt + 1)

// ── CSI handlers ───────────────────────────────────────────────

// 'c' (0x63) = DA — Device Attributes query.  Reply on the response
// queue; the main loop ships it to the PTY master.  nvim sends this at
// startup and waits ~1 s for the reply before falling back to slow
// timeouts.  Primary (`\e[c`) → VT220+colors; secondary (`\e[>c`,
// intermediate '>') → version.
fn csi_da(p: Parser, g: Grid) -> Grid [io, ffi]
    let intm = array_i64_get_h(p.slots, slot_intermediate())
    if intm == 62
        // CSI > c — secondary DA.  Format: ESC [ > Pp ; Pv ; Pc c
        // Pp = terminal type (0 = VT100), Pv = version, Pc = patch.
        response_append_str(p, str.from_char(27) + "[>0;1;0c")
    else
        // CSI c — primary DA.  62 = VT220, 22 = ANSI colors; 62;22 tells
        // nvim "modern terminal, use short timeouts".
        response_append_str(p, str.from_char(27) + "[?62;22c")
    g

// 'n' (0x6E) = DSR — Device Status Report.
//   `\e[5n` → reply `\e[0n` (terminal OK)
//   `\e[6n` → reply `\e[<row>;<col>R` (1-indexed cursor pos)
fn csi_dsr(p: Parser, g: Grid) -> Grid [io, ffi]
    let mode = parser_param(p, 0, 0)
    if mode == 5
        response_append_str(p, str.from_char(27) + "[0n")
    else if mode == 6
        let row = grid.grid_cursor_row(g) + 1
        let col = grid.grid_cursor_col(g) + 1
        response_append_str(p,
      str.from_char(27) + "[" + str.from_int(row) + ";"
            + str.from_int(col) + "R")
    g

// 'r' (0x72) = DECSTBM — set top/bottom margins (scroll region).
// Params are 1-indexed inclusive.  No params = full grid; first param
// missing or 1 = top of grid; second omitted = bottom of grid.
fn csi_set_scroll_region(p: Parser, g: Grid) -> Grid [io, ffi]
    let top = parser_param(p, 0, 1) - 1
    let bot = parser_param(p, 1, g.rows) - 1
    grid.grid_set_scroll_region(g, top, bot)

// 'q' (0x71) with SPACE intermediate = DECSCUSR (set cursor style).
// vim / nvim send this on mode change so the cursor shape mirrors the
// mode (block normal, bar insert, underline replace).  Without the SP
// intermediate it's a different, less-used CSI we ignore.
fn csi_set_cursor_style(p: Parser, g: Grid) -> Grid [io, ffi]
    let intm = array_i64_get_h(p.slots, slot_intermediate())
    if intm == 32
        // Latch dirty so a re-emitting host (novomux) forwards the new
        // shape this frame — even when the value matches the current one
        // (vim re-asserts block 2 on every return to normal).
        grid.grid_mark_cursor_shape_dirty(
      grid.grid_set_cursor_shape(g, parser_param(p, 0, 0)))
    else
        g

fn dispatch_csi(p: Parser, g: Grid, final_byte: Int) -> Grid [io, ffi]
    flush_current_param(p)
    // DEC private-mode dispatch — `\e[?Nh` (DECSET) and `\e[?Nl`
    // (DECRST).  The '?' intermediate (63) was recorded by
    // feed_csi_param; dispatch_private_mode decides which modes are
    // acted on and drops the rest.
    let intermediate = array_i64_get_h(p.slots, slot_intermediate())
    if intermediate == 63 and (final_byte == 104 or final_byte == 108)
        dispatch_private_mode(p, g, final_byte == 104)
    // 'A' (0x41) = CUU — cursor up
    else if final_byte == 65
        grid.grid_cursor_move(g, 0 - parser_param(p, 0, 1), 0)
    // 'B' (0x42) = CUD — cursor down
    else if final_byte == 66
        grid.grid_cursor_move(g, parser_param(p, 0, 1), 0)
    // 'C' (0x43) = CUF — cursor forward
    else if final_byte == 67
        grid.grid_cursor_move(g, 0, parser_param(p, 0, 1))
    // 'D' (0x44) = CUB — cursor backward
    else if final_byte == 68
        grid.grid_cursor_move(g, 0, 0 - parser_param(p, 0, 1))
    // 'H' (0x48) and 'f' (0x66) = CUP / HVP — absolute set.
    // Params are 1-indexed; convert to 0-indexed for the grid.
    else if final_byte == 72 or final_byte == 102
        let row = parser_param(p, 0, 1) - 1
        let col = parser_param(p, 1, 1) - 1
        grid.grid_cursor_set(g, row, col)
    // 'J' (0x4A) = ED — erase in display
    else if final_byte == 74
        grid.grid_erase_display(g, parser_param(p, 0, 0))
    // 'K' (0x4B) = EL — erase in line
    else if final_byte == 75
        grid.grid_erase_line(g, parser_param(p, 0, 0))
    // 'L' (0x4C) = IL — insert N lines (default 1)
    else if final_byte == 76
        grid.grid_insert_lines(g, parser_param(p, 0, 1))
    // 'M' (0x4D) = DL — delete N lines (default 1)
    else if final_byte == 77
        grid.grid_delete_lines(g, parser_param(p, 0, 1))
    // '@' (0x40) = ICH — insert N blank chars (default 1)
    else if final_byte == 64
        grid.grid_insert_chars(g, parser_param(p, 0, 1))
    // 'P' (0x50) = DCH — delete N chars (default 1)
    else if final_byte == 80
        grid.grid_delete_chars(g, parser_param(p, 0, 1))
    // 'X' (0x58) = ECH — erase N chars in place (default 1).
    // Pane-aware clear: writes blanks without moving cursor and
    // without extending past the requested count.
    else if final_byte == 88
        grid.grid_erase_chars(g, parser_param(p, 0, 1))
    // 'd' (0x64) = VPA — vertical position absolute (1-indexed)
    else if final_byte == 100
        grid.grid_cursor_set(g, parser_param(p, 0, 1) - 1, g.cursor_col)
    // 'G' (0x47) = CHA — cursor horizontal absolute (1-indexed)
    else if final_byte == 71
        grid.grid_cursor_set(g, g.cursor_row, parser_param(p, 0, 1) - 1)
    // '`' (0x60) = HPA — horizontal position absolute (same as CHA)
    else if final_byte == 96
        grid.grid_cursor_set(g, g.cursor_row, parser_param(p, 0, 1) - 1)
    // 'a' (0x61) = HPR — horizontal position relative (right N)
    else if final_byte == 97
        grid.grid_cursor_move(g, 0, parser_param(p, 0, 1))
    // 'e' (0x65) = VPR — vertical position relative (down N)
    else if final_byte == 101
        grid.grid_cursor_move(g, parser_param(p, 0, 1), 0)
    // 'E' (0x45) = CNL — cursor next line (col=0, row+N)
    else if final_byte == 69
        grid.grid_cursor_set(g, g.cursor_row + parser_param(p, 0, 1), 0)
    // 'F' (0x46) = CPL — cursor previous line (col=0, row-N)
    else if final_byte == 70
        grid.grid_cursor_set(g, g.cursor_row - parser_param(p, 0, 1), 0)
    // 'S' (0x53) = SU — scroll up N (default 1)
    else if final_byte == 83
        grid.grid_scroll_region_up(g, parser_param(p, 0, 1))
    // 'T' (0x54) = SD — scroll down N (default 1)
    else if final_byte == 84
        grid.grid_scroll_region_down(g, parser_param(p, 0, 1))
    // 'c' (0x63) = DA — Device Attributes query (see csi_da)
    else if final_byte == 99
        csi_da(p, g)
    // 'n' (0x6E) = DSR — Device Status Report (see csi_dsr)
    else if final_byte == 110
        csi_dsr(p, g)
    // 'r' (0x72) = DECSTBM — set scroll region (see csi_set_scroll_region)
    else if final_byte == 114
        csi_set_scroll_region(p, g)
    // 'm' (0x6D) = SGR — set graphic rendition
    else if final_byte == 109
        dispatch_sgr(p, g)
    // 'q' (0x71) SP = DECSCUSR — set cursor style (see csi_set_cursor_style)
    else if final_byte == 113
        csi_set_cursor_style(p, g)
    else
        g

// DEC private mode set/reset.  `set` is true for DECSET (`h`),
// false for DECRST (`l`).  Param 0 carries the mode number.
//
// Modes acted on: 7 (DECAWM), 25 (DECTCEM), 47 / 1047 / 1049
// (alt screen), 1000 / 1002 / 1003 / 1006 (mouse tracking) and
// 2004 (bracketed paste).  Anything else falls through the final
// `else` and is discarded, which is the correct response for an
// unimplemented private mode: silently ignore rather than emit.
//
// The alt-screen family collapses to one path — `?47` never saved
// the cursor and `?1047` did not either before xterm 251, while
// `?1049` is defined as save + switch + clear.  All three take the
// save+switch+clear path.
fn dispatch_private_mode(p: Parser, g: Grid, set: Bool) -> Grid [io, ffi]
    let n = parser_param(p, 0, 0)
    if n == 47 or n == 1047 or n == 1049
        if set
            grid.grid_enter_alt_screen(g)
        else
            grid.grid_exit_alt_screen(g)
    // DECAWM (n=7): auto-wrap mode.  nvim toggles this around line-
    // numbered gutter writes / status-line draws — without honoring
    // it, our cursor lands on the next row instead of pegging at
    // the right margin, displacing every subsequent line.
    else if n == 7
        grid.grid_set_autowrap(g, set)
    // Bracketed paste (n=2004): apps that opt in want pasted bytes
    // wrapped in ESC[200~ … ESC[201~ envelopes so they can
    // distinguish paste-as-bulk from per-byte typing — nvim uses
    // it to suspend indentexpr/abbrev expansion during paste; zsh
    // / fish use it to colour pasted text differently and avoid
    // accidentally running multi-line pastes.  The wrap itself
    // lives in the render.nv paste handler; here we just track
    // the flag.
    else if n == 2004
        grid.grid_set_bracketed_paste(g, set)
    // Mouse tracking modes — flip individual bits in the grid's
    // mouse_mode bitmask.  render.nv's mouse handlers check it
    // and forward CSI sequences to the PTY when set (instead of
    // doing local selection).
    //   1000: report click press events only
    //   1002: report click + release + motion-while-pressed
    //   1003: report any motion (even without a button held)
    //   1006: SGR encoding format (preferred over the legacy
    //         byte-position encoding which can't represent col/row
    //         > 223)
    else if n == 1000
        if set
            grid.grid_mouse_mode_bit_on(g, 1)
        else
            grid.grid_mouse_mode_bit_off(g, 1)
    else if n == 1002
        if set
            grid.grid_mouse_mode_bit_on(g, 2)
        else
            grid.grid_mouse_mode_bit_off(g, 2)
    else if n == 1003
        if set
            grid.grid_mouse_mode_bit_on(g, 4)
        else
            grid.grid_mouse_mode_bit_off(g, 4)
    else if n == 1006
        if set
            grid.grid_mouse_mode_bit_on(g, 8)
        else
            grid.grid_mouse_mode_bit_off(g, 8)
    // DECTCEM (n=25): cursor visibility.  Apps hide the cursor
    // (`?25l`) around a repaint and show it again (`?25h`) once the
    // frame settles — nvim does this on every redraw.  Track it so
    // the novomux renderer can keep the host cursor hidden mid-paint
    // instead of flashing it at each intermediate position.
    else if n == 25
        grid.grid_set_cursor_visible(g, set)
    else
        g

fn dispatch_sgr(p: Parser, g: Grid) -> Grid [io, ffi]
    // Walk params; each interpreted independently EXCEPT the
    // 38/48 compound forms which consume trailing params:
    //   38;5;N         — 256-color fg, eats 2 extra params
    //   38;2;R;G;B     — truecolor fg, eats 4 extra params
    //   48;5;N / 48;2;R;G;B — same shape for bg
    // Without this skip the trailing R;G;B values land on
    // 30..37 / 40..47 accidentally and set the wrong color.
    // Both forms are stored at full 24-bit fidelity; nothing is
    // quantised on the way into a cell.
    let count = parser_param_count(p)
    if count == 0
        grid.grid_sgr_reset(g)
    else
        var g_acc = g
        var i = 0
        while i < count
            let v = parser_param(p, i, 0)
            if v == 38 or v == 48
                // Sub-form selector lives in the next param.
                let is_fg = v == 38
                let mode = parser_param(p, i + 1, 0)
                if mode == 5 and i + 2 < count
                    let n = parser_param(p, i + 2, 0)
                    g_acc = apply_256_color(g_acc, is_fg, n)
                    i = i + 3
                else if mode == 2 and i + 4 < count
                    let r = parser_param(p, i + 2, 0)
                    let g_ch = parser_param(p, i + 3, 0)
                    let b = parser_param(p, i + 4, 0)
                    g_acc = apply_truecolor(g_acc, is_fg, r, g_ch, b)
                    i = i + 5
                else
                    // Malformed — skip just the 38/48 and let the walker
                    // pick up whatever follows.
                    i = i + 1
            else
                g_acc = apply_sgr_one(g_acc, v)
                i = i + 1
        g_acc

// Indexed SGR color (`\e[38;5;Nm` / `\e[48;5;Nm`).  N is clamped into
// 0..255 rather than rejected, because a malformed index should still
// paint something.
fn apply_256_color(g: Grid, is_fg: Bool, n: Int) -> Grid [io, ffi]
    let c = if n < 0
        0
    else if n > 255
        255
    else
        n
    // Resolve the index to RGB here, against the C-side session
    // palette, so the cell stores RGB.  The consequence is that a
    // later palette change does not recolour already-painted cells.
    let rgb = novo_term_palette_lookup_h(c)
    if is_fg
        grid.grid_set_fg(g, rgb)
    else
        grid.grid_set_bg(g, rgb)

// ECMA-48 direct color (`\e[38;2;R;G;Bm`): the full 24 bits reach the
// cell, with no quantisation to the 6×6×6 cube.  Packed as
// r<<16 | g<<8 | b, each channel masked to 8 bits.
fn apply_truecolor(g: Grid, is_fg: Bool, r: Int, gc: Int, b: Int) -> Grid
    let rgb = bits.bor(
              bits.bor(int.shl(bits.band(r, 255), 16),
                          int.shl(bits.band(gc, 255), 8)),
              bits.band(b, 255))
    if is_fg
        grid.grid_set_fg(g, rgb)
    else
        grid.grid_set_bg(g, rgb)

// Look up an indexed color via the C-side session palette
// (set at renderer startup with config.config_palette + xterm-
// derived 16-231 cube + 232-255 grayscale ramp defaults for
// 16-255).
@ffi("novo_term_palette_lookup")
fn novo_term_palette_lookup_h(idx: Int) -> Int [io, ffi]

@ffi("novo_term_default_fg_get")
fn novo_term_default_fg_get_h() -> Int [io, ffi]

@ffi("novo_term_default_bg_get")
fn novo_term_default_bg_get_h() -> Int [io, ffi]

// One SGR parameter.
//
// The attribute model is ECMA-48 §8.3.117: each graphic rendition is
// an INDEPENDENT switch, so a set touches one bit and a reset clears
// the one bit it names.  `CSI 1;4m` ends bold AND underlined; `CSI
// 24m` after `CSI 1;7m` drops underline and leaves bold and reverse
// standing.  Only SGR 0 clears the whole mask, and it goes through
// grid_sgr_reset because it restores the runtime default colours too.
fn apply_sgr_one(g: Grid, v: Int) -> Grid [io, ffi]
    if v == 0
        grid.grid_sgr_reset(g)
    else if v == 1
        grid.grid_add_attr(g, grid.attr_bold())
    else if v == 3
        grid.grid_add_attr(g, grid.attr_italic())
    else if v == 4
        grid.grid_add_attr(g, grid.attr_underline())
    else if v == 7
        grid.grid_add_attr(g, grid.attr_reverse())
    else if v == 9
        grid.grid_add_attr(g, grid.attr_strike())
    else if v == 22
        grid.grid_clear_attr(g, grid.attr_bold())
    else if v == 23
        grid.grid_clear_attr(g, grid.attr_italic())
    else if v == 24
        grid.grid_clear_attr(g, grid.attr_underline())
    else if v == 27
        grid.grid_clear_attr(g, grid.attr_reverse())
    else if v == 29
        grid.grid_clear_attr(g, grid.attr_strike())
    else if v >= 30 and v <= 37
        grid.grid_set_fg(g, novo_term_palette_lookup_h(v - 30))
    else if v >= 90 and v <= 97
        grid.grid_set_fg(g, novo_term_palette_lookup_h(v - 90 + 8))
    else if v == 39
        // SGR 39: return-to-default fg.  Read the runtime default
        // (mutable via OSC 10) instead of the compile-time constant.
        grid.grid_set_fg(g, novo_term_default_fg_get_h())
    else if v >= 40 and v <= 47
        grid.grid_set_bg(g, novo_term_palette_lookup_h(v - 40))
    else if v >= 100 and v <= 107
        grid.grid_set_bg(g, novo_term_palette_lookup_h(v - 100 + 8))
    else if v == 49
        // SGR 49: return-to-default bg.  Same OSC-11-aware lookup.
        grid.grid_set_bg(g, novo_term_default_bg_get_h())
    else
        g

// ── Top-level dispatch ─────────────────────────────────────────

// Feed one byte through the parser.  Returns the updated Grid;
// the Parser's mutable state lives in its `slots` array so the
// caller doesn't need to rebind it.
fn parser_feed_byte(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    let st = parser_state(p)
    if st == st_ground()
        feed_ground(p, g, b)
    else if st == st_esc()
        feed_esc(p, g, b)
    else if st == st_csi_param()
        feed_csi_param(p, g, b)
    else if st == st_osc_string()
        feed_osc_string(p, g, b)
    else if st == st_utf8_cont()
        feed_utf8_cont(p, g, b)
    else if st == st_dcs_string()
        feed_dcs_string(p, g, b)
    else
        g

// UTF-8 lead-byte detection.
//
// 0xxxxxxx → ASCII (1 byte, codepoint = byte).
// 110xxxxx → 2-byte sequence (lead carries low 5 bits of cp,
//             1 continuation needed).
// 1110xxxx → 3-byte sequence (lead carries low 4 bits, 2 conts).
// 11110xxx → 4-byte sequence (lead carries low 3 bits, 3 conts).
// 10xxxxxx → orphan continuation byte (drop).
// 11111xxx → invalid (drop).
//
// Continuation bytes (10xxxxxx) carry 6 bits each.  Accumulator
// holds the running codepoint; we shift-left 6 and OR in the
// continuation's low 6 bits per byte.

fn utf8_lead_class(b: Int) -> Int
    // Returns the number of continuation bytes remaining, or -1 for
    // "not a valid lead byte" (orphan continuation / invalid).
    if b < 128   // 0xxxxxxx — ASCII
        0
    else if b < 192   // 10xxxxxx — orphan cont
        -1
    else if b < 224   // 110xxxxx — 2-byte
        1
    else if b < 240   // 1110xxxx — 3-byte
        2
    else if b < 248   // 11110xxx — 4-byte
        3
    else   // 11111xxx — invalid
        -1

fn utf8_lead_payload(b: Int, n_remaining: Int) -> Int
    // Low bits of the lead byte that contribute to the codepoint.
    if n_remaining == 0   // ASCII
        b
    else if n_remaining == 1   // 2-byte lead: 5 low bits
        b - 192
    else if n_remaining == 2   // 3-byte lead: 4 low bits
        b - 224
    else   // 4-byte lead: 3 low bits
        b - 240

fn feed_ground(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    if b == 27   // ESC
        set_state(p, st_esc())
        g
    else if b == 8   // BS
        grid.grid_backspace(g)
    else if b == 9   // HT
        grid.grid_tab(g)
    else if b == 10   // LF
        grid.grid_line_feed(g)
    else if b == 13   // CR
        grid.grid_carriage_return(g)
    else if b == 7   // BEL — ignored
        g
    else if b >= 32 and b < 127   // printable ASCII
        grid.grid_put_char(g, b)
    else if b >= 128   // possible UTF-8 lead
        let n_cont = utf8_lead_class(b)
        if n_cont < 0
            g   // orphan/invalid — drop
        else if n_cont == 0
            g   // (unreachable: b < 128 above)
        else
            array_i64_set_h(p.slots, slot_utf8_acc(), utf8_lead_payload(b, n_cont))
            array_i64_set_h(p.slots, slot_utf8_remaining(), n_cont)
            set_state(p, st_utf8_cont())
            g
    else
        g   // other C0 controls dropped

// Continuation-byte state.  Each valid continuation (10xxxxxx)
// contributes 6 bits.  When remaining hits 0, emit the codepoint
// and return to ground.  An invalid continuation aborts the
// sequence (drop accumulated bytes) and re-feeds the new byte
// from ground state — typical xterm-style recovery.
fn feed_utf8_cont(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    if b < 128 or b >= 192   // not a continuation byte
        // Abort the partial sequence + re-process the byte from
        // ground.  The accumulator's contents are discarded.
        set_state(p, st_ground())
        parser_feed_byte(p, g, b)
    else
        let acc = array_i64_get_h(p.slots, slot_utf8_acc())
        let new_acc = int.shl(acc, 6) + (b - 128)
        let remaining = array_i64_get_h(p.slots, slot_utf8_remaining()) - 1
        if remaining == 0
            set_state(p, st_ground())
            grid.grid_put_char(g, new_acc)
        else
            array_i64_set_h(p.slots, slot_utf8_acc(), new_acc)
            array_i64_set_h(p.slots, slot_utf8_remaining(), remaining)
            g

fn feed_esc(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    if b == 91   // '['
        reset_csi(p)
        set_state(p, st_csi_param())
        g
    else if b == 93   // ']'
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        osc_accum_reset(p)
        set_state(p, st_osc_string())
        g
    // ESC P — DCS (Device Control String) introducer.  Consume the
    // payload until BEL (0x07) or ST (ESC \) without interpreting
    // it.  nvim sends DCS for terminfo capability queries on
    // startup (DECRQSS / XTGETTCAP) — dropping them silently like
    // OSC keeps the payload bytes from leaking through as printable
    // text + parasitic CSI parses.  Pre-fix users saw stray `[N0!`
    // / random fragments + missing lines from the queries getting
    // re-interpreted in ground state.
    else if b == 80   // 'P' — DCS
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        set_state(p, st_dcs_string())
        g
    // ESC X — SOS (Start Of String), ESC ^ — PM (Privacy Message),
    // ESC _ — APC (Application Program Command).  All three are
    // ST-terminated string sequences with the same shape as DCS;
    // reuse the same consumer so unknown ones drop silently
    // instead of leaking payload bytes.
    else if b == 88 or b == 94 or b == 95   // 'X' / '^' / '_'
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        set_state(p, st_dcs_string())
        g
    else if b == 40   // '(' — designate G0
        // Consume the next byte too.  Cheap hack: stash a marker in
        // the intermediate slot and stay in ESC state for one more
        // byte.  Implemented as a tiny inline state.
        array_i64_set_h(p.slots, slot_intermediate(), 40)
        g
    else if array_i64_get_h(p.slots, slot_intermediate()) == 40
        // Charset byte after ESC ( — consumed and ignored.
        array_i64_set_h(p.slots, slot_intermediate(), 0)
        set_state(p, st_ground())
        g
    else if b == 55   // ESC 7 — DECSC
        set_state(p, st_ground())
        grid.grid_decsc(g)
    else if b == 56   // ESC 8 — DECRC
        set_state(p, st_ground())
        grid.grid_decrc(g)
    // ESC D — IND (index): cursor down one line; if already at
    // the bottom of the scroll region, scroll the region up so
    // the cursor stays at the bottom edge.  nvim emits this when
    // moving the cursor past the bottom of the viewport instead
    // of using CSI B + CSI S — dropping it left nvim's redraw
    // landing the new line on the OLD row, producing the user-
    // visible "line below appears at cursor row" duplication.
    else if b == 68   // 'D' — IND
        set_state(p, st_ground())
        let bot = grid.grid_region_bottom(g)
        if g.cursor_row >= bot
            grid.grid_scroll_region_up(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row + 1, g.cursor_col)
    // ESC E — NEL (next line): CR + LF.  Move cursor to column 0
    // and down one line, scrolling if needed.  Same scroll-aware
    // semantics as IND.
    else if b == 69   // 'E' — NEL
        set_state(p, st_ground())
        let bot = grid.grid_region_bottom(g)
        let g2 = if g.cursor_row >= bot
            grid.grid_scroll_region_up(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row + 1, 0)
        grid.grid_cursor_set(g2, g2.cursor_row, 0)
    // ESC M — RI (reverse index): cursor up one line; if already
    // at the TOP of the scroll region, scroll the region DOWN so
    // the cursor stays at the top edge.  nvim emits this on
    // reverse scroll (Ctrl+Y / cursor up at top).
    else if b == 77   // 'M' — RI
        set_state(p, st_ground())
        let top = grid.grid_region_top(g)
        if g.cursor_row <= top
            grid.grid_scroll_region_down(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row - 1, g.cursor_col)
    else
        // ESC = (DECPAM), ESC > (DECPNM), ESC c (RIS — full reset)
        // and every other ESC final: dropped.  Return to ground so the
        // following byte is read as text rather than as a continuation.
        set_state(p, st_ground())
        g

fn feed_csi_param(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    if b >= 48 and b <= 57   // digit
        let cur = array_i64_get_h(p.slots, slot_current_param())
        array_i64_set_h(p.slots, slot_current_param(), cur * 10 + (b - 48))
        array_i64_set_h(p.slots, slot_has_current(), 1)
        g
    else if b == 59   // ';' — param separator
        if array_i64_get_h(p.slots, slot_has_current()) == 1
            flush_current_param(p)
        else
            open_empty_param_slot(p)
        g
    else if b == 63 or b == 60 or b == 61 or b == 62
        // Intermediates '?' '<' '=' '>' — record once, keep going.
        array_i64_set_h(p.slots, slot_intermediate(), b)
        g
    else if b == 32
        // Space — intermediate for DECSCUSR (`CSI Ps SP q`) and a
        // few other "extended" CSI shapes (DECSCL etc.).  Record
        // so dispatch_csi can branch on it at the final byte.
        array_i64_set_h(p.slots, slot_intermediate(), b)
        g
    else if b >= 64 and b <= 126   // final byte — dispatch
        let g2 = dispatch_csi(p, g, b)
        set_state(p, st_ground())
        g2
    else
        g

fn feed_osc_string(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    // OSC payload runs until BEL (0x07) or ST (ESC \).  Payload bytes
    // accumulate and are finalised on the terminator, so the caller's
    // pump can dispatch OSC 0/1/2 (window title) to the window system.
    // Unknown OSC codes accumulate too and are the caller's to drop —
    // this module never interprets an OSC payload itself.
    if b == 7
        osc_accum_finalise(p)
        set_state(p, st_ground())
        g
    else if b == 27   // ESC — wait for '\'
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 1)
        g
    else if array_i64_get_h(p.slots, slot_osc_saw_esc()) == 1 and b == 92
        // ESC \ — String Terminator
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        osc_accum_finalise(p)
        set_state(p, st_ground())
        g
    else
        // A regular payload byte.  Clear the saw-ESC flag (in case
        // a stray ESC was followed by a non-'\' byte — xterm
        // semantics drop the ESC and continue) and accumulate.
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        osc_accum_append(p, b)
        g

// DCS / SOS / PM / APC consumer.  Same terminator handling as
// feed_osc_string (BEL or ESC \), same slot reused for the
// "saw an intermediate ESC" flag.  Payload is dropped — we
// don't implement sixel, ReGIS, terminfo-query replies, or
// the other consumers; the goal is just to NOT let payload
// bytes leak through to ground state.
fn feed_dcs_string(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    if b == 7
        set_state(p, st_ground())
        g
    else if b == 27
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 1)
        g
    else if array_i64_get_h(p.slots, slot_osc_saw_esc()) == 1 and b == 92
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        set_state(p, st_ground())
        g
    else
        array_i64_set_h(p.slots, slot_osc_saw_esc(), 0)
        g
