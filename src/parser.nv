// parser.nv — what a terminal does about an escape sequence.
//
// The sequences themselves are read by `ansi-nv`: its `vtparse` is the
// state machine, `feed` answers the parser after one byte, and
// `action_of` says what that byte asked for.  This module is the other
// half — the map from an action to an operation on a `Grid`, plus the
// two things a grid model owns that an escape-sequence package cannot:
// the replies a terminal owes the host for a device query, and the OSC
// payload it holds for its caller.
//
// WHAT IS ACTED ON — this list is the module's contract; each entry
// has a `dispatch_*` / `apply_*` arm below.
//
//   text     `AnsiPrint` puts one codepoint in one cell.
//   C0       BS, HT, LF and CR act; BEL and every other C0 byte are
//            dropped.
//   ESC      7 / 8 (DECSC / DECRC), D / E / M (IND / NEL / RI).
//   CSI      A B C D (CUU CUD CUF CUB), H f (CUP HVP), E F (CNL CPL),
//            G ` (CHA HPA), d (VPA), a e (HPR VPR), J K (ED EL),
//            L M (IL DL), @ P (ICH DCH), X (ECH), S T (SU SD),
//            r (DECSTBM), m (SGR), c (DA), n (DSR), q (DECSCUSR).
//   CSI ? h/l   7 (DECAWM), 25 (DECTCEM), 47 / 1047 / 1049
//            (alt screen), 1000 / 1002 / 1003 / 1006 (mouse
//            tracking), 2004 (bracketed paste).
//   OSC      accumulated into the `osc` side-array and handed to the
//            caller to dispatch; this module does not act on it.
//
// WHAT IS CONSUMED BUT NOT ACTED ON — deliberately:
//   - DCS, SOS, PM and APC strings (so no sixel, no ReGIS, no
//     DECRQSS / XTGETTCAP replies).
//   - The charset byte of `ESC ( <byte>` and its neighbours — output
//     is always ASCII / UTF-8, never a DEC line-drawing set.
//   - Every CSI final and private mode not listed above, plus
//     ESC = / ESC > (DECPAM / DECPNM) and ESC c (RIS).
//
// The three alt-screen modes are collapsed onto one path: `?47` never
// saved the cursor and `?1047` did not either before xterm 251, while
// `?1049` is defined as save + switch + clear.  All three take the
// save+switch+clear path here.
//
// State storage: the state machine is `vtcore.AnsiParser`, a value of
// seventy-two bytes over fixed-capacity buffers, and a `Parser` keeps
// it in a flat buffer of one.  Feeding a byte writes that buffer, so it
// changes the parser the caller is holding instead of handing back a
// new one, and it allocates nothing.  The two side-arrays hold what the
// state machine does not: the replies the terminal owes its host, and
// the OSC payload it holds for its caller.
//
// A parser in use.  It owns no output of its own: a byte goes in, a
// `Grid` comes back changed, and the caller decides what to draw.  The
// escape sequence below is `ESC [ 2 ; 1 H` — CUP, "put the cursor on
// row 2, column 1" — fed one byte at a time, exactly as it would arrive
// off a pty.
//
// ```novo
// use grid
// use parser
//
// fn main() [io, ffi]
//     var g = grid.grid_new(2, 3)
//     let p = parser.parser_new()
//     for b in [65, 27, 91, 50, 59, 49, 72, 66]   // A ESC [ 2 ; 1 H B
//         g = parser.parser_feed_byte(p, g, b)
//     print(grid.grid_to_string(g))
//     // @ 1,1      the cursor moved, and 'B' landed where it pointed
//     // A          row 0
//     // B          row 1
//     parser.parser_drop(p)
//     grid.grid_drop(g)
// ```

// Re-declare the std.array @ffi externs locally — sibling modules
// in pkg builds don't see the auto-prepended stdlib decls (same
// trick grid.nv uses).  Resolves to the same C symbols.

@ffi("novo_array_i64_alloc")
fn array_i64_alloc_h(capacity: Int) -> Int [io, ffi]

@ffi("novo_array_i64_get")
fn array_i64_get_h(h: Int, i: Int) -> Int [io, ffi]

@ffi("novo_array_i64_set")
fn array_i64_set_h(h: Int, i: Int, v: Int) [io, ffi]

@ffi("novo_array_i64_drop")
fn array_i64_drop_h(h: Int) [io, ffi]

use grid
use vtcore
use vtparse
use vtquery
use sgr

// ── Constants ───────────────────────────────────────────────────

// The state a parser rests in: the next byte is text, a C0 control or
// the ESC that starts a sequence.  `parser_state` returns one of these
// six codes.
pub fn st_ground() -> Int
    0
// ESC has arrived; the next byte selects the sequence — `[` for CSI,
// `]` for OSC, or a single-byte function such as `7` (DECSC).
pub fn st_esc() -> Int
    1
// Inside a CSI sequence, collecting its numeric parameters until the
// final byte arrives and dispatches it.
pub fn st_csi_param() -> Int
    2
// Inside an OSC string, accumulating its payload until BEL or ST.  The
// payload is handed to the caller through the `parser_osc_*` accessors
// rather than acted on here.
pub fn st_osc_string() -> Int
    3
// "In the middle of a multi-byte UTF-8 codepoint, waiting for
// continuation bytes."  A chunk boundary lands here whenever a read
// splits a character.
pub fn st_utf8_cont() -> Int
    4
// Inside a DCS, SOS, PM or APC string, consuming the payload to its
// terminator without interpreting it.
pub fn st_dcs_string() -> Int
    5

// The ceilings `vtparse` enforces, as a terminal emulator on a machine
// with memory wants them.  `osc_bytes_max` matches `osc_cap` so that
// the payload accumulator below and the parser stop at the same place.
// The parameter ceilings are the package's own capacity: sixteen
// entries, counting a colon group as one, and 65534 as the largest
// value a parameter may hold.  A field is stored at the width its range
// needs, so a value read out of one is cast on the way into an `Int`.
fn vte_limits() -> vtcore.AnsiLimits
    AnsiLimits { param_max: 65534, osc_bytes_max: osc_cap() as u32,
                 dcs_bytes_max: 4096, params_max: 16, subs_max: 6,
                 intermediates_max: 2 }

// ── Parser handle ───────────────────────────────────────────────

// One escape-sequence parser: the state machine, the queue of replies it
// owes the host, and the OSC payload it has accumulated.  It carries no
// screen of its own — `parser_feed_byte` takes the `Grid` to change —
// so one Parser belongs to one stream of bytes, and a multiplexer keeps
// one per pane.
//
// Two of the three fields are raw array handles, which is why a Parser
// is made with `parser_new` and released with `parser_drop` rather than
// built as a literal.
pub struct Parser
    // The escape-sequence state machine, in a buffer of one.  A
    // `@value` struct in a field of a boxed struct is one of the five
    // crossings SPEC § 14.5 names, and the store there copies it into a
    // cell — one cell per byte fed.  A `[V]` is one owned allocation
    // holding the value flat (§ 14.6), so a buffer of one is written
    // and read in place and the byte path allocates nothing for it.
    // The element type is named without the module prefix because a
    // module-qualified `@value` type is not recognised as the element
    // of a flat buffer on this toolchain (novo bug
    // types-values/module-qualified-value-type-refused-as-a-value-field);
    // the `use vtcore` line above is what makes the bare name resolve.
    ansi: [AnsiParser]
    // Side-array for response bytes queued in answer to host
    // probes (DA, CPR, DSR).  Slot 0
    // holds the count; slots 1..64 hold up to 64 reply bytes.  A
    // CPR/DA response is <16 bytes; 64 covers a burst of queries.
    // Main loop drains via parser_response_count + _byte_at + _clear
    // after each pump tick, writes the bytes to the PTY master.
    response: Int
    // Side-array for OSC dispatch (window title etc.).
    //   slot 0: pending flag (0 = no, 1 = ready for caller dispatch)
    //   slot 1: parsed OSC code (the N in `OSC N ; <payload> ST`)
    //   slot 2: payload byte count
    //   slot 3: refused flag (1 = the payload passed `osc_cap`)
    //   slot 4..osc_cap()+3: payload bytes (after the `N;` prefix)
    osc: Int

fn response_cap() -> Int
    64

// Payload bytes one OSC may carry.  Sized for OSC 52, the clipboard
// set: its payload is base64, so N bytes here carry 3N/4 bytes of
// text, and 8192 is a ~6 KB selection — a screenful of a copy-mode
// yank rather than the 384 bytes a 512-byte accumulator allowed.
// Window titles, the other user of this buffer, never come close.
//
// The cost is one i64 per byte per Parser, so this buffer is 64 KB
// and a Parser is a little over that.  novomux allocates one per
// pane; ten panes is 640 KB, which is the trade this size is.  A
// payload past the cap breaks `vte_limits`'s `osc_bytes_max`: the
// parser reports the refusal, drops the rest of the payload and fires
// `AnsiOscEnd` at the terminator, and the refusal is remembered here so
// the string is dropped whole rather than handed on cut short.
fn osc_cap() -> Int
    8192

// Allocate a parser in the ground state, with an empty reply queue and
// no OSC pending.  Release it with `parser_drop`; each one costs a
// little over 64 KB, almost all of it the OSC accumulator.
pub fn parser_new() -> Parser [io, ffi]
    let resp = array_i64_alloc_h(response_cap() + 1)
    array_i64_set_h(resp, 0, 0)
    let osc = array_i64_alloc_h(osc_cap() + 4)
    array_i64_set_h(osc, 0, 0)   // not pending
    array_i64_set_h(osc, 1, 0)   // code
    array_i64_set_h(osc, 2, 0)   // payload len
    array_i64_set_h(osc, 3, 0)   // not refused
    Parser { ansi: [vtparse.parser_with(vte_limits())], response: resp, osc: osc }

// Release the parser's two backing arrays.  The Grid it was feeding is
// separate and is dropped on its own.
pub fn parser_drop(p: Parser) [io, ffi]
    array_i64_drop_h(p.response)
    array_i64_drop_h(p.osc)

// ── OSC dispatch accessors ─────────────────────────────────────

// True when a complete OSC string is waiting to be dispatched.  This
// module never acts on an OSC — a window title, a clipboard write and a
// palette change are all the caller's to make — so the loop is: after
// each byte, ask; if pending, read the code and the payload, act, then
// `parser_osc_clear`.
//
// ```novo
// use grid
// use parser
//
// fn main() [io, ffi]
//     var g = grid.grid_new(2, 8)
//     let p = parser.parser_new()
//     // OSC 0 ; h i BEL — "set the window title to hi".
//     for b in [27, 93, 48, 59, 104, 105, 7]
//         g = parser.parser_feed_byte(p, g, b)
//     if parser.parser_osc_pending(p)
//         println("${parser.parser_osc_code(p)}")          // 0
//         println("${parser.parser_osc_payload_len(p)}")   // 2
//         parser.parser_osc_clear(p)
//     parser.parser_drop(p)
//     grid.grid_drop(g)
// ```
pub fn parser_osc_pending(p: Parser) -> Bool [io, ffi]
    array_i64_get_h(p.osc, 0) == 1

// The `N` of `OSC N ; <payload>`.  Zero when the string carried no
// leading digits, which is what an unrecognised OSC looks like to a
// caller that switches on the code.
pub fn parser_osc_code(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.osc, 1)

// Payload bytes held, after the `N ;` prefix has been dropped.
pub fn parser_osc_payload_len(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.osc, 2)

// Payload byte `i`, for `i` in [0, `parser_osc_payload_len`).
pub fn parser_osc_payload_byte(p: Parser, i: Int) -> Int [io, ffi]
    array_i64_get_h(p.osc, 4 + i)

// Mark the pending OSC handled.  The next one is reported on its own,
// so a caller that never clears sees only the first.
pub fn parser_osc_clear(p: Parser) [io, ffi]
    array_i64_set_h(p.osc, 0, 0)
    array_i64_set_h(p.osc, 1, 0)
    array_i64_set_h(p.osc, 2, 0)
    array_i64_set_h(p.osc, 3, 0)

// Push one byte into the in-progress OSC payload accumulator.
// Cap-bounded; the parser refuses the string at the same byte, so a
// payload that reaches the cap is dropped rather than truncated.
fn osc_accum_append(p: Parser, b: Int) [io, ffi]
    let n = array_i64_get_h(p.osc, 2)
    if n < osc_cap()
        array_i64_set_h(p.osc, 4 + n, b)
        array_i64_set_h(p.osc, 2, n + 1)

fn osc_accum_reset(p: Parser) [io, ffi]
    array_i64_set_h(p.osc, 2, 0)
    array_i64_set_h(p.osc, 1, 0)
    array_i64_set_h(p.osc, 3, 0)

// The payload passed `osc_bytes_max`.  The parser drops the rest of it
// and still reports the terminator, so the flag is what keeps the
// caller from being handed the first `osc_cap` bytes of a string whose
// remainder it never saw.
fn osc_accum_refuse(p: Parser) [io, ffi]
    array_i64_set_h(p.osc, 3, 1)

fn osc_accum_refused(p: Parser) -> Bool [io, ffi]
    array_i64_get_h(p.osc, 3) == 1

// True for the one fault that is read after the byte that raised it.
fn osc_too_long(why: vtparse.AnsiFault) -> Bool
    match why
        AnsiOscTooLong => true
        _              => false

// Finalise the in-progress OSC: parse the leading `N ;` prefix
// into the code field, shift the payload bytes left to drop the
// prefix, and set the pending flag for the caller to dispatch.
// Called on `AnsiOscEnd`.  Robust on malformed OSCs (no digits,
// no ';') — code stays 0, payload is the whole raw payload;
// main.nv ignores unrecognised codes.
//
// The scan is here rather than through `vtparse.osc_code` because the
// payload lives in the handle array the `parser_osc_payload_*`
// accessors read, not in a `[u8]`, and because this rule keeps the
// prefix when it is not digits followed by a semicolon.
fn osc_accum_finalise(p: Parser) [io, ffi]
    let n = array_i64_get_h(p.osc, 2)
    // Parse the leading digits as the OSC code.
    var code = 0
    var i = 0
    var has_digit = false
    var scanning = true
    while scanning and i < n
        let b = array_i64_get_h(p.osc, 4 + i)
        if b >= 48 and b <= 57
            code = code * 10 + (b - 48)
            has_digit = true
            i = i + 1
        else
            scanning = false
    if has_digit
        array_i64_set_h(p.osc, 1, code)
    // Skip the ';' separator if present.
    let skip = if i < n and array_i64_get_h(p.osc, 4 + i) == 59
        i + 1
    else
        i
    // Shift payload bytes left to drop the leading `N;` prefix.
    let new_len = n - skip
    var j = 0
    while j < new_len
        let b = array_i64_get_h(p.osc, 4 + skip + j)
        array_i64_set_h(p.osc, 4 + j, b)
        j = j + 1
    array_i64_set_h(p.osc, 2, new_len)
    array_i64_set_h(p.osc, 0, 1)   // pending

// ── Response queue accessors ───────────────────────────────────

// How many reply bytes the parser owes the host.  Device queries — DA,
// DA2, DSR, CPR — are answered by the terminal, so a pump that never
// drains this queue leaves an application waiting for an answer that
// never comes.
//
// ```novo
// use grid
// use parser
//
// fn main() [io, ffi]
//     var g = grid.grid_new(2, 8)
//     let p = parser.parser_new()
//     g = grid.grid_cursor_set(g, 1, 3)
//     for b in [27, 91, 54, 110]              // ESC [ 6 n  — CPR
//         g = parser.parser_feed_byte(p, g, b)
//     var reply = ""
//     var i = 0
//     while i < parser.parser_response_count(p)
//         reply = reply + str.from_byte(parser.parser_response_byte_at(p, i))
//         i = i + 1
//     parser.parser_response_clear(p)
//     println("${str.len(reply)}")            // 6:  ESC [ 2 ; 4 R
//     parser.parser_drop(p)
//     grid.grid_drop(g)
// ```
pub fn parser_response_count(p: Parser) -> Int [io, ffi]
    array_i64_get_h(p.response, 0)

// Reply byte `i`, for `i` in [0, `parser_response_count`).  Write these
// back to the pty master in order.
pub fn parser_response_byte_at(p: Parser, i: Int) -> Int [io, ffi]
    array_i64_get_h(p.response, 1 + i)

// Empty the reply queue, after writing it out.  The queue holds 64
// bytes; a drain per pump tick keeps it far under that.
pub fn parser_response_clear(p: Parser) [io, ffi]
    array_i64_set_h(p.response, 0, 0)

fn response_append_byte(p: Parser, b: Int) [io, ffi]
    let n = parser_response_count(p)
    if n < response_cap()
        array_i64_set_h(p.response, 1 + n, b)
        array_i64_set_h(p.response, 0, n + 1)

// Queue the bytes of an answer the terminal owes its host.  The
// spelling is `vtquery`'s, because a reply is one of the sequences this
// package reads, and a terminal that wrote its own copy of `ESC [ ? 62
// ; 22 c` would be answering in a dialect its own parser did not read.
fn response_append_reply(p: Parser, r: vtquery.AnsiReply) [io, ffi]
    for b in vtquery.write_reply([], r)
        response_append_byte(p, b)

// Which state the machine is in, as one of the `st_*` codes.  A caller
// that has fed a burst and wants to know whether a sequence is still
// open compares against `st_ground`.  `vtparse` publishes twelve
// states and this surface names six, so the four CSI states answer
// `st_csi_param` and the three string states that are consumed without
// being reported answer `st_dcs_string`.
pub fn parser_state(p: Parser) -> Int [io, ffi]
    match vtparse.state_of(p.ansi[0])
        AnsiGround             => st_ground()
        AnsiEscape             => st_esc()
        AnsiEscapeIntermediate => st_esc()
        AnsiCsiEntry           => st_csi_param()
        AnsiCsiParam           => st_csi_param()
        AnsiCsiIntermediate    => st_csi_param()
        AnsiCsiIgnore          => st_csi_param()
        AnsiOscString          => st_osc_string()
        AnsiDcsParam           => st_dcs_string()
        AnsiDcsPassthrough     => st_dcs_string()
        AnsiIgnoredString      => st_dcs_string()
        AnsiUtf8Continuation   => st_utf8_cont()

// ── CSI handlers ───────────────────────────────────────────────

// 'c' (0x63) = DA — Device Attributes query.  Reply on the response
// queue; the main loop ships it to the PTY master.  nvim sends this at
// startup and waits ~1 s for the reply before falling back to slow
// timeouts.  Primary (`\e[c`) → VT220+colors; secondary (`\e[>c`,
// private marker '>') → version.
fn csi_da(p: Parser, g: Grid, a: vtcore.AnsiParser) -> Grid [io, ffi]
    if vtparse.private_marker_of(a) == 62
        // CSI > c — secondary DA: terminal type 0 (VT100), version 1,
        // patch 0.
        response_append_reply(p, AnsiSecondaryAttributesReply(0, 1, 0))
    else
        // CSI c — primary DA.  62 = VT220, 22 = ANSI colors; 62;22 tells
        // nvim "modern terminal, use short timeouts".
        response_append_reply(p, AnsiDeviceAttributesReply(62, [22]))
    g

// 'n' (0x6E) = DSR — Device Status Report.
//   `\e[5n` → reply `\e[0n` (terminal OK)
//   `\e[6n` → reply `\e[<row>;<col>R` (1-indexed cursor pos)
fn csi_dsr(p: Parser, g: Grid, a: vtcore.AnsiParser) -> Grid [io, ffi]
    let mode = vtparse.param_at(a, 0, 0)
    if mode == 5
        response_append_reply(p, AnsiDeviceOkReply)
    else if mode == 6
        response_append_reply(p,
            AnsiCursorPositionReply(grid.grid_cursor_row(g) + 1,
                                    grid.grid_cursor_col(g) + 1))
    g

// 'r' (0x72) = DECSTBM — set top/bottom margins (scroll region).
// Params are 1-indexed inclusive.  No params = full grid; first param
// missing or 1 = top of grid; second omitted = bottom of grid.
fn csi_set_scroll_region(g: Grid, a: vtcore.AnsiParser) -> Grid [io, ffi]
    let top = vtparse.param_at(a, 0, 1) - 1
    let bot = vtparse.param_at(a, 1, g.rows) - 1
    grid.grid_set_scroll_region(g, top, bot)

// 'q' (0x71) with SPACE intermediate = DECSCUSR (set cursor style).
// vim / nvim send this on mode change so the cursor shape mirrors the
// mode (block normal, bar insert, underline replace).  Without the SP
// intermediate it's a different, less-used CSI we ignore.
fn csi_set_cursor_style(g: Grid, a: vtcore.AnsiParser) -> Grid [io, ffi]
    if vtparse.intermediate_at(a, 0) == 32
        // Latch dirty so a re-emitting host (novomux) forwards the new
        // shape this frame — even when the value matches the current one
        // (vim re-asserts block 2 on every return to normal).
        grid.grid_mark_cursor_shape_dirty(
      grid.grid_set_cursor_shape(g, vtparse.param_at(a, 0, 0)))
    else
        g

fn dispatch_csi(p: Parser, g: Grid, a: vtcore.AnsiParser, final_byte: Int) -> Grid [io, ffi]
    // DEC private-mode dispatch — `\e[?Nh` (DECSET) and `\e[?Nl`
    // (DECRST).  `vtparse` keeps the '?' apart from the intermediate
    // bytes, because `CSI ? 1049 h` and `CSI 1049 h` are different
    // sequences; dispatch_private_mode decides which modes are acted
    // on and drops the rest.
    if vtparse.private_marker_of(a) == 63 and (final_byte == 104 or final_byte == 108)
        dispatch_private_mode(g, a, final_byte == 104)
    // 'A' (0x41) = CUU — cursor up
    else if final_byte == 65
        grid.grid_cursor_move(g, 0 - vtparse.param_at(a, 0, 1), 0)
    // 'B' (0x42) = CUD — cursor down
    else if final_byte == 66
        grid.grid_cursor_move(g, vtparse.param_at(a, 0, 1), 0)
    // 'C' (0x43) = CUF — cursor forward
    else if final_byte == 67
        grid.grid_cursor_move(g, 0, vtparse.param_at(a, 0, 1))
    // 'D' (0x44) = CUB — cursor backward
    else if final_byte == 68
        grid.grid_cursor_move(g, 0, 0 - vtparse.param_at(a, 0, 1))
    // 'H' (0x48) and 'f' (0x66) = CUP / HVP — absolute set.
    // Params are 1-indexed; convert to 0-indexed for the grid.
    else if final_byte == 72 or final_byte == 102
        let row = vtparse.param_at(a, 0, 1) - 1
        let col = vtparse.param_at(a, 1, 1) - 1
        grid.grid_cursor_set(g, row, col)
    // 'J' (0x4A) = ED — erase in display
    else if final_byte == 74
        grid.grid_erase_display(g, vtparse.param_at(a, 0, 0))
    // 'K' (0x4B) = EL — erase in line
    else if final_byte == 75
        grid.grid_erase_line(g, vtparse.param_at(a, 0, 0))
    // 'L' (0x4C) = IL — insert N lines (default 1)
    else if final_byte == 76
        grid.grid_insert_lines(g, vtparse.param_at(a, 0, 1))
    // 'M' (0x4D) = DL — delete N lines (default 1)
    else if final_byte == 77
        grid.grid_delete_lines(g, vtparse.param_at(a, 0, 1))
    // '@' (0x40) = ICH — insert N blank chars (default 1)
    else if final_byte == 64
        grid.grid_insert_chars(g, vtparse.param_at(a, 0, 1))
    // 'P' (0x50) = DCH — delete N chars (default 1)
    else if final_byte == 80
        grid.grid_delete_chars(g, vtparse.param_at(a, 0, 1))
    // 'X' (0x58) = ECH — erase N chars in place (default 1).
    // Pane-aware clear: writes blanks without moving cursor and
    // without extending past the requested count.
    else if final_byte == 88
        grid.grid_erase_chars(g, vtparse.param_at(a, 0, 1))
    // 'd' (0x64) = VPA — vertical position absolute (1-indexed)
    else if final_byte == 100
        grid.grid_cursor_set(g, vtparse.param_at(a, 0, 1) - 1, g.cursor_col)
    // 'G' (0x47) = CHA — cursor horizontal absolute (1-indexed)
    else if final_byte == 71
        grid.grid_cursor_set(g, g.cursor_row, vtparse.param_at(a, 0, 1) - 1)
    // '`' (0x60) = HPA — horizontal position absolute (same as CHA)
    else if final_byte == 96
        grid.grid_cursor_set(g, g.cursor_row, vtparse.param_at(a, 0, 1) - 1)
    // 'a' (0x61) = HPR — horizontal position relative (right N)
    else if final_byte == 97
        grid.grid_cursor_move(g, 0, vtparse.param_at(a, 0, 1))
    // 'e' (0x65) = VPR — vertical position relative (down N)
    else if final_byte == 101
        grid.grid_cursor_move(g, vtparse.param_at(a, 0, 1), 0)
    // 'E' (0x45) = CNL — cursor next line (col=0, row+N)
    else if final_byte == 69
        grid.grid_cursor_set(g, g.cursor_row + vtparse.param_at(a, 0, 1), 0)
    // 'F' (0x46) = CPL — cursor previous line (col=0, row-N)
    else if final_byte == 70
        grid.grid_cursor_set(g, g.cursor_row - vtparse.param_at(a, 0, 1), 0)
    // 'S' (0x53) = SU — scroll up N (default 1)
    else if final_byte == 83
        grid.grid_scroll_region_up(g, vtparse.param_at(a, 0, 1))
    // 'T' (0x54) = SD — scroll down N (default 1)
    else if final_byte == 84
        grid.grid_scroll_region_down(g, vtparse.param_at(a, 0, 1))
    // 'c' (0x63) = DA — Device Attributes query (see csi_da)
    else if final_byte == 99
        csi_da(p, g, a)
    // 'n' (0x6E) = DSR — Device Status Report (see csi_dsr)
    else if final_byte == 110
        csi_dsr(p, g, a)
    // 'r' (0x72) = DECSTBM — set scroll region (see csi_set_scroll_region)
    else if final_byte == 114
        csi_set_scroll_region(g, a)
    // 'm' (0x6D) = SGR — set graphic rendition
    else if final_byte == 109
        dispatch_sgr(g, a)
    // 'q' (0x71) SP = DECSCUSR — set cursor style (see csi_set_cursor_style)
    else if final_byte == 113
        csi_set_cursor_style(g, a)
    else
        g

// DEC private mode set/reset.  `set` is true for DECSET (`h`),
// false for DECRST (`l`).  Param 0 carries the mode number.
//
// Modes acted on: 7 (DECAWM), 25 (DECTCEM), 47 / 1047 / 1049
// (alt screen), 1000 / 1002 / 1003 / 1006 (mouse tracking) and
// 2004 (bracketed paste).  Anything else falls through the final
// `else` and is discarded, which is the correct response for an
// unimplemented private mode: silently ignore rather than emit.
//
// The alt-screen family collapses to one path — `?47` never saved
// the cursor and `?1047` did not either before xterm 251, while
// `?1049` is defined as save + switch + clear.  All three take the
// save+switch+clear path.
fn dispatch_private_mode(g: Grid, a: vtcore.AnsiParser, set: Bool) -> Grid [io, ffi]
    let n = vtparse.param_at(a, 0, 0)
    if n == 47 or n == 1047 or n == 1049
        if set
            grid.grid_enter_alt_screen(g)
        else
            grid.grid_exit_alt_screen(g)
    // DECAWM (n=7): auto-wrap mode.  nvim toggles this around line-
    // numbered gutter writes / status-line draws — without honoring
    // it, our cursor lands on the next row instead of pegging at
    // the right margin, displacing every subsequent line.
    else if n == 7
        grid.grid_set_autowrap(g, set)
    // Bracketed paste (n=2004): apps that opt in want pasted bytes
    // wrapped in ESC[200~ … ESC[201~ envelopes so they can
    // distinguish paste-as-bulk from per-byte typing — nvim uses
    // it to suspend indentexpr/abbrev expansion during paste; zsh
    // / fish use it to colour pasted text differently and avoid
    // accidentally running multi-line pastes.  The wrap itself
    // lives in the render.nv paste handler; here we just track
    // the flag.
    else if n == 2004
        grid.grid_set_bracketed_paste(g, set)
    // Mouse tracking modes — flip individual bits in the grid's
    // mouse_mode bitmask.  render.nv's mouse handlers check it
    // and forward CSI sequences to the PTY when set (instead of
    // doing local selection).
    //   1000: report click press events only
    //   1002: report click + release + motion-while-pressed
    //   1003: report any motion (even without a button held)
    //   1006: SGR encoding format (preferred over the legacy
    //         byte-position encoding which can't represent col/row
    //         > 223)
    else if n == 1000
        if set
            grid.grid_mouse_mode_bit_on(g, 1)
        else
            grid.grid_mouse_mode_bit_off(g, 1)
    else if n == 1002
        if set
            grid.grid_mouse_mode_bit_on(g, 2)
        else
            grid.grid_mouse_mode_bit_off(g, 2)
    else if n == 1003
        if set
            grid.grid_mouse_mode_bit_on(g, 4)
        else
            grid.grid_mouse_mode_bit_off(g, 4)
    else if n == 1006
        if set
            grid.grid_mouse_mode_bit_on(g, 8)
        else
            grid.grid_mouse_mode_bit_off(g, 8)
    // DECTCEM (n=25): cursor visibility.  Apps hide the cursor
    // (`?25l`) around a repaint and show it again (`?25h`) once the
    // frame settles — nvim does this on every redraw.  Track it so
    // the novomux renderer can keep the host cursor hidden mid-paint
    // instead of flashing it at each intermediate position.
    else if n == 25
        grid.grid_set_cursor_visible(g, set)
    else
        g

// SGR — walk the parameters, each interpreted independently except
// 38, 48 and 58, which introduce a colour that spans the parameters
// after them.  `sgr.read_extended_color` reads both spellings, the
// semicolon form xterm shipped and the colon form T.416 defines, and
// says how many parameters the colour took — which is what lets the
// walk resume in the right place instead of reading a blue channel as
// a request for italics.
//
// An empty parameter list is SGR 0: ECMA-48 §8.3.117 gives SGR the
// default parameter 0, so `CSI m` is a reset.
fn dispatch_sgr(g: Grid, a: vtcore.AnsiParser) -> Grid [io, ffi]
    let count = vtparse.param_count(a)
    if count == 0
        grid.grid_sgr_reset(g)
    else
        let ps = vtparse.params_of(a)
        var g_acc = g
        var i = 0
        while i < count
            let v = vtparse.params_at(ps, i, 0)
            if v == 38 or v == 48 or v == 58
                match sgr.read_extended_color(ps, i)
                    Some(rd) =>
                        g_acc = apply_extended_color(g_acc, v, rd.color)
                        i = i + rd.consumed
                    None     =>
                        // Truncated or an unknown colour space: skip
                        // the introducer and read what follows as
                        // ordinary parameters.
                        i = i + 1
            else
                g_acc = apply_sgr_one(g_acc, v)
                i = i + 1
        g_acc

// A colour from 38 (foreground), 48 (background) or 58 (underline).
//
// An index is resolved to RGB here, against the C-side session palette,
// so the cell stores RGB.  The consequence is that a later palette
// change does not recolour already-painted cells.  Direct colour
// reaches the cell at its full 24 bits, with no quantisation to the
// 6x6x6 cube.  58's colour is read and dropped: a cell carries one
// foreground and one background, and an underline of its own colour is
// not in the model.
fn apply_extended_color(g: Grid, introducer: Int, c: sgr.AnsiColor) -> Grid [io, ffi]
    if introducer == 58
        g
    else
        let is_fg = introducer == 38
        match c
            AnsiIndexed(idx)        =>
                let rgb = novo_term_palette_lookup_h(idx)
                if is_fg
                    grid.grid_set_fg(g, rgb)
                else
                    grid.grid_set_bg(g, rgb)
            AnsiTrueColor(r, gc, b) =>
                let rgb = int.shl(r & 255, 16) | int.shl(gc & 255, 8) | (b & 255)
                if is_fg
                    grid.grid_set_fg(g, rgb)
                else
                    grid.grid_set_bg(g, rgb)
            AnsiDefaultColor        =>
                if is_fg
                    grid.grid_set_fg(g, novo_term_default_fg_get_h())
                else
                    grid.grid_set_bg(g, novo_term_default_bg_get_h())

// Look up an indexed color via the C-side session palette
// (set at renderer startup with config.config_palette + xterm-
// derived 16-231 cube + 232-255 grayscale ramp defaults for
// 16-255).
@ffi("novo_term_palette_lookup")
fn novo_term_palette_lookup_h(idx: Int) -> Int [io, ffi]

@ffi("novo_term_default_fg_get")
fn novo_term_default_fg_get_h() -> Int [io, ffi]

@ffi("novo_term_default_bg_get")
fn novo_term_default_bg_get_h() -> Int [io, ffi]

// One SGR parameter.
//
// The attribute model is ECMA-48 §8.3.117: each graphic rendition is
// an INDEPENDENT switch, so a set touches one bit and a reset clears
// the one bit it names.  `CSI 1;4m` ends bold AND underlined; `CSI
// 24m` after `CSI 1;7m` drops underline and leaves bold and reverse
// standing.  Only SGR 0 clears the whole mask, and it goes through
// grid_sgr_reset because it restores the runtime default colours too.
//
// `sgr.apply_sgr_one` folds the same parameters onto `sgr.SgrAttrs`,
// which is a struct of named flags and three `AnsiColor`s.  A cell
// here is two 64-bit words and a colour is RGB resolved through the
// session palette, so the fold below is the one this model needs.
fn apply_sgr_one(g: Grid, v: Int) -> Grid [io, ffi]
    if v == 0
        grid.grid_sgr_reset(g)
    else if v == 1
        grid.grid_add_attr(g, grid.attr_bold())
    else if v == 3
        grid.grid_add_attr(g, grid.attr_italic())
    else if v == 4
        grid.grid_add_attr(g, grid.attr_underline())
    else if v == 7
        grid.grid_add_attr(g, grid.attr_reverse())
    else if v == 9
        grid.grid_add_attr(g, grid.attr_strike())
    else if v == 22
        grid.grid_clear_attr(g, grid.attr_bold())
    else if v == 23
        grid.grid_clear_attr(g, grid.attr_italic())
    else if v == 24
        grid.grid_clear_attr(g, grid.attr_underline())
    else if v == 27
        grid.grid_clear_attr(g, grid.attr_reverse())
    else if v == 29
        grid.grid_clear_attr(g, grid.attr_strike())
    else if v >= 30 and v <= 37
        grid.grid_set_fg(g, novo_term_palette_lookup_h(v - 30))
    else if v >= 90 and v <= 97
        grid.grid_set_fg(g, novo_term_palette_lookup_h(v - 90 + 8))
    else if v == 39
        // SGR 39: return-to-default fg.  Read the runtime default
        // (mutable via OSC 10) instead of the compile-time constant.
        grid.grid_set_fg(g, novo_term_default_fg_get_h())
    else if v >= 40 and v <= 47
        grid.grid_set_bg(g, novo_term_palette_lookup_h(v - 40))
    else if v >= 100 and v <= 107
        grid.grid_set_bg(g, novo_term_palette_lookup_h(v - 100 + 8))
    else if v == 49
        // SGR 49: return-to-default bg.  Same OSC-11-aware lookup.
        grid.grid_set_bg(g, novo_term_default_bg_get_h())
    else
        g

// ── ESC and C0 handlers ────────────────────────────────────────

// A C0 control that acts on its own.  BEL and the rest are dropped:
// a terminal that rang a bell for every 0x07 in a `cat` of a binary
// file would be unusable, and the four below are the ones that move
// the cursor.
fn execute_c0(g: Grid, c: Int) -> Grid [io, ffi]
    if c == 8   // BS
        grid.grid_backspace(g)
    else if c == 9   // HT
        grid.grid_tab(g)
    else if c == 10   // LF
        grid.grid_line_feed(g)
    else if c == 13   // CR
        grid.grid_carriage_return(g)
    else
        g

// ESC <intermediates> <final>.
//
// A sequence with an intermediate byte is a charset designator —
// `ESC ( B` and its neighbours — and output here is always ASCII /
// UTF-8, so the designator is consumed and nothing changes.
fn dispatch_esc(g: Grid, a: vtcore.AnsiParser, final_byte: Int) -> Grid [io, ffi]
    if vtparse.intermediate_count(a) > 0
        g
    // ESC 7 — DECSC: save cursor, colours and attributes.
    else if final_byte == 55
        grid.grid_decsc(g)
    // ESC 8 — DECRC: restore what DECSC saved.
    else if final_byte == 56
        grid.grid_decrc(g)
    // ESC D — IND (index): cursor down one line; if already at
    // the bottom of the scroll region, scroll the region up so
    // the cursor stays at the bottom edge.  nvim emits this when
    // moving the cursor past the bottom of the viewport instead
    // of using CSI B + CSI S — dropping it left nvim's redraw
    // landing the new line on the OLD row, producing the user-
    // visible "line below appears at cursor row" duplication.
    else if final_byte == 68
        let bot = grid.grid_region_bottom(g)
        if g.cursor_row >= bot
            grid.grid_scroll_region_up(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row + 1, g.cursor_col)
    // ESC E — NEL (next line): CR + LF.  Move cursor to column 0
    // and down one line, scrolling if needed.  Same scroll-aware
    // semantics as IND.
    else if final_byte == 69
        let bot = grid.grid_region_bottom(g)
        let g2 = if g.cursor_row >= bot
            grid.grid_scroll_region_up(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row + 1, 0)
        grid.grid_cursor_set(g2, g2.cursor_row, 0)
    // ESC M — RI (reverse index): cursor up one line; if already
    // at the TOP of the scroll region, scroll the region DOWN so
    // the cursor stays at the top edge.  nvim emits this on
    // reverse scroll (Ctrl+Y / cursor up at top).
    else if final_byte == 77
        let top = grid.grid_region_top(g)
        if g.cursor_row <= top
            grid.grid_scroll_region_down(g, 1)
        else
            grid.grid_cursor_set(g, g.cursor_row - 1, g.cursor_col)
    else
        // ESC = (DECPAM), ESC > (DECPNM), ESC c (RIS — full reset)
        // and every other ESC final: dropped.
        g

// ── Top-level dispatch ─────────────────────────────────────────

// Feed one byte through the parser.  Returns the updated Grid;
// the Parser's state machine lives in its `ansi` field so the
// caller doesn't need to rebind it.
pub fn parser_feed_byte(p: Parser, g: Grid, b: Int) -> Grid [io, ffi]
    // `a` is the parser the byte was fed to.  It is named because the
    // buffer is read by copy, and the action, the parameters and the
    // stored state are all the same parser.
    let a = vtparse.feed(p.ansi[0], b)
    p.ansi[0] = a
    apply_action(p, g, a, vtparse.action_of(a))

// What one action does to the grid.
//
// The parameters of a dispatch are on `a`, the parser the byte was fed
// to, which is why it is threaded here rather than read off the field a
// second time.  A refusal — a broken limit, or bytes that are not UTF-8
// — drops the sequence and leaves the screen alone, which is what keeps
// one bad byte from wedging a terminal.  The one refusal that outlives
// its byte is an OSC payload past its ceiling: the string ends normally
// afterwards, so the refusal is recorded and read again at the end.
fn apply_action(p: Parser, g: Grid, a: vtcore.AnsiParser,
                act: vtparse.AnsiAction) -> Grid [io, ffi]
    match act
        AnsiNothing        => g
        AnsiPrint(ch)      => grid.grid_put_char(g, ch)
        AnsiExecute(c)     => execute_c0(g, c)
        AnsiEscDispatch(f) => dispatch_esc(g, a, f)
        AnsiCsiDispatch(f) => dispatch_csi(p, g, a, f)
        AnsiOscStart       =>
            osc_accum_reset(p)
            g
        AnsiOscPut(byte)   =>
            osc_accum_append(p, byte)
            g
        AnsiOscEnd(_)      =>
            if osc_accum_refused(p)
                osc_accum_reset(p)
            else
                osc_accum_finalise(p)
            g
        AnsiDcsStart(_)    => g
        AnsiDcsPut(_)      => g
        AnsiDcsEnd(_)      => g
        AnsiRefused(why)   =>
            if osc_too_long(why)
                osc_accum_refuse(p)
            g
