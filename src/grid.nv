// grid.nv — Cell + Grid model for the novo-vte terminal emulator,
// shared by novoterm and novomux.
//
// Pure-Novo: no FFI surface of its own.  Backed by a std.array i64
// array (unboxed scalar storage, O(1) get/set) so per-frame mutation
// doesn't allocate.
//
// A cell is TWO consecutive i64 words; the exact bit assignment lives
// beside the packing helpers in the "Cell packing helpers" section
// below, which is the single normative statement of the layout.
//
// Grid is a flat (rows × cols) array of those word pairs, addressed by
// the linear cell index `row * cols + col` (`grid_idx`) times the
// 2-word stride.  Cursor and current SGR state ride along on the Grid
// struct as `mut` fields; every mutator also RETURNS the Grid so a
// caller written in the older threading style still reads correctly.
//
// One cell is exactly one column.  East Asian Wide and Fullwidth
// characters (UAX #11) are stored in a single cell and drawn one
// column wide, and combining marks (UAX #29 grapheme clusters) each
// occupy their own cell rather than joining the base character.
//
// Color arrives as the ECMA-48 SGR palette — 30..37 / 40..47 and the
// aixterm bright forms 90..97 / 100..107:
//   0=black 1=red 2=green 3=yellow 4=blue 5=magenta 6=cyan 7=white
//   8..15 are the bright variants.  Default fg = 7, default bg = 0.
// The parser resolves an index to 24-bit RGB before it reaches a
// cell, so stored cells hold RGB and never an index.
//
// Why these @ffi re-declarations live here: pkg-build loads
// sibling modules with `prepend_stdlib:false`, so compiler/stdlib/
// array.nv's decls are NOT visible here even though they're
// available in main.nv.  Re-declaring the @ffi names locally
// maps them back to the same C symbols and the linker resolves
// them once.  Harmless duplication; no impact on the produced
// binary.
//
// A grid in use.  Every mutator RETURNS the grid, so a caller written
// in the threading style reads correctly; the array is `@ffi`-backed,
// which is why the example declares `[ffi]` beside `[io]` and why the
// grid has to be dropped.  `grid_to_string` is the readable dump —
// cursor position first, then one line per row.
//
// ```novo
// use grid
//
// fn main() [io, ffi]
//     var g = grid.grid_new(2, 3)
//     g = grid.grid_put_char(g, 65)     // 'A'
//     g = grid.grid_put_char(g, 66)     // 'B'
//     print(grid.grid_to_string(g))
//     // @ 0,2      the cursor, row then column
//     // AB         row 0; the third column is still blank
//     //            row 1, empty
//     grid.grid_drop(g)
// ```

@ffi("novo_array_i64_alloc")
fn array_i64_alloc_h(capacity: Int) -> Int [io, ffi]

@ffi("novo_array_i64_get")
fn array_i64_get_h(h: Int, i: Int) -> Int [io, ffi]

@ffi("novo_array_i64_set")
fn array_i64_set_h(h: Int, i: Int, v: Int) [io, ffi]

@ffi("novo_array_i64_drop")
fn array_i64_drop_h(h: Int) [io, ffi]

// ── Constants ───────────────────────────────────────────────────

// Character-attribute bits, one per ECMA-48 graphic rendition.  They
// are INDEPENDENT switches (§8.3.117): a cell can be bold and
// underlined at once, and SGR 24 clears underline without touching
// bold.  Set them with grid_add_attr / clear them with
// grid_clear_attr, never by assigning the mask.
//
// Bit 3 (value 8) is NOT free: novoterm's renderer ORs it into the
// cursor cell as the bar-cursor shape, so italic and strikethrough
// take bits 4 and 5.
// Bold, bit 0.  SGR 1 sets it, SGR 22 clears it.
pub fn attr_bold() -> Int
    1
// Underline, bit 1.  SGR 4 sets it, SGR 24 clears it.
pub fn attr_underline() -> Int
    2
// Reverse video, bit 2.  SGR 7 sets it, SGR 27 clears it.  A renderer
// applies it by swapping the cell's fg and bg at draw time; the stored
// colours are left as written.
pub fn attr_reverse() -> Int
    4
// Italic, bit 4.  SGR 3 sets it, SGR 23 clears it.  Bit 3 is taken by
// novoterm's bar-cursor shape, which is why italic is not bit 3.
pub fn attr_italic() -> Int
    16
// Crossed out, bit 5.  SGR 9 sets it, SGR 29 clears it.
pub fn attr_strike() -> Int
    32

fn blank_glyph() -> Int
    32   // ASCII space

// ── Cell packing helpers ───────────────────────────────────────
//
// A cell is 2 i64s rather than 1 because a single word cannot hold
// two 24-bit colors beside the glyph and attrs.  Packing fg and bg as
// 8-bit palette indices would fit, but it quantises `CSI 38;2;R;G;Bm`
// (ECMA-48 SGR direct-color) into the 256-color cube at parse time
// and the original values are then unrecoverable.
//
// Cell layout (2 consecutive i64s in the cells array):
//   word 0:  bits  0..15 — glyph codepoint (16 bits)
//            bits 16..23 — attrs (8 bits)
//            bits 24..47 — fg RGB packed as r<<16 | g<<8 | b (24 bits)
//            bits 48..63 — reserved
//   word 1:  bits  0..23 — bg RGB packed as r<<16 | g<<8 | b (24 bits)
//            bits 24..63 — reserved
//
// Storage: cells array sized 2 × rows × cols.  Indexes:
//   word 0 at  2 * (row * cols + col)
//   word 1 at  2 * (row * cols + col) + 1
//
// API contract: the renderer reads BOTH words per cell to pack
// the GPU instance buffer; the parser writes BOTH on each glyph
// emit (via grid_put_char).  Pure-Novo callers that don't care
// about colors can use grid_get_word0 + cell_glyph / cell_attrs
// without ever touching word 1.

fn pack_word0(glyph: Int, attrs: Int, fg_rgb: Int) -> Int
    (glyph & 65535) | int.shl(attrs & 255, 16) | int.shl(fg_rgb & 16777215, 24)

// Build word 1 of a cell from a 24-bit background RGB.  Word 1 holds
// nothing else, so this is the whole of it; pair it with
// `pack_word0_idx` (or `pack_word0`'s RGB form) and one `grid_set_pair`
// to write a cell in both colours.
pub fn pack_word1(bg_rgb: Int) -> Int
    bg_rgb & 16777215

// The codepoint stored in word 0 of a cell — bits 0..15.
//
// The read-back half of the model: feed bytes in, take words out with
// `grid_get` / `grid_get_w1`, and unpack them with these four readers.
//
// ```novo
// use grid
//
// fn main() [io, ffi]
//     var g = grid.grid_new(1, 4)
//     g = grid.grid_set_fg(g, 0xff0000)
//     g = grid.grid_add_attr(g, grid.attr_bold())
//     g = grid.grid_put_char(g, 72)          // 'H'
//     let w0 = grid.grid_get(g, 0, 0)
//     println("${grid.cell_glyph(w0)}")      // 72
//     println("${grid.cell_fg(w0)}")         // 16711680  (0xff0000)
//     println("${grid.cell_attrs(w0)}")      // 1         (bold)
//     println("${grid.cell_bg(grid.grid_get_w1(g, 0, 0))}")   // 0
//     grid.grid_drop(g)
// ```
pub fn cell_glyph(w0: Int) -> Int
    w0 & 65535
// The 8-bit attribute mask stored in word 0 of a cell — bits 16..23.
// Test one rendition with `bits.band(cell_attrs(w0), attr_bold())`; the
// bits are independent switches, so never compare the mask for equality.
pub fn cell_attrs(w0: Int) -> Int
    int.shr_logical(w0, 16) & 255
// The foreground of a cell, 24-bit RGB packed as r<<16 | g<<8 | b —
// word 0, bits 24..47.  Always a colour, never a palette index: the
// parser resolves indexed SGR through the session palette before the
// cell is written.
pub fn cell_fg(w0: Int) -> Int
    int.shr_logical(w0, 24) & 16777215
// The background of a cell, 24-bit RGB packed as r<<16 | g<<8 | b.  It
// lives alone in word 1, so this reader takes word 1 — the value
// `grid_get_w1` returns — and not word 0.
pub fn cell_bg(w1: Int) -> Int
    w1 & 16777215

// Default fg / bg as RGB (resolved from palette[7] / palette[0]
// via the C-side default seed — matches the same xterm ANSI
// values the renderer used to bake into the WGSL shader).
// The foreground a blank cell carries, and what `grid_sgr_reset`
// restores: ANSI white, palette index 7.
pub fn default_fg_rgb() -> Int
    0xaaaaaa   // ANSI white (index 7)
// The background a blank cell carries, and what `grid_sgr_reset`
// restores: ANSI black, palette index 0.
pub fn default_bg_rgb() -> Int
    0x0   // ANSI black (index 0)

fn blank_word0() -> Int
    pack_word0(blank_glyph(), 0, default_fg_rgb())
fn blank_word1() -> Int
    pack_word1(default_bg_rgb())

// Back-compat alias used by old call sites that just want a
// "default cell" pair.  Always pair with `blank_word1()` on
// writes — `blank_cell()` returns the W0 half only.
fn blank_cell() -> Int
    blank_word0()

// Index-taking shim for WORD 0: (glyph, fg_idx, attrs) in, word 0 of
// the 2-word cell out, with fg_idx resolved to RGB through the
// session palette.  Named for the word it builds, and takes only the
// fields that word holds.
//
// It used to be `pack_cell(glyph, fg_idx, bg_idx, attrs)`, which read
// as "build a cell from these four properties" and silently dropped
// the background: a cell is two i64s since truecolor, background
// lives alone in word 1, and a function returning ONE Int has nowhere
// to put it.  The first caller to write `pack_word0_idx(65, 1, 4, 0)`
// for red-on-blue would have got red on whatever was already there,
// type-checked and with no diagnostic.  A background needs
// pack_word1 and a second grid write.
pub fn pack_word0_idx(glyph: Int, fg_idx: Int, attrs: Int) -> Int [io, ffi]
    let fg_rgb = novo_term_palette_lookup_h(fg_idx)
    pack_word0(glyph, attrs, fg_rgb)

@ffi("novo_term_palette_lookup")
fn novo_term_palette_lookup_h(idx: Int) -> Int [io, ffi]

// ── Grid ────────────────────────────────────────────────────────

// The six fields below are `mut` because they change on ordinary
// terminal traffic — a cursor move, an SGR, an alt-screen swap.  They
// used to be immutable, which meant every one of those rebuilt the whole
// struct: `parser_feed_byte` returns a Grid, so novoterm allocated one
// per BYTE of pty output.  Measured at ~1.1 allocations/byte with 98%
// never reclaimed (sibling-module structs get no drop_fn), which is how
// a terminal reaches tens of gigabytes in a day of ordinary use.
//
// The handles (alt_meta, scrollback, wrap_flags) and the dimensions stay
// immutable: nothing mutates them in place, and grid_resize builds a
// genuinely new Grid because the geometry changed.
pub struct Grid
    rows: Int
    cols: Int
    var cursor_row: Int
    var cursor_col: Int
    var fg: Int
    var bg: Int
    var attrs: Int
    var cells: Int   // handle from array_i64_alloc_h — ACTIVE buffer
    alt_meta: Int   // 8-slot i64 array (alt-screen + saved state)
    scrollback: Int   // i64 array — scrollback ring + view state
    // Wrapped-line reflow state.  Per-row i64 array sized
    // `rows`; entry N = 1 if row N's last cell continues onto
    // row N+1 via auto-wrap (xterm's "soft wrap"), 0 if row N
    // ended with a hard line break (CR/LF) or a short content row.
    // grid_resize uses this to rejoin soft-wrapped runs into
    // logical lines and re-wrap them at the new col count, so a
    // shell prompt that wrapped at 80 cols unwraps cleanly when
    // the user attaches from a 120-col terminal.
    wrap_flags: Int

// The alt_meta side-array holds terminal mode state that has no home
// in a cell: the DEC private modes (`ctlseqs`' ?1049 / ?1047 / ?47
// alt-screen family, ?7 DECAWM, ?25 DECTCEM, ?1000-?1006 mouse,
// ?2004 bracketed paste), the DECSTBM scroll region, and the DECSC
// save slots.  One i64 side-array rather than a field per mode keeps
// the Grid struct — which is rebuilt on resize — small.
//
// Slot layout:
//   0  primary cells handle  (saved when alt is active, 0 otherwise)
//   1  alt cells handle      (lazily allocated on first ?1049h)
//   2  using_alt flag        (0 = primary active, 1 = alt active)
//   3  saved cursor_row
//   4  saved cursor_col
//   5  saved fg
//   6  saved bg
//   7  saved attrs
//   8  scroll_region top    (inclusive, 0-indexed)
//   9  scroll_region bottom (inclusive, 0-indexed)
//  10  autowrap (DECAWM) flag (0 = off, 1 = on — default 1)
//  11  wrap_pending flag     — xterm "right-margin pending wrap":
//                              set when the last col is written
//                              but the cursor stays at cols-1
//                              instead of wrapping immediately.
//                              The next printable char triggers
//                              the wrap; any explicit cursor move
//                              (CUP, BS, CR, LF, etc.) clears it.
//                              Without this, fully-filled rows
//                              double-advance on the next LF (one
//                              from the wrap we did eagerly, one
//                              from the LF itself) — rows below
//                              shift by 1 per fully-filled row
//                              above them.
//  12  bracketed_paste flag  — set by DECSET 2004 / cleared by
//                              DECRST 2004.  When set, the paste
//                              handlers (kind 25 / 26) wrap the
//                              pasted bytes in `ESC [ 200 ~` /
//                              `ESC [ 201 ~` envelopes so apps
//                              like nvim, zsh, fish can tell
//                              "user pasted N bytes" from "user
//                              typed N bytes individually" (the
//                              former should skip indent/abbrev
//                              expansion / etc.).
//  13  cursor_shape          — DECSCUSR (CSI Ps SP q) cursor
//                              style: 0/1 = blinking block,
//                              2 = steady block (default),
//                              3 = blinking underline,
//                              4 = steady underline,
//                              5 = blinking bar,
//                              6 = steady bar.  vim / nvim
//                              toggle this between modes (block
//                              normal, bar insert, underline
//                              replace) so the user gets visual
//                              feedback on mode.
//  14  mouse_mode bitmask    — DECSET/RST 1000/1002/1003/1006.
//                              bit 0 = report-clicks (1000),
//                              bit 1 = button-event-track (1002),
//                              bit 2 = any-motion-track (1003),
//                              bit 3 = SGR encoding (1006).
//                              Apps that enable these expect us
//                              to forward mouse events as CSI
//                              sequences to the PTY (vim's :set
//                              mouse=a, htop / lazygit click
//                              handling).  Shift held overrides
//                              the forwarding — local selection
//                              still works.
//  15  cursor_visible        — DECTCEM (DECSET/RST ?25).  1 =
//                              shown (default), 0 = hidden.  Apps
//                              hide the cursor while they repaint
//                              (nvim wraps each redraw in
//                              `?25l` … `?25h`); a renderer that
//                              re-emits the grid must honour this
//                              or the host cursor flickers at the
//                              intermediate paint positions.
//  16  cursor_shape_dirty    — set when the app emits a DECSCUSR
//                              this frame; a re-emitting renderer
//                              consumes + clears it to forward the
//                              shape exactly when the app changes
//                              it (a value-diff would miss a
//                              re-assert of the default block 2,
//                              and emitting every frame floods the
//                              stream with `CSI Ps SP q`).
fn alt_meta_slots() -> Int
    17

// Side-array layout for the scrollback ring buffer + view state.
// Capacity is a fixed 1000 lines: the ring is allocated once at
// grid_new and never grown, so the cost is bounded at
// `capacity × cols × 2` i64s regardless of session length.  Slot
// layout:
//
//   0  capacity (rows)
//   1  head (physical index of OLDEST row in the ring)
//   2  count (rows currently stored, 0..capacity)
//   3  view_offset (lines back from live; 0 = top of live grid)
//   4  cols (saved at init; mostly redundant with g.cols)
//   5..  cell data, capacity × cols i64 cells, row-major
//
// Layout invariant: logical row L (0 = oldest stored) lives at
// physical ring index P = (head + L) % capacity, and cell
// (L, C) lives at slot 5 + P * cols + C.

fn scrollback_capacity() -> Int
    1000

fn sb_meta_slots() -> Int
    5

fn scrollback_cap(sb: Int) -> Int [io, ffi]
    array_i64_get_h(sb, 0)

fn scrollback_head(sb: Int) -> Int [io, ffi]
    array_i64_get_h(sb, 1)

// How many lines the scrollback ring currently holds, at most its fixed
// 1000-line capacity.  This is the top of the range
// `scrollback_set_view_offset` accepts, so it is what a scroll-bar
// measures against.  Takes the handle `grid_new` stored on the Grid.
pub fn scrollback_count(sb: Int) -> Int [io, ffi]
    array_i64_get_h(sb, 2)

// How far the view is scrolled back, in lines: 0 is live output, N
// means the top N rows on screen come from history.  `grid_view_offset`
// reads the same value off a Grid and is the spelling a consumer wants.
pub fn scrollback_view_offset(sb: Int) -> Int [io, ffi]
    array_i64_get_h(sb, 3)

// The column count the ring's rows were stored at.  Rows are stored at
// the width they were written, so a pane resized narrower still reads
// its history back at the old width.
pub fn scrollback_cols(sb: Int) -> Int [io, ffi]
    array_i64_get_h(sb, 4)

// Move the view to `off` lines back, clamped into [0, count].  Prefer
// `grid_scroll_view`, which clamps against the live Grid and refuses to
// scroll the alt screen; this is the raw ring-level setter.
pub fn scrollback_set_view_offset(sb: Int, off: Int) [io, ffi]
    array_i64_set_h(sb, 3, off)

// Empty the scrollback: reset head, count and view-offset to 0 (the ring
// storage is left as-is; count=0 makes every row out of range).  Backs
// tmux's clear-history.
pub fn scrollback_clear(sb: Int) [io, ffi]
    array_i64_set_h(sb, 1, 0)   // head
    array_i64_set_h(sb, 2, 0)   // count
    array_i64_set_h(sb, 3, 0)   // view_offset

// Push one row of `cols` cells from a source array (typically the
// row about to fall off the top of the live grid via scroll_up).
// `src_handle` is an i64-array handle; cells [src_offset ..
// src_offset+cols) are copied.  Advances head when count was
// already at capacity (overwriting the oldest row).
// Scrollback stores 2 i64s per cell, same as the live grid.
// `src_offset` is a CELL index, not a slot offset; both words are
// copied per cell so colors travel with their glyphs.
fn scrollback_push_row(sb: Int, src_handle: Int, src_offset: Int) [io, ffi]
    let cap = scrollback_cap(sb)
    let cols = scrollback_cols(sb)
    let head = scrollback_head(sb)
    let cnt = scrollback_count(sb)
    let target_p = if cnt < cap
        (head + cnt) % cap
    else
        head
    // Each cell = 2 i64s; row offset within ring = p * cols * 2.
    let base = sb_meta_slots() + target_p * cols * 2
    var c = 0
    while c < cols
        let s_idx = (src_offset + c) * 2
        array_i64_set_h(sb, base + c * 2, array_i64_get_h(src_handle, s_idx))
        array_i64_set_h(sb, base + c * 2 + 1, array_i64_get_h(src_handle, s_idx + 1))
        c = c + 1
    if cnt < cap
        array_i64_set_h(sb, 2, cnt + 1)
    else
        array_i64_set_h(sb, 1, (head + 1) % cap)

// Read word 0 of cell at logical row L (0 = oldest stored), column C.
// Returns blank word 0 if out of range.
pub fn scrollback_get_cell(sb: Int, l: Int, c: Int) -> Int [io, ffi]
    let cnt = scrollback_count(sb)
    let cols = scrollback_cols(sb)
    if l < 0 or l >= cnt or c < 0 or c >= cols
        blank_word0()
    else
        let cap = scrollback_cap(sb)
        let head = scrollback_head(sb)
        let p = (head + l) % cap
        let slot = sb_meta_slots() + p * cols * 2 + c * 2
        array_i64_get_h(sb, slot)

// Read word 1 (bg RGB) of cell at logical row L, column C.
pub fn scrollback_get_cell_w1(sb: Int, l: Int, c: Int) -> Int [io, ffi]
    let cnt = scrollback_count(sb)
    let cols = scrollback_cols(sb)
    if l < 0 or l >= cnt or c < 0 or c >= cols
        blank_word1()
    else
        let cap = scrollback_cap(sb)
        let head = scrollback_head(sb)
        let p = (head + l) % cap
        let slot = sb_meta_slots() + p * cols * 2 + c * 2
        array_i64_get_h(sb, slot + 1)

// Allocate a scrollback array sized for cap rows × cols cells.
fn scrollback_new(cap: Int, cols: Int) -> Int [io, ffi]
    // 2 i64s per cell, so ring storage is cap × cols × 2.
    let n_slots = sb_meta_slots() + cap * cols * 2
    let h = array_i64_alloc_h(n_slots)
    array_i64_set_h(h, 0, cap)
    array_i64_set_h(h, 1, 0)
    array_i64_set_h(h, 2, 0)
    array_i64_set_h(h, 3, 0)
    array_i64_set_h(h, 4, cols)
    h

// Allocate a rows×cols grid pre-filled with blank cells.  Cursor
// starts at (0, 0).  SGR state at defaults.  Caller must
// eventually `grid.grid_drop(g)` to release the backing arrays.
pub fn grid_new(rows: Int, cols: Int) -> Grid [io, ffi]
    // 2 i64s per cell.
    let n_cells = rows * cols
    let n = n_cells * 2
    let h = array_i64_alloc_h(n)
    let bw0 = blank_word0()
    let bw1 = blank_word1()
    var i = 0
    while i < n_cells
        array_i64_set_h(h, 2 * i, bw0)
        array_i64_set_h(h, 2 * i + 1, bw1)
        i = i + 1
    let meta = array_i64_alloc_h(alt_meta_slots())
    for i in 0..alt_meta_slots()
        array_i64_set_h(meta, i, 0)
    // Slots 0 (stashed primary cells) and 1 (lazily-allocated alt buffer)
    // hold ARRAY HANDLES, and 0 is a perfectly valid handle — the first
    // array a process allocates gets it.  Using 0 as "absent" meant the
    // first Grid ever created could never leave the alternate screen:
    // grid_exit_alt_screen read slot 0, saw 0, decided nothing was stashed
    // and returned without swapping back, leaving `cells` pointing at the
    // alt buffer.  The primary's content and cursor were both lost, and it
    // looked non-deterministic because it depended on allocation order.
    // -1 is the absent sentinel; a handle is never negative.
    array_i64_set_h(meta, 0, 0 - 1)
    array_i64_set_h(meta, 1, 0 - 1)
    // DECSTBM defaults: scroll region = whole grid (0..rows-1).
    array_i64_set_h(meta, 8, 0)
    array_i64_set_h(meta, 9, rows - 1)
    // DECAWM default: autowrap ON (matches xterm / vt100).
    array_i64_set_h(meta, 10, 1)
    // wrap_pending starts clear.
    array_i64_set_h(meta, 11, 0)
    // bracketed_paste default OFF (matches xterm; apps opt in
    // via DECSET 2004 in their startup sequence).
    array_i64_set_h(meta, 12, 0)
    // cursor_shape default = 2 (steady block, xterm default).
    array_i64_set_h(meta, 13, 2)
    // mouse_mode default = 0 (no tracking).
    array_i64_set_h(meta, 14, 0)
    // cursor_visible default = 1 (shown; apps hide via DECRST ?25).
    array_i64_set_h(meta, 15, 1)
    // cursor_shape_dirty default = 0 (no pending DECSCUSR to forward).
    array_i64_set_h(meta, 16, 0)
    let sb = scrollback_new(scrollback_capacity(), cols)
    // Per-row wrap flags, all zero: a fresh grid has no soft wraps.
    let wf = array_i64_alloc_h(rows)
    for i in 0..rows
        array_i64_set_h(wf, i, 0)
    Grid {
    rows: rows, cols: cols,
    cursor_row: 0, cursor_col: 0,
    // Grid.fg/.bg hold 24-bit RGB, not palette indices.
    fg: default_fg_rgb(), bg: default_bg_rgb(), attrs: 0,
    cells: h, alt_meta: meta, scrollback: sb,
    wrap_flags: wf }

// Release the backing arrays.  Safe to call multiple times — the
// stdlib's array drop is permissive on stale handles.  Releases
// both the active cells AND any lazy-allocated alt buffer + the
// alt_meta side-array + the scrollback ring.
pub fn grid_drop(g: Grid) [io, ffi]
    let alt = array_i64_get_h(g.alt_meta, 1)
    let primary_saved = array_i64_get_h(g.alt_meta, 0)
    if alt >= 0
        array_i64_drop_h(alt)
    if primary_saved >= 0 and primary_saved != g.cells
        array_i64_drop_h(primary_saved)
    array_i64_drop_h(g.cells)
    array_i64_drop_h(g.alt_meta)
    array_i64_drop_h(g.scrollback)
    array_i64_drop_h(g.wrap_flags)

// Row count.  Fixed for the life of a Grid — `grid_resize` returns a new
// one rather than growing this.
pub fn grid_rows(g: Grid) -> Int
    g.rows
// Column count.  One cell is one column, wide characters included.
pub fn grid_cols(g: Grid) -> Int
    g.cols
// The cursor's row, 0-indexed from the top of the screen.
pub fn grid_cursor_row(g: Grid) -> Int
    g.cursor_row
// The cursor's column, 0-indexed from the left margin.  It can rest on
// `cols - 1` with a wrap pending, so it is always a valid column.
pub fn grid_cursor_col(g: Grid) -> Int
    g.cursor_col

// `grid_idx` returns the LINEAR CELL index (row * cols + col), not a
// storage offset: cells are 2 i64s each, so the words live at 2*idx
// and 2*idx+1.  Every raw-array access below must apply that stride.
fn grid_idx(g: Grid, row: Int, col: Int) -> Int
    row * g.cols + col

// Read word 0 of the cell at (row, col).  Holds glyph + attrs +
// fg RGB.  Out-of-range coords return a blank word — makes
// rendering loops safe against transient sub-frame state.
pub fn grid_get(g: Grid, row: Int, col: Int) -> Int [io, ffi]
    if row < 0 or row >= g.rows or col < 0 or col >= g.cols
        blank_word0()
    else
        array_i64_get_h(g.cells, 2 * grid_idx(g, row, col))

// Read word 1 of the cell at (row, col).  Holds bg RGB.
pub fn grid_get_w1(g: Grid, row: Int, col: Int) -> Int [io, ffi]
    if row < 0 or row >= g.rows or col < 0 or col >= g.cols
        blank_word1()
    else
        array_i64_get_h(g.cells, 2 * grid_idx(g, row, col) + 1)

// Write word 0 of the cell at (row, col).  Out-of-range coords
// are silently ignored (matches xterm: writes past the right
// margin are clipped, not errors).  Callers that change colors
// MUST pair with grid_set_w1 to keep the cell consistent.
pub fn grid_set(g: Grid, row: Int, col: Int, packed: Int) -> Grid [io, ffi]
    if row >= 0 and row < g.rows and col >= 0 and col < g.cols
        array_i64_set_h(g.cells, 2 * grid_idx(g, row, col), packed)
    g

// Write word 1 of the cell at (row, col).
pub fn grid_set_w1(g: Grid, row: Int, col: Int, packed: Int) -> Grid [io, ffi]
    if row >= 0 and row < g.rows and col >= 0 and col < g.cols
        array_i64_set_h(g.cells, 2 * grid_idx(g, row, col) + 1, packed)
    g

// Convenience: write both words atomically.
pub fn grid_set_pair(g: Grid, row: Int, col: Int, w0: Int, w1: Int) -> Grid [io, ffi]
    if row >= 0 and row < g.rows and col >= 0 and col < g.cols
        let idx = 2 * grid_idx(g, row, col)
        array_i64_set_h(g.cells, idx, w0)
        array_i64_set_h(g.cells, idx + 1, w1)
    g

// Raw-array cell helpers — take a handle + linear cell index instead
// of going through Grid, for the scroll / erase / line-shift loops
// below.  Both words move per cell; moving only word 0 would leave
// each cell's background behind and desync colors from glyphs.
fn cells_copy(dst: Int, dst_cell_idx: Int, src: Int, src_cell_idx: Int) [io, ffi]
    let s = 2 * src_cell_idx
    let d = 2 * dst_cell_idx
    array_i64_set_h(dst, d, array_i64_get_h(src, s))
    array_i64_set_h(dst, d + 1, array_i64_get_h(src, s + 1))

fn cells_blank(arr: Int, cell_idx: Int, blank_w0: Int, blank_w1: Int) [io, ffi]
    let d = 2 * cell_idx
    array_i64_set_h(arr, d, blank_w0)
    array_i64_set_h(arr, d + 1, blank_w1)

// ── Cursor / SGR mutators ──────────────────────────────────────

// Clamp a row to [0, rows-1] (used after parser-driven moves so
// out-of-range CUP doesn't crash).
fn clamp(v: Int, lo: Int, hi: Int) -> Int
    if v < lo
        lo
    else if v > hi
        hi
    else
        v

// Move the cursor to (row, col), clamped into the grid.  0-indexed,
// unlike the CUP escape sequence it backs, which counts from 1.  Clears
// any pending right-margin wrap, as every explicit cursor move does.
pub fn grid_cursor_set(var g: Grid, row: Int, col: Int) -> Grid [io, ffi]
    // Deferred wrap: any explicit cursor positioning clears the
    // right-margin pending-wrap flag.  Otherwise the
    // saved wrap state would fire on the next print after a CUP
    // that landed at col cols-1, causing a spurious row advance.
    array_i64_set_h(g.alt_meta, 11, 0)
    g.cursor_row = clamp(row, 0, g.rows - 1)
    g.cursor_col = clamp(col, 0, g.cols - 1)
    g

fn grid_cursor_move(var g: Grid, dr: Int, dc: Int) -> Grid [io, ffi]
    grid_cursor_set(var g, g.cursor_row + dr, g.cursor_col + dc)

// fg/bg take 24-bit RGB, never a palette index: the parser resolves
// SGR 30..37 / 90..97 through novo_term_palette_lookup before calling
// these, so a live palette change affects only cells written after it.
pub fn grid_set_fg(var g: Grid, fg_rgb: Int) -> Grid
    g.fg = fg_rgb & 16777215
    g

// Set the background every following `grid_put_char` writes, as 24-bit
// RGB.  See `grid_set_fg` for why this is never a palette index.
pub fn grid_set_bg(var g: Grid, bg_rgb: Int) -> Grid
    g.bg = bg_rgb & 16777215
    g

// Replace the WHOLE attribute mask.  Only two callers want this: a
// reset, and a test pinning an exact mask.  An SGR that names one
// rendition must use grid_add_attr / grid_clear_attr instead — using
// this one is what made `CSI 1;4m` render underline without bold.
pub fn grid_set_attrs(var g: Grid, attrs: Int) -> Grid
    g.attrs = attrs & 255
    g

// Turn one attribute bit ON, leaving the rest of the mask alone.
pub fn grid_add_attr(var g: Grid, bit: Int) -> Grid
    g.attrs = (g.attrs | bit) & 255
    g

// Turn one attribute bit OFF, leaving the rest of the mask alone.
pub fn grid_clear_attr(var g: Grid, bit: Int) -> Grid
    g.attrs = g.attrs & (~bit & 255)
    g

// SGR 0 (reset) reads the RUNTIME defaults rather than the
// compile-time constants, so an OSC 10 / OSC 11 default-color change
// takes effect on the very next attribute reset — which is what apps
// emit right after changing them (OSC, then clear, then SGR 0).
@ffi("novo_term_default_fg_get")
fn _td_fg_get_h() -> Int [io, ffi]

@ffi("novo_term_default_bg_get")
fn _td_bg_get_h() -> Int [io, ffi]

// SGR 0: put the colours back to the session defaults and clear the
// whole attribute mask.  Cells already written keep what they carry.
pub fn grid_sgr_reset(var g: Grid) -> Grid [io, ffi]
    g.fg = _td_fg_get_h()
    g.bg = _td_bg_get_h()
    g.attrs = 0
    g

// ── Scroll ─────────────────────────────────────────────────────

// Scroll-region accessors.  Default is 0..rows-1 (whole grid).
// Set via DECSTBM (`\e[Pt;Pb r`) — Neovim splits rely on this to
// scroll one pane without disturbing others.
fn grid_region_top(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 8)

fn grid_region_bottom(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 9)

// Set the scroll region.  top/bottom are 0-indexed inclusive
// row numbers.  Clamps into [0, rows-1] and ensures top ≤
// bottom.  No-op if top ≥ rows (defensive — some sequences
// arrive with stale row counts post-resize).
pub fn grid_set_scroll_region(g: Grid, top: Int, bottom: Int) -> Grid [io, ffi]
    let t = if top < 0
        0
    else
        top
    let b = if bottom >= g.rows
        g.rows - 1
    else
        bottom
    if t >= g.rows or t > b
        g
    else
        array_i64_set_h(g.alt_meta, 8, t)
        array_i64_set_h(g.alt_meta, 9, b)
        g

// Region-aware scroll.  Shifts rows region_top+1..region_bottom
// up by one within the region, leaving everything outside it
// untouched; row region_bottom fills with blank.  When the
// region is the whole grid AND we're in the primary buffer,
// the about-to-be-discarded top row enters the scrollback ring
// (xterm convention — partial-region scrolls don't push).
pub fn grid_scroll_up(g: Grid) -> Grid [io, ffi]
    let top = grid_region_top(g)
    let bot = grid_region_bottom(g)
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    let full_region = top == 0 and bot == g.rows - 1
    if using_alt == 0 and full_region
        scrollback_push_row(g.scrollback, g.cells, grid_idx(g, 0, 0))
    let bw0 = blank_word0()
    let bw1 = blank_word1()
    for r in top..bot
        for c in 0..g.cols
            cells_copy(g.cells, grid_idx(g, r, c),
                  g.cells, grid_idx(g, r + 1, c))
    // Shift the per-row wrap_flags alongside the cells so the
    // row→wrap-flag correspondence stays intact across
    // scroll-up.  Without this, marked-soft-wrap rows keep their
    // mark on the row index they USED to occupy, mis-identifying
    // logical lines on the next reflow.
    for r in top..bot
        let next = array_i64_get_h(g.wrap_flags, r + 1)
        array_i64_set_h(g.wrap_flags, r, next)
    array_i64_set_h(g.wrap_flags, bot, 0)
    // Blank the now-empty BOTTOM ROW OF THE REGION, not the grid's
    // last row — that would punch a hole below the region for any
    // partial-region scroll.
    for c in 0..g.cols
        cells_blank(g.cells, grid_idx(g, bot, c), bw0, bw1)
    g

// ── Character writes ───────────────────────────────────────────

// Put a glyph at the cursor, advance the cursor one column.  Wraps to
// the next row at the right margin; scrolls when the cursor crosses
// the bottom edge.
pub fn grid_put_char(var g: Grid, glyph: Int) -> Grid [io, ffi]
    // Any POSITIVE codepoint is accepted, including C0 controls: the
    // parser routes real control bytes to the dedicated handlers before
    // reaching here, and the renderer's atlas mapping decides which slot
    // an unmapped codepoint falls back to.  Only 0, negatives and DEL
    // are rejected, so the cursor never advances on a stray value.
    if glyph <= 0 or glyph == 127
        g
    else
        // Any shell-driven output snaps the view back to the live
        // grid (xterm convention) — otherwise
        // the user would scroll up, ls would run, and they'd still
        // be looking at the old content with no idea ls fired.
        scrollback_set_view_offset(g.scrollback, 0)
        // xterm's "right-margin pending wrap" (see `ctlseqs`, DECAWM):
        // if the previous put_char filled the last column, the cursor
        // stayed pegged at cols-1 with wrap_pending set.  Trigger the
        // wrap NOW, before printing the new char.  Wrapping eagerly
        // instead makes a fully-filled row followed by LF advance the
        // cursor by 2 rows (the eager wrap plus the LF), shifting every
        // row below it by one — visible as doubled blank lines in any
        // full-screen app that fills rows to the right margin.
        let g0 = if grid_wrap_pending(g) == 1 and grid_autowrap(g) == 1
            // Mark the row we're about to wrap OUT of as a
            // soft-wrap continuation so grid_resize can rejoin the
            // logical line later.  Set BEFORE the scroll-up so the
            // mark lands on the actual row of the wrapping cell;
            // scroll-up will shift it like the rest.
            grid_set_row_wrapped(g, g.cursor_row, 1)
            let bot = grid_region_bottom(g)
            let g_wrap = if g.cursor_row >= bot
                var gs = grid_scroll_up(g)
                grid_cursor_set(var gs, bot, 0)
            else
                grid_cursor_set(var g, g.cursor_row + 1, 0)
            grid_clear_wrap_pending(g_wrap)
        else
            grid_clear_wrap_pending(g)
        // Write BOTH words.  W0 carries glyph + attrs + fg_rgb; W1
        // carries bg_rgb.  g0.fg / g0.bg are already 24-bit RGB after
        // the parser-side palette lookup.
        let w0 = pack_word0(glyph, g0.attrs, g0.fg)
        let w1 = pack_word1(g0.bg)
        var g2 = grid_set_pair(g0, g0.cursor_row, g0.cursor_col, w0, w1)
        let next_col = g2.cursor_col + 1
        if next_col >= g.cols
            // DECAWM off: peg at right margin without setting wrap-
            // pending — subsequent writes overwrite this same cell.
            let aw = grid_autowrap(g2)
            if aw == 0
                grid_cursor_set(var g2, g2.cursor_row, g.cols - 1)
            else
                // DECAWM on: set wrap-pending and keep cursor at cols-1.
                // The actual row advance happens on the NEXT printable
                // char (above), matching xterm's deferred-wrap semantics
                // that nvim relies on.
                let g_keep = grid_cursor_set(var g2, g2.cursor_row, g.cols - 1)
                grid_set_wrap_pending(g_keep)
        else
            grid_cursor_set(var g2, g2.cursor_row, next_col)

// Per-row wrap-flag accessors.  Bounds-checked: a stale row index
// (after scroll-up shifts) reads as 0 so resize-time reflow doesn't
// double-count a logical line.
fn grid_row_wrapped(g: Grid, row: Int) -> Int [io, ffi]
    if row < 0 or row >= g.rows
        0
    else
        array_i64_get_h(g.wrap_flags, row)

fn grid_set_row_wrapped(g: Grid, row: Int, on: Int) [io, ffi]
    if row >= 0 and row < g.rows
        array_i64_set_h(g.wrap_flags, row, (if on != 0 then 1 else 0))

// DECAWM accessor + setter.  Slot 10 of alt_meta; defaults to 1
// (autowrap on) per xterm.  When 0, grid_put_char clamps cursor
// at the right margin instead of wrapping.
fn grid_autowrap(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 10)

fn grid_set_autowrap(g: Grid, on: Bool) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 10, (if on then 1 else 0))
    g

// wrap_pending accessor + mutators.  Slot 11; set when a put_char
// fills the rightmost column, cleared by the next put_char (after
// triggering the deferred wrap) or by any explicit cursor move.
fn grid_wrap_pending(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 11)

fn grid_set_wrap_pending(g: Grid) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 11, 1)
    g

fn grid_clear_wrap_pending(g: Grid) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 11, 0)
    g

// Bracketed-paste accessor + setter.  Slot 12; toggled by
// DECSET/RST 2004.  Read by the render.nv paste handlers to
// decide whether to wrap pasted bytes in ESC [200~ … ESC [201~.
pub fn grid_bracketed_paste(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 12)

fn grid_set_bracketed_paste(g: Grid, on: Bool) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 12, (if on then 1 else 0))
    g

// DECSCUSR cursor-shape accessor + setter.  Shape codes match
// the xterm spec (0/1 blink block, 2 steady block, ..., 6 steady
// bar).  Renderer reads via grid_cursor_shape and branches on
// the value when painting the cursor cell.
pub fn grid_cursor_shape(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 13)

// Set the DECSCUSR shape code, clamped to 0..6 — anything else becomes
// the default steady block.  It does NOT touch the dirty latch: pair it
// with `grid_mark_cursor_shape_dirty` when the new shape is to be
// forwarded, which is what the parser does on `CSI Ps SP q`.
pub fn grid_set_cursor_shape(g: Grid, shape: Int) -> Grid [io, ffi]
    let s = if shape < 0 or shape > 6
        2
    else
        shape
    array_i64_set_h(g.alt_meta, 13, s)
    g

// DECTCEM cursor visibility (DECSET/RST ?25).  1 = shown.  Apps
// hide the cursor (`?25l`) while repainting and show it (`?25h`)
// once the frame settles; the renderer honours this so the host
// cursor doesn't flicker at intermediate paint positions.
pub fn grid_cursor_visible(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 15)

// Show or hide the cursor — the state DECSET/RST ?25 carries.
pub fn grid_set_cursor_visible(g: Grid, on: Bool) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 15, (if on then 1 else 0))
    g

// DECSCUSR forward latch.  The parser marks this when an app emits
// `CSI Ps SP q`; the renderer reads it to forward the new shape and
// clears it, so the shape is re-emitted exactly on the app's mode
// changes rather than every frame (which would flood output) or
// only on a value change (which would miss a re-assert of block 2).
pub fn grid_cursor_shape_dirty(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 16)

// Latch the cursor shape as changed.  A renderer that re-emits into a
// host terminal marks it after a resize or a re-attach, so the shape is
// asserted again on a screen that no longer holds it.
pub fn grid_mark_cursor_shape_dirty(g: Grid) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 16, 1)
    g

// Clear the latch, after forwarding the shape.
pub fn grid_clear_cursor_shape_dirty(g: Grid) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 16, 0)
    g

// Mouse-mode bitmask accessor + setter.  Caller (parser) ORs
// or ANDs in individual bits via grid_mouse_mode_bit_on/off
// for the DECSET/RST entry points.
pub fn grid_mouse_mode(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 14)

// Pure mouse-tracking gate + SGR button-byte, split out of
// render.forward_mouse_event so it is unit-testable without a PTY.
// Given the active mouse-mode bitmask and a compact modifier+button
// mask, return the SGR button byte to emit, or -1 when the event must
// NOT be forwarded (so the terminal's local selection handles it).
//
//   mode bits: 1 = 1000 (report clicks), 2 = 1002 (report drag =
//              motion while a button is held), 4 = 1003 (report ANY
//              motion incl. idle hover), 8 = 1006 (SGR framing —
//              affects only the ESC[< wrapper, not this byte).
//   mods bits: 0 = Shift, 1 = Ctrl, 2 = Alt,
//              3/4/5 = left/middle/right button currently HELD.
//   motion:    true for a MotionNotify (drag / hover).
//   button:    SGR button for a press/release (0=left,1=mid,2=right).
//
// The fix this encodes: a motion event's button is the *held* button
// (or 3 = "no button" for idle hover), NOT a hardcoded left-button.
// Previously every hover was forwarded as a left-button drag, so apps
// with 1002/1003 tracking (zellij) kept extending their selection when
// the mouse merely moved with no button down.
pub fn grid_mouse_sgr_code(mode: Int, mods: Int, motion: Bool, button: Int) -> Int
    let shift_held = mods % 2 == 1
    if mode == 0 or shift_held
        0 - 1
    else
        // Which button is physically held (bits 3/4/5): left→0, mid→1,
        // right→2, none→3.
        let held = if (mods & 8) != 0
            0
        else if (mods & 16) != 0
            1
        else if (mods & 32) != 0
            2
        else
            3
        let report_drag = (mode & 2) != 0
        let report_any = (mode & 4) != 0
        let report_clicks = (mode & 7) != 0
        let eff_button = if motion
            held
        else
            button
        let want = if motion
            if held != 3
                report_drag or report_any
            else
                report_any
        else
            report_clicks
        if not want
            0 - 1
        else
            // SGR modifier offsets: +8 meta, +16 ctrl, +32 motion.
            let ctrl_bit = if (mods & 2) != 0
                16
            else
                0
            let alt_bit = if (mods & 4) != 0
                8
            else
                0
            let mot_bit = if motion
                32
            else
                0
            eff_button + ctrl_bit + alt_bit + mot_bit

fn grid_mouse_mode_bit_on(g: Grid, bit: Int) -> Grid [io, ffi]
    let cur = array_i64_get_h(g.alt_meta, 14)
    array_i64_set_h(g.alt_meta, 14, cur | bit)
    g

fn grid_mouse_mode_bit_off(g: Grid, bit: Int) -> Grid [io, ffi]
    let cur = array_i64_get_h(g.alt_meta, 14)
    // Clear `bit`: AND with ~bit.  No bitwise-not in Novo std —
    // use XOR with all-ones-mask = ~bit when current bit is set.
    // Simpler: subtract if present.
    let new = if (cur & bit) != 0
        cur - bit
    else
        cur
    array_i64_set_h(g.alt_meta, 14, new)
    g

// BS — move the cursor one column left, stopping at column 0.  It does
// not erase: a shell that rubs a character out sends BS, a space and
// another BS.
pub fn grid_backspace(var g: Grid) -> Grid [io, ffi]
    if g.cursor_col > 0
        grid_cursor_set(var g, g.cursor_row, g.cursor_col - 1)
    else
        g

// Tab to the next 8-column stop, clipped to the right margin.
pub fn grid_tab(var g: Grid) -> Grid [io, ffi]
    let next = (g.cursor_col / 8 + 1) * 8
    let clipped = if next >= g.cols
        g.cols - 1
    else
        next
    grid_cursor_set(var g, g.cursor_row, clipped)

// CR — move the cursor to column 0 of the row it is on.  The row does
// not change; a newline is CR followed by LF.
pub fn grid_carriage_return(var g: Grid) -> Grid [io, ffi]
    grid_cursor_set(var g, g.cursor_row, 0)

// Line feed.  Moves the cursor down one row.  If already on the
// scroll-region bottom row, scrolls (within the region) and
// stays put.  Does NOT reset the column (matches xterm — CR has
// to follow if you want column 0).
pub fn grid_line_feed(var g: Grid) -> Grid [io, ffi]
    let bot = grid_region_bottom(g)
    if g.cursor_row >= bot
        var g2 = grid_scroll_up(g)
        grid_cursor_set(var g2, bot, g.cursor_col)
    else
        grid_cursor_set(var g, g.cursor_row + 1, g.cursor_col)

// ── Erase ──────────────────────────────────────────────────────

fn fill_row_range(var g: Grid, row: Int, c0: Int, c1: Int) [io, ffi]
    let bw0 = blank_word0()
    let bw1 = blank_word1()
    for c in c0..c1
        cells_blank(g.cells, grid_idx(g, row, c), bw0, bw1)

// EL — Erase in Line.  mode 0: cursor → end of line.
// mode 1: start of line → cursor (inclusive).  mode 2: whole line.
pub fn grid_erase_line(var g: Grid, mode: Int) -> Grid [io, ffi]
    if mode == 0
        fill_row_range(var g, g.cursor_row, g.cursor_col, g.cols)
    if mode == 1
        fill_row_range(var g, g.cursor_row, 0, g.cursor_col + 1)
    if mode == 2
        fill_row_range(var g, g.cursor_row, 0, g.cols)
    g

// ED — Erase in Display.  mode 0: cursor → end of display.
// mode 1: start → cursor.  mode 2: whole display.
pub fn grid_erase_display(var g: Grid, mode: Int) -> Grid [io, ffi]
    if mode == 0
        fill_row_range(var g, g.cursor_row, g.cursor_col, g.cols)
        for r in g.cursor_row + 1..g.rows
            fill_row_range(var g, r, 0, g.cols)
    if mode == 1
        for r in 0..g.cursor_row
            fill_row_range(var g, r, 0, g.cols)
        fill_row_range(var g, g.cursor_row, 0, g.cursor_col + 1)
    if mode == 2
        for r in 0..g.rows
            fill_row_range(var g, r, 0, g.cols)
    g

// ── Insert / Delete (line + char) ──────────────────────────────
//
// The ECMA-48 editing functions: CSI L / M / @ / P (IL / DL / ICH /
// DCH) and CSI S / T (SU / SD).  Full-screen apps use these for
// regional updates instead of repainting; a terminal that ignores
// them forces a full redraw at best and paints updates into the wrong
// rows at worst.  All operate within the active DECSTBM region.

// IL — insert n blank lines at cursor row, push existing rows
// down within region.  Cursor stays put (column unchanged).
// Rows below region_bottom are unaffected.
pub fn grid_insert_lines(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let bot = grid_region_bottom(g)
        let cur = g.cursor_row
        if cur > bot
            g
        else
            let k = if n > bot - cur + 1
                bot - cur + 1
            else
                n
            let bw0 = blank_word0()
            let bw1 = blank_word1()
            // Shift rows down: copy from (r-k) into r, working bottom-
            // up so we don't clobber sources.  Each cell is 2 i64s now.
            var r = bot
            while r >= cur + k
                var c = 0
                while c < g.cols
                    cells_copy(g.cells, grid_idx(g, r, c),
                      g.cells, grid_idx(g, r - k, c))
                    c = c + 1
                r = r - 1
            // Blank the inserted rows.
            var r2 = cur
            while r2 < cur + k
                var c2 = 0
                while c2 < g.cols
                    cells_blank(g.cells, grid_idx(g, r2, c2), bw0, bw1)
                    c2 = c2 + 1
                r2 = r2 + 1
            g

// DL — delete n lines at cursor row, pull rows up within region.
pub fn grid_delete_lines(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let bot = grid_region_bottom(g)
        let cur = g.cursor_row
        if cur > bot
            g
        else
            let k = if n > bot - cur + 1
                bot - cur + 1
            else
                n
            let bw0 = blank_word0()
            let bw1 = blank_word1()
            var r = cur
            while r + k <= bot
                var c = 0
                while c < g.cols
                    cells_copy(g.cells, grid_idx(g, r, c),
                      g.cells, grid_idx(g, r + k, c))
                    c = c + 1
                r = r + 1
            // Blank the now-empty bottom k rows of the region.
            var r2 = bot - k + 1
            while r2 <= bot
                var c2 = 0
                while c2 < g.cols
                    cells_blank(g.cells, grid_idx(g, r2, c2), bw0, bw1)
                    c2 = c2 + 1
                r2 = r2 + 1
            g

// ECH — erase n chars at cursor (write blanks).  Cursor stays.
// Critical for pane-aware redraws: lets apps clear specific
// cells without `\e[K` which would extend past the pane border.
pub fn grid_erase_chars(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let row = g.cursor_row
        let col = g.cursor_col
        let k = if n > g.cols - col
            g.cols - col
        else
            n
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        var c = col
        while c < col + k
            cells_blank(g.cells, grid_idx(g, row, c), bw0, bw1)
            c = c + 1
        g

// ICH — insert n blank chars at cursor, shift right within row.
// Cells past the right margin fall off.  Cursor unchanged.
pub fn grid_insert_chars(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let row = g.cursor_row
        let col = g.cursor_col
        let k = if n > g.cols - col
            g.cols - col
        else
            n
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        // Shift right: from rightmost back to col+k.
        var c = g.cols - 1
        while c >= col + k
            cells_copy(g.cells, grid_idx(g, row, c),
                  g.cells, grid_idx(g, row, c - k))
            c = c - 1
        var c2 = col
        while c2 < col + k
            cells_blank(g.cells, grid_idx(g, row, c2), bw0, bw1)
            c2 = c2 + 1
        g

// DCH — delete n chars at cursor, shift left within row.
pub fn grid_delete_chars(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let row = g.cursor_row
        let col = g.cursor_col
        let k = if n > g.cols - col
            g.cols - col
        else
            n
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        var c = col
        while c + k < g.cols
            cells_copy(g.cells, grid_idx(g, row, c),
                  g.cells, grid_idx(g, row, c + k))
            c = c + 1
        var c2 = g.cols - k
        while c2 < g.cols
            cells_blank(g.cells, grid_idx(g, row, c2), bw0, bw1)
            c2 = c2 + 1
        g

// SU — scroll up n lines within the active region.  Same as
// calling grid_scroll_up n times but cheaper for n>1.
fn grid_scroll_region_up(g: Grid, n: Int) -> Grid [io, ffi]
    var left = n
    var g_acc = g
    while left > 0
        g_acc = grid_scroll_up(g_acc)
        left = left - 1
    g_acc

// SD — scroll down n lines: insert n blank lines at region_top,
// rows below shift down within region.  Effectively IL at the
// top of the region.
fn grid_scroll_region_down(g: Grid, n: Int) -> Grid [io, ffi]
    if n < 1
        g
    else
        let top = grid_region_top(g)
        let bot = grid_region_bottom(g)
        let k = if n > bot - top + 1
            bot - top + 1
        else
            n
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        var r = bot
        while r >= top + k
            var c = 0
            while c < g.cols
                cells_copy(g.cells, grid_idx(g, r, c),
                    g.cells, grid_idx(g, r - k, c))
                c = c + 1
            r = r - 1
        var r2 = top
        while r2 < top + k
            var c2 = 0
            while c2 < g.cols
                cells_blank(g.cells, grid_idx(g, r2, c2), bw0, bw1)
                c2 = c2 + 1
            r2 = r2 + 1
        g

// ── Alt-screen + DECSC/DECRC ───────────────────────────────────
//
// Full-screen apps (vim, less, man, htop) expect an
// "alternate screen buffer" they can use without commingling
// with the user's prior scrollback.  Triggered by DEC private
// modes `\e[?1049h` (enter, save cursor first) and
// `\e[?1049l` (exit, restore cursor); older codes `?47h/l` and
// `?1047h/l` share the same buffer but with slightly different
// save semantics — we collapse all three onto the same "save +
// switch + clear on enter, restore + switch back on exit" path
// since the user-visible difference is negligible.
//
// Also implements DECSC (ESC 7) + DECRC (ESC 8) using the same
// save-slot layout — `\e[?1049h` is conceptually "DECSC + switch
// to alt + clear".  Parser dispatches DECSC/DECRC separately
// from alt-screen toggles, but both poke meta slots 3..7.

// Save current cursor + SGR state into meta slots 3..7.  No
// buffer toggle.
pub fn grid_decsc(g: Grid) -> Grid [io, ffi]
    array_i64_set_h(g.alt_meta, 3, g.cursor_row)
    array_i64_set_h(g.alt_meta, 4, g.cursor_col)
    array_i64_set_h(g.alt_meta, 5, g.fg)
    array_i64_set_h(g.alt_meta, 6, g.bg)
    array_i64_set_h(g.alt_meta, 7, g.attrs)
    g

// Restore cursor + SGR from meta slots 3..7.  No buffer toggle.
pub fn grid_decrc(var g: Grid) -> Grid [io, ffi]
    let r = array_i64_get_h(g.alt_meta, 3)
    let c = array_i64_get_h(g.alt_meta, 4)
    let fg = array_i64_get_h(g.alt_meta, 5)
    let bg = array_i64_get_h(g.alt_meta, 6)
    let attrs = array_i64_get_h(g.alt_meta, 7)
    g.cursor_row = clamp(r, 0, g.rows - 1)
    g.cursor_col = clamp(c, 0, g.cols - 1)
    g.fg = fg
    g.bg = bg
    g.attrs = attrs
    g

// Allocate the alt buffer lazily (first time we enter alt).
fn alloc_alt_buf(g: Grid) -> Int [io, ffi]
    // 2 i64s per cell.
    let n_cells = g.rows * g.cols
    let h = array_i64_alloc_h(n_cells * 2)
    let bw0 = blank_word0()
    let bw1 = blank_word1()
    var i = 0
    while i < n_cells
        array_i64_set_h(h, 2 * i, bw0)
        array_i64_set_h(h, 2 * i + 1, bw1)
        i = i + 1
    h

// Enter the alternate screen buffer.  Saves cursor + SGR,
// stashes the primary cells handle into meta[0], swaps `cells`
// to the alt buffer (lazy-allocate on first call), clears the
// alt buffer, and moves cursor to (0, 0) with SGR reset.
// Idempotent: re-entering when already in alt is a no-op clear.
pub fn grid_enter_alt_screen(var g: Grid) -> Grid [io, ffi]
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    if using_alt == 1
        // Already in alt — treat as a fresh enter: clear + reset
        // cursor.  (Some apps assume re-entry resets.)
        let n_cells = g.rows * g.cols
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        var i = 0
        while i < n_cells
            array_i64_set_h(g.cells, 2 * i, bw0)
            array_i64_set_h(g.cells, 2 * i + 1, bw1)
            i = i + 1
        g.cursor_row = 0
        g.cursor_col = 0
        g.fg = default_fg_rgb()
        g.bg = default_bg_rgb()
        g.attrs = 0
        g
    else
        // Save cursor + SGR for the eventual exit.
        array_i64_set_h(g.alt_meta, 3, g.cursor_row)
        array_i64_set_h(g.alt_meta, 4, g.cursor_col)
        array_i64_set_h(g.alt_meta, 5, g.fg)
        array_i64_set_h(g.alt_meta, 6, g.bg)
        array_i64_set_h(g.alt_meta, 7, g.attrs)
        // Lazy-allocate the alt buffer.
        let existing_alt = array_i64_get_h(g.alt_meta, 1)
        let alt_h = if existing_alt < 0
            let h = alloc_alt_buf(g)
            array_i64_set_h(g.alt_meta, 1, h)
            h
        else
            existing_alt
        // Stash primary so exit can swap back.
        array_i64_set_h(g.alt_meta, 0, g.cells)
        array_i64_set_h(g.alt_meta, 2, 1)
        // Reset scroll region to the full grid — xterm semantics
        // are "region is per-buffer", and the simplest faithful
        // approximation is "switch buffer = reset region".
        // Otherwise a region set in primary leaks into alt and
        // breaks nvim/vim/htop's first redraw.
        array_i64_set_h(g.alt_meta, 8, 0)
        array_i64_set_h(g.alt_meta, 9, g.rows - 1)
        // Clear the alt buffer (standard ?1049 behavior).
        let n_cells = g.rows * g.cols
        let bw0 = blank_word0()
        let bw1 = blank_word1()
        var i = 0
        while i < n_cells
            array_i64_set_h(alt_h, 2 * i, bw0)
            array_i64_set_h(alt_h, 2 * i + 1, bw1)
            i = i + 1
        g.cursor_row = 0
        g.cursor_col = 0
        g.fg = default_fg_rgb()
        g.bg = default_bg_rgb()
        g.attrs = 0
        g.cells = alt_h
        g

// Exit the alternate screen buffer.  Swaps `cells` back to the
// primary handle stashed in meta[0], restores saved cursor +
// SGR.  No-op if we're already in primary mode (defensive — the
// terminal may legitimately receive duplicate ?1049l).
pub fn grid_exit_alt_screen(var g: Grid) -> Grid [io, ffi]
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    if using_alt != 1
        g
    else
        let primary = array_i64_get_h(g.alt_meta, 0)
        if primary < 0
            g
        else
            let r = array_i64_get_h(g.alt_meta, 3)
            let c = array_i64_get_h(g.alt_meta, 4)
            let fg = array_i64_get_h(g.alt_meta, 5)
            let bg = array_i64_get_h(g.alt_meta, 6)
            let attrs = array_i64_get_h(g.alt_meta, 7)
            array_i64_set_h(g.alt_meta, 0, 0 - 1)
            array_i64_set_h(g.alt_meta, 2, 0)
            // Reset scroll region on the way back to primary too —
            // same per-buffer semantics as on enter.
            array_i64_set_h(g.alt_meta, 8, 0)
            array_i64_set_h(g.alt_meta, 9, g.rows - 1)
            g.cursor_row = clamp(r, 0, g.rows - 1)
            g.cursor_col = clamp(c, 0, g.cols - 1)
            g.fg = fg
            g.bg = bg
            g.attrs = attrs
            g.cells = primary
            g

// ── Resize ─────────────────────────────────────────────────────
//
// Window resize.  Allocate a fresh cells array sized
// for the new (rows, cols), copy as much of the old content as
// fits (top-left aligned), drop the old array.  Also resizes the
// alt buffer if it was lazily allocated.  Cursor clamped into
// the new bounds.  Scrollback ring keeps its existing rows (they
// may be wider than the new cols — those just get clipped at
// render time via `grid_view_get`'s bounds check).
//
// Returns a new Grid with the new dims + new cells handle.

fn alloc_blank_cells(rows: Int, cols: Int) -> Int [io, ffi]
    let n_cells = rows * cols
    let h = array_i64_alloc_h(n_cells * 2)
    let bw0 = blank_word0()
    let bw1 = blank_word1()
    var i = 0
    while i < n_cells
        array_i64_set_h(h, 2 * i, bw0)
        array_i64_set_h(h, 2 * i + 1, bw1)
        i = i + 1
    h

// Find a row's content length (highest non-blank column
// + 1; 0 for entirely-blank row).  Used by reflow_cells to know
// how many cells to copy from each old row.
fn row_content_len(cells: Int, cols: Int, row: Int) -> Int [io, ffi]
    let bw0 = blank_word0()
    var last = 0
    var c = cols - 1
    var done = false
    while not done and c >= 0
        let idx = (row * cols + c) * 2
        let w0 = array_i64_get_h(cells, idx)
        if w0 != bw0
            last = c + 1
            done = true
        else
            c = c - 1
    last

// Wrap-aware reflow.  Walks the old grid top→bottom in
// "logical lines" defined by old_wrap (consecutive wrapped rows
// form one logical line), and emits each line into the new
// grid at new_cols, re-wrapping where necessary.  Writes
// new_wrap as it goes so a subsequent resize sees the same
// soft-wrap structure.
//
// Caller's responsibility to:
//   - pre-blank new_cells (alloc_blank_cells does this)
//   - pre-zero new_wrap (caller's grid_new / re-alloc)
// Returns the final (new_r, new_c) packed as (new_r << 32) |
// (new_c & 0xffffffff) so the caller can land the cursor at
// the logical position the resize finishes on — without this
// the cursor floats to the top-left every reflow.
fn reflow_cells(old_cells: Int, old_cols: Int, old_rows: Int, old_wrap: Int, new_cells: Int,
                new_cols: Int, new_rows: Int, new_wrap: Int) -> Int [io, ffi]
    var new_r = 0
    var new_c = 0
    var old_r = 0
    while old_r < old_rows and new_r < new_rows
        let wrapped = array_i64_get_h(old_wrap, old_r)
        let content_len = if wrapped == 1
            old_cols
        else
            row_content_len(old_cells, old_cols, old_r)
        var i = 0
        while i < content_len and new_r < new_rows
            let s_idx = (old_r * old_cols + i) * 2
            let d_idx = (new_r * new_cols + new_c) * 2
            array_i64_set_h(new_cells, d_idx,
                      array_i64_get_h(old_cells, s_idx))
            array_i64_set_h(new_cells, d_idx + 1,
                      array_i64_get_h(old_cells, s_idx + 1))
            new_c = new_c + 1
            if new_c >= new_cols and (i + 1 < content_len or wrapped == 1)
                array_i64_set_h(new_wrap, new_r, 1)
                new_r = new_r + 1
                new_c = 0
            i = i + 1
        if wrapped == 0
            new_r = new_r + 1
            new_c = 0
        old_r = old_r + 1
    // Clamp the end-position to the buffer bounds before packing.
    let pr = if new_r >= new_rows
        new_rows - 1
    else
        new_r
    let pc = if new_c >= new_cols
        new_cols - 1
    else
        new_c
    int.shl(pr, 32) + (pc & 4294967295)

// Copy `old_cells` into `new_cells` cell-by-cell, top-left
// aligned, clipping at the smaller of (old_rows/cols,
// new_rows/cols).  2 i64s per cell.
fn copy_cells(old_cells: Int, old_cols: Int, new_cells: Int, new_cols: Int, copy_rows: Int,
              copy_cols: Int) [io, ffi]
    var r = 0
    while r < copy_rows
        var c = 0
        while c < copy_cols
            let s_idx = (r * old_cols + c) * 2
            let d_idx = (r * new_cols + c) * 2
            array_i64_set_h(new_cells, d_idx, array_i64_get_h(old_cells, s_idx))
            array_i64_set_h(new_cells, d_idx + 1, array_i64_get_h(old_cells, s_idx + 1))
            c = c + 1
        r = r + 1

// Build a new Grid at the new geometry and move the content across,
// rejoining soft-wrapped runs into logical lines and re-wrapping them at
// the new width — so a prompt that wrapped at 80 columns reads back
// unwrapped at 120.  The old Grid's buffers are released, and the
// returned Grid is the one to keep: the argument must not be used again.
pub fn grid_resize(g: Grid, new_rows: Int, new_cols: Int) -> Grid [io, ffi]
    if new_rows == g.rows and new_cols == g.cols
        g
    else
        // DECSTBM scroll-region resets to the full new grid on
        // resize.  Apps re-issue their region after SIGWINCH; until
        // they do, a region carried over from the old geometry names
        // rows that may no longer exist, and scrolling inside it
        // corrupts the rows outside.
        array_i64_set_h(g.alt_meta, 8, 0)
        array_i64_set_h(g.alt_meta, 9, new_rows - 1)
        let copy_r = if new_rows < g.rows
            new_rows
        else
            g.rows
        let copy_c = if new_cols < g.cols
            new_cols
        else
            g.cols
        // Snapshot the alt + primary-saved handles BEFORE we drop
        // g.cells.  In alt-screen mode (nvim / less / htop) g.cells
        // IS alt_meta[1] — dropping g.cells first would invalidate
        // alt_meta[1], and the later read+drop would touch freed
        // memory (use-after-free + double-free → wgpu crash on the
        // next pack_cells reading from the stale region).  Capture
        // here and treat each slot exactly once.
        let alt_old = array_i64_get_h(g.alt_meta, 1)
        let primary_saved = array_i64_get_h(g.alt_meta, 0)
        let using_alt = array_i64_get_h(g.alt_meta, 2)
        let active_is_alt = using_alt == 1 and alt_old == g.cells
        let active_is_primary = primary_saved == g.cells
        // Replace the active buffer.  Old cells handle gets freed;
        // alt_meta + scrollback handles outlive resize.
        let new_active = alloc_blank_cells(new_rows, new_cols)
        // Wrap-aware reflow for the PRIMARY buffer when
        // cols change.  Alt-screen apps (vim / htop / less) redraw
        // on SIGWINCH so their cell-aligned copy is fine; primary
        // shells need the soft-wrap rejoin or long prompts /
        // command output keep their old wrap point at the new
        // width.  Reflow returns the end position packed
        // (row << 32) | col so the cursor follows the content.
        let new_wrap = array_i64_alloc_h(new_rows)
        for wi in 0..new_rows
            array_i64_set_h(new_wrap, wi, 0)
        var reflow_cur_r = 0
        var reflow_cur_c = 0
        if active_is_alt or new_cols == g.cols
            copy_cells(g.cells, g.cols, new_active, new_cols, copy_r, copy_c)
        else
            let end_packed = reflow_cells(g.cells, g.cols, g.rows, g.wrap_flags,
                                     new_active, new_cols, new_rows, new_wrap)
            reflow_cur_r = int.shr_logical(end_packed, 32)
            reflow_cur_c = end_packed & 4294967295
        array_i64_drop_h(g.cells)
        if active_is_alt
            // The alt buffer was just freed via g.cells — reuse new_active
            // as both the new alt handle AND the new active cells.
            // Without this, the next read of alt_meta[1] returns the
            // stale handle.
            array_i64_set_h(g.alt_meta, 1, new_active)
        else if alt_old >= 0
            // Alt buffer exists but isn't active (we're in primary).  Resize
            // it independently so re-entering alt after the resize finds
            // its content at the new dims.
            let new_alt = alloc_blank_cells(new_rows, new_cols)
            copy_cells(alt_old, g.cols, new_alt, new_cols, copy_r, copy_c)
            array_i64_drop_h(alt_old)
            array_i64_set_h(g.alt_meta, 1, new_alt)
        // Same dance for the primary-saved slot (set only while in alt).
        if active_is_primary
            array_i64_set_h(g.alt_meta, 0, new_active)
        else if primary_saved >= 0
            let new_saved = alloc_blank_cells(new_rows, new_cols)
            copy_cells(primary_saved, g.cols, new_saved, new_cols, copy_r, copy_c)
            array_i64_drop_h(primary_saved)
            array_i64_set_h(g.alt_meta, 0, new_saved)
        // Cursor placement: if reflow ran (primary + cols changed),
        // land the cursor where the reflow ended so newly-typed input
        // continues at the right spot.  Otherwise clamp the old
        // position into the new bounds (current behavior).
        let used_reflow = not active_is_alt and new_cols != g.cols
        let new_cur_r = if used_reflow
            reflow_cur_r
        else if g.cursor_row < new_rows
            g.cursor_row
        else
            new_rows - 1
        let new_cur_c = if used_reflow
            reflow_cur_c
        else if g.cursor_col < new_cols
            g.cursor_col
        else
            new_cols - 1
        array_i64_drop_h(g.wrap_flags)
        Grid { rows: new_rows, cols: new_cols,
           cursor_row: new_cur_r, cursor_col: new_cur_c,
           fg: g.fg, bg: g.bg, attrs: g.attrs,
           cells: new_active, alt_meta: g.alt_meta,
           scrollback: g.scrollback, wrap_flags: new_wrap }

// ── Scrollback view ────────────────────────────────────────────
//
// Renderer reads cells via grid_view_get instead of grid_get so
// scroll-up shows historical content from the ring instead of
// the live grid.  At view_offset K (0 ≤ K ≤ count):
//   - visible row r where (count - K + r) < count → from
//     scrollback at logical index (count - K + r)
//   - else → from live grid at row (count - K + r) - count
// At K = 0 the formula collapses to the live grid (no scrollback
// touched).

// Word 0 of the cell at (row, col) as the VIEW shows it: history when
// the view is scrolled back over that row, live cells otherwise.  A
// renderer reads through this pair rather than `grid_get`, and then
// scrolling costs it nothing.
pub fn grid_view_get(g: Grid, row: Int, col: Int) -> Int [io, ffi]
    // Alt-screen content isn't pushed to scrollback, so showing
    // scrollback while in alt would commingle vim/less UI with
    // pre-vim shell output.  Bypass the offset when in alt mode.
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    if using_alt == 1
        grid_get(g, row, col)
    else
        let k = scrollback_view_offset(g.scrollback)
        let count = scrollback_count(g.scrollback)
        let virt = count - k + row
        if virt < 0
            blank_word0()
        else if virt < count
            scrollback_get_cell(g.scrollback, virt, col)
        else
            grid_get(g, virt - count, col)

// Word 1 (bg_rgb) of the view-aware cell read.
pub fn grid_view_get_w1(g: Grid, row: Int, col: Int) -> Int [io, ffi]
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    if using_alt == 1
        grid_get_w1(g, row, col)
    else
        let k = scrollback_view_offset(g.scrollback)
        let count = scrollback_count(g.scrollback)
        let virt = count - k + row
        if virt < 0
            blank_word1()
        else if virt < count
            scrollback_get_cell_w1(g.scrollback, virt, col)
        else
            grid_get_w1(g, virt - count, col)

// How far the view is scrolled back, in lines — 0 when it is live.
// Read it to decide whether to draw a scroll indicator.
pub fn grid_view_offset(g: Grid) -> Int [io, ffi]
    scrollback_view_offset(g.scrollback)

// Public query for the alt-screen flag, for consumers outside this
// module.  Returns 1 when the pane is in alt-screen mode (vim,
// less, htop with mouse mode), 0 otherwise.  Lets consumers
// decide whether to handle a mouse event themselves or let the
// app inside handle it.  Internal helpers already check the
// flag directly via `array_i64_get_h(g.alt_meta, 2)`; this is
// the same value exported.
pub fn grid_using_alt(g: Grid) -> Int [io, ffi]
    array_i64_get_h(g.alt_meta, 2)

// Adjust the scrollback view offset by `delta` lines (positive =
// scroll up into history, negative = scroll back down toward
// live).  Clamps to [0, scrollback_count].  No-op when in alt
// screen (alt-buffer content isn't pushed to scrollback, so
// scrolling there would jump to stale history).
pub fn grid_scroll_view(g: Grid, delta: Int) -> Grid [io, ffi]
    let using_alt = array_i64_get_h(g.alt_meta, 2)
    if using_alt == 1
        g
    else
        let current = scrollback_view_offset(g.scrollback)
        let count = scrollback_count(g.scrollback)
        let next = current + delta
        let clamped = if next < 0
            0
        else if next > count
            count
        else
            next
        scrollback_set_view_offset(g.scrollback, clamped)
        g

// Reset view to live grid.  Called from input-driven mutators
// (grid_put_char, grid_carriage_return, etc.) so any shell
// output snaps the view back to the bottom — matches xterm /
// gnome-terminal behavior.
pub fn grid_reset_view(g: Grid) -> Grid [io, ffi]
    scrollback_set_view_offset(g.scrollback, 0)
    g

// ── Rendering (debug / grid-trace) ─────────────────────────────

// Render the grid to a single string with rows separated by \n,
// using the cell glyphs only (no color escapes — this is the
// debug path).  Cursor position is marked with a leading "@ R,C"
// header so test harnesses can assert on it.
pub fn grid_to_string(g: Grid) -> Str [io, ffi]
    var out = "@ " + str.from_int(g.cursor_row) + "," + str.from_int(g.cursor_col) + "\n"
    for r in 0..g.rows
        for c in 0..g.cols
            // Go through grid_get rather than the raw array: a cell is TWO
            // i64 words and grid_idx is a cell index, so a raw read needs
            // the ×2 stride.  An unscaled read interleaves w0 and w1, and
            // cell_glyph of a bg word is 0 — a NUL that truncates the whole
            // trace at the first cell.  grid_get owns the stride and the
            // bounds clamp.
            let cell = grid_get(g, r, c)
            out = out + str.from_char(cell_glyph(cell))
        out = out + "\n"
    out
