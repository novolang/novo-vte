// novo-vte main — library package, no executable entry point.
//
// novomux and novoterm both depend on this package through
// `[dependencies] novo-vte = "^0.5.1"`.
// The cross-package module loader pulls in src/parser.nv +
// src/grid.nv as siblings; this main.nv stays a no-op stub because
// `novo pkg build` never builds a dependency's `main` — only the
// root package's `main` becomes an entry point.

fn main() [io]
    println("novo-vte: library package — depend on it with `novo pkg add novo-vte`")
